<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsProductTrainProject>true</IsProductTrainProject>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>
        <Copyright>Olivier MARTY 2025</Copyright>
        <Authors>Olivier MARTY</Authors>
        <Company>Olivier MARTY</Company>
        <PackageId>omy.Utils.Collections</PackageId>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <!-- Provisional version (see eng/product-train-manifest.json: versionPolicy=provisional and
             docs/releasing/VisualStudioExtension.md's provisional-version policy). Only contains
             SkipList; not yet mature enough to join the 2.0 product train. Bump this literal, and
             the manifest's provisionalVersion together, when publishing a new 0.0.x candidate; jump
             directly to the stable product-train version once this package is considered mature. -->
        <Version>0.0.1</Version>
        <Description>Skip list implementation providing fast search, insertion, and deletion for sorted data sets.</Description>
        <PackageTags>omy;utilities;collections;skiplist;data-structures</PackageTags>
        <RepositoryUrl>https://github.com/warny/All-purpose-Utilities</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/warny/All-purpose-Utilities</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <InternalsVisibleTo Include="UtilsTest.Unit" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    </ItemGroup>

</Project>
