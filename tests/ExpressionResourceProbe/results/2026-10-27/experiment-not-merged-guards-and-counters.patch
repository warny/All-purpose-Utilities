@@ -0,0 +1,17 @@
+using System.Runtime.CompilerServices;
+
+namespace Utils.Expressions;
+
+/// <summary>ETC R0 experiment only (never merged): optional stack guard enabled by ETC_GUARDS=1.</summary>
+internal static class EtcGuard
+{
+    /// <summary>Whether the guard is enabled for this process.</summary>
+    internal static readonly bool Enabled = System.Environment.GetEnvironmentVariable("ETC_GUARDS") == "1";
+
+    /// <summary>Calls EnsureSufficientExecutionStack when enabled.</summary>
+    [MethodImpl(MethodImplOptions.AggressiveInlining)]
+    internal static void Check()
+    {
+        if (Enabled) RuntimeHelpers.EnsureSufficientExecutionStack();
+    }
+}
diff --git a/Utils/Expressions/EtcVisitReport.cs b/Utils/Expressions/EtcVisitReport.cs
new file mode 100644
index 00000000..e221f343
--- /dev/null
+++ b/Utils/Expressions/EtcVisitReport.cs
@@ -0,0 +1,57 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Linq.Expressions;
+using System.Threading;
+
+namespace Utils.Expressions;
+
+/// <summary>ETC R0 experiment only (never merged): per outermost simplification visit histogram, written at process exit.</summary>
+internal static class EtcVisitReport
+{
+    [ThreadStatic] private static int _depth;
+    private static readonly object Gate = new();
+    private static readonly long[] Buckets = new long[12];
+    private static readonly List<(long Visits, string Text)> Top = [];
+    private static long _calls;
+    private static readonly string? Path = Environment.GetEnvironmentVariable("ETC_VISITS_REPORT");
+
+    static EtcVisitReport()
+    {
+        if (Path is not null) AppDomain.CurrentDomain.ProcessExit += (_, _) => Write();
+    }
+
+    internal static bool Enter() => Path is not null && _depth++ == 0;
+
+    internal static void Exit(bool outer, long before, Expression expression)
+    {
+        if (Path is null) return;
+        _depth--;
+        if (!outer) return;
+        long visits = ExpressionTransformer.EtcTransformCoreVisits - before;
+        int bucket = visits <= 0 ? 0 : Math.Min(Buckets.Length - 1, (int)Math.Floor(Math.Log10(visits)) + 1);
+        lock (Gate)
+        {
+            _calls++;
+            Buckets[bucket]++;
+            if (Top.Count < 15 || visits > Top[^1].Visits)
+            {
+                string text = expression.ToString();
+                Top.Add((visits, text.Length > 200 ? text[..200] : text));
+                Top.Sort((a, b) => b.Visits.CompareTo(a.Visits));
+                if (Top.Count > 15) Top.RemoveAt(Top.Count - 1);
+            }
+        }
+    }
+
+    private static void Write()
+    {
+        lock (Gate)
+        {
+            var lines = new List<string> { $"calls={_calls}" };
+            for (int i = 0; i < Buckets.Length; i++) lines.Add($"bucket visits<=1e{i}: {Buckets[i]}");
+            lines.AddRange(Top.Select(t => $"top {t.Visits}: {t.Text}"));
+            System.IO.File.AppendAllLines(Path!, lines);
+        }
+    }
+}
