<Project>
    <!--
        Keep every project in the solution on the same product version.
        Directory.Build.targets is evaluated after individual project files, so this
        value intentionally overrides legacy <Version> declarations still present in
        some .csproj files.
    -->
    <PropertyGroup>
        <Version>2.0.0-rc.1</Version>
        <PackageVersion>2.0.0-rc.1</PackageVersion>
    </PropertyGroup>
</Project>
