<?xml version="1.0" encoding="utf-8"?>
<PackageManifest
    Version="2.0.0"
    xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
    xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
	<Metadata>
		<!--
            Version policy (provisional pre-2.0 series): see docs/releasing/VisualStudioExtension.md.
            While the product train (Directory.Build.props: ProductTrainVersion) is a 2.0.0
            prerelease, this VSIX ships an independent 0.0.x provisional series (0.0.1, 0.0.2, ...).
            It will jump directly to 2.0.0 once the product train reaches that stable version, and
            from then on should track the product train version. This Version attribute is the single
            authoritative value for the VSIX version; docs/releasing/VisualStudioExtension.md only
            documents the policy, it does not derive or override this value.
            The Id below must remain stable across 0.0.x, 2.0.0, and all future versions so that
            Visual Studio treats successive publications as updates of the same extension.
        -->
		<Identity
            Id="Utils.Parser.VisualStudio.ef18346f-f79e-4e44-86f4-bf8094951570"
            Version="0.0.1"
            Language="en-US"
            Publisher="Olivier MARTY" />
        <DisplayName>Utils Parser for Visual Studio</DisplayName>
        <Description xml:space="preserve">Syntax highlighting for custom languages defined with .syntaxcolor descriptors, powered by Utils.Parser with isolated out-of-process extensions.</Description>
        <!--
            Schema order is strict (PackageManifestSchema.Metadata.xsd sequence): Description,
            MoreInfo, License, [GettingStartedGuide], [ReleaseNotes], Icon, [PreviewImage], Tags,
            [Preview], [Version]. Moving License/MoreInfo after Icon/Tags fails the build with a
            VSSDK1062 schema-validation error (confirmed empirically).
        -->
        <MoreInfo>https://github.com/warny/All-purpose-Utilities</MoreInfo>
        <License>LICENSE-apache-2.0.txt</License>
        <Icon>Resources\AllPurposeUtilities_logo.png</Icon>
        <Tags>syntax;syntax highlighting;colorization;parser;language;editor;utils</Tags>
    </Metadata>
    <Installation>
        <!--
            17.14: matches the minimum major.minor of the referenced Microsoft.VisualStudio.Extensibility
            package (17.14.2098). Per that SDK's own documentation, an unspecified
            ExtensionMetadata.InstallationTargetVersion defaults to the referenced library's own
            major.minor as the included minimum - this manifest-level bound mirrors that default rather
            than overriding it down to an earlier, unverified version. Visual Studio 2022 17.9 is the
            first version documented to load out-of-process VisualStudio.Extensibility extensions on
            .NET 8 at all, but that does not establish that this specific 17.14-era SDK build works on
            17.9-17.13; 17.14 is the honest, verifiable floor.
        -->
        <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
    </Installation>
    <Prerequisites>
        <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14,)" DisplayName="Visual Studio core editor" />
    </Prerequisites>
    <Assets>
        <Asset
            Type="Microsoft.VisualStudio.Extensibility"
            d:Source="Project"
            d:ProjectName="%CurrentProject%"
            Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    </Assets>
</PackageManifest>
