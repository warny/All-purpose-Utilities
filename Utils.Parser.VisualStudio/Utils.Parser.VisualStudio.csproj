<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591;VSEXTPREVIEW_TAGGERS</NoWarn>
        <CreateVsixContainer>true</CreateVsixContainer>
        <DeployExtension>false</DeployExtension>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.VisualStudio.Extensibility" Version="17.14.2098" />
        <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
        <PackageReference Include="Nerdbank.Streams" Version="2.13.31" />
        <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
        <!--
            REL-01: MessagePack is a transitive dependency (via StreamJsonRpc and
            Microsoft.ServiceHub.Framework, both pulled in by Microsoft.VisualStudio.Extensibility)
            that NuGet was otherwise free to resolve down to 2.5.192, which is vulnerable to
            CVE-2026-48515 (DoS via unvalidated multi-dimensional array lengths in the formatters).
            Pinned here, not centrally, since no other project in the solution references
            MessagePack. 2.5.302 is the latest 2.x patch (fixed in 2.5.301) - deliberately staying
            on the already-resolved 2.x line rather than jumping to the breaking MessagePack 3.x.
        -->
        <PackageReference Include="MessagePack" Version="2.5.302" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Utils.Reflection/Utils.Reflection.csproj" />
        <ProjectReference Include="../Utils.Parser/Utils.Parser.csproj" />
        <Compile Remove="SyntaxColorizationClassifier.cs" />
        <Compile Remove="SyntaxColorizationClassifierProvider.cs" />
        <Compile Remove="UtilsParserVisualStudioPackage.cs" />
        <Compile Remove="IsExternalInit.cs" />
        <Compile Remove="ISyntaxColorisation.cs" />
        <Compile Remove="VisualStudioClassificationNames.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="source.extension.vsixmanifest">
            <SubType>Designer</SubType>
        </None>
    </ItemGroup>

    <!--
        Build the plugin worker process and copy its output next to the extension DLL.
        The tagger looks for the worker at $(OutputPath)worker\Utils.Parser.VisualStudio.Worker.exe.
        Users drop ISyntaxColorisation DLLs in %LOCALAPPDATA%\Utils.Parser.VisualStudio\Plugins\
        to enable out-of-process plugin isolation.
    -->
    <PropertyGroup>
        <WorkerProjectPath>$(MSBuildThisFileDirectory)..\Utils.Parser.VisualStudio.Worker\Utils.Parser.VisualStudio.Worker.csproj</WorkerProjectPath>
        <WorkerOutputDir>$(MSBuildThisFileDirectory)..\Utils.Parser.VisualStudio.Worker\bin\$(Configuration)\net8.0\</WorkerOutputDir>
        <WorkerBuildTargets Condition="'$(Restore)' == 'false'">Build</WorkerBuildTargets>
        <WorkerBuildTargets Condition="'$(Restore)' != 'false'">Restore;Build</WorkerBuildTargets>
    </PropertyGroup>

    <Target Name="BuildPluginWorker" BeforeTargets="Build">
        <MSBuild Projects="$(WorkerProjectPath)" Properties="Configuration=$(Configuration)" Targets="$(WorkerBuildTargets)" />
    </Target>

    <Target Name="CopyPluginWorkerToOutput" AfterTargets="Build">
        <ItemGroup>
            <WorkerOutputFiles Include="$(WorkerOutputDir)**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(WorkerOutputFiles)" DestinationFolder="$(OutputPath)worker\%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="EnsureSourceVsixManifest" BeforeTargets="DetokenizeVsixManifestFile">
        <MakeDir Directories="$(IntermediateOutputPath)" />
        <Copy SourceFiles="source.extension.vsixmanifest" DestinationFiles="$(IntermediateOutputPath)extension.vsixmanifest" Condition="Exists('source.extension.vsixmanifest')" />
    </Target>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>UtilsTest.Unit</_Parameter1>
        </AssemblyAttribute>
        <!--
            Exception: UtilsTest.Functional requires access to PluginAssemblyVerifier and
            PluginWorkerProcess, which are internal security/containment components with no
            public API surface. Functional tests validate OS-level isolation behaviour that
            cannot be exercised through public interfaces alone.
        -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>UtilsTest.Functional</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    </ItemGroup>

</Project>
