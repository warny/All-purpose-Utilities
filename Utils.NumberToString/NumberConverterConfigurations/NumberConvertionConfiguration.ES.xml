<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
        <Language
                groupSize="3"
                separator=" "
                groupSeparator=""
                zero="cero"
                minus="menos *"
                decimalSeparator="coma"
                fractionSeparator="sobre"

                maxNumber="999999999999"
        >
                <Culture>ES</Culture>
		<Groups>
			<Group level="1">
				<Digit digit="0" string="" />
				<Digit digit="1" string="uno" />
				<Digit digit="2" string="dos" />
				<Digit digit="3" string="tres" />
				<Digit digit="4" string="cuatro" />
				<Digit digit="5" string="cinco" />
				<Digit digit="6" string="seis" />
				<Digit digit="7" string="siete" />
				<Digit digit="8" string="ocho" />
				<Digit digit="9" string="nueve" />
			</Group>
			<Group level="2">
				<Digit digit="0" string="" buildString="*" />
				<Digit digit="1" string="diez" buildString="dieci*" />
				<Digit digit="2" string="veinte" buildString="veinti*" />
				<Digit digit="3" string="treinta" buildString="treinta y *" />
				<Digit digit="4" string="cuarenta" buildString="cuarenta y *" />
				<Digit digit="5" string="cincuenta" buildString="cincuenta y *" />
				<Digit digit="6" string="sesenta" buildString="sesenta y *" />
				<Digit digit="7" string="setenta" buildString="setenta y *" />
				<Digit digit="8" string="ochenta" buildString="ochenta y *" />
				<Digit digit="9" string="noventa" buildString="noventa y *" />
			</Group>
			<Group level="3">
				<Digit digit="0" string="" buildString="*" />
				<Digit digit="1" string="cien" buildString="ciento *" />
				<Digit digit="2" string="doscientos" buildString="doscientos *" />
				<Digit digit="3" string="trescientos" buildString="trescientos *" />
				<Digit digit="4" string="cuatrocientos" buildString="cuatrocientos *" />
				<Digit digit="5" string="quinientos" buildString="quinientos *" />
				<Digit digit="6" string="seiscientos" buildString="seiscientos *" />
				<Digit digit="7" string="setecientos" buildString="setecientos *" />
				<Digit digit="8" string="ochocientos" buildString="ochocientos *" />
				<Digit digit="9" string="novecientos" buildString="novecientos *" />
			</Group>
		</Groups>
		<!-- NTS-30F: long scale, DPD "cardinales" (1 000 000 000 "mil millones"), "millardo" ("dos mil millones") and
		     "números" §3.3c ("13 000 millones"): the multiplier of millón is a complete cardinal of up to six digits, so
		     the scales are paired from the million (pairedScalesFrom 2) and 10^9 has no name of its own (mil millones,
		     dos mil quinientos millones, mil un millones). -->
		<NumberScale firstLetterUpperCase="false" pairedScalesFrom="2">
			<StaticNames>
				<Scale value="0" string="" />
				<Scale value="1" string="mil" />
				<Scale value="2" string="mill(ón|ones)" />
			</StaticNames>
			<Suffixes>
				<Suffix>(ón|ones)</Suffix>
			</Suffixes>
			<!-- NTS-30G: millón is a masculine noun (DLE "millón": m.; DPD "cardinales" §3, §6) and the hundreds agree
			     with the noun they quantify (DPD "cardinales" §3): the multiplier of millón/millones is masculine
			     whatever the caller's gender (quinientos millones, dos mil quinientos millones de personas), while
			     the lower groups keep agreeing with the counted noun (un millón doscientas mil personas). The forms
			     are the synthesized ones; only the forced gender is added, form (apocope) is left to the caller. -->
			<ScaleForm scale="2">
				<Forms>
					<Form key="singular" value="millón" forceVariants="gender=masculino" />
					<Form key="plural" value="millones" forceVariants="gender=masculino" />
				</Forms>
			</ScaleForm>
		</NumberScale>
		<Replacements>
			<!-- DPD "mil" §1: 1000 is "mil", not "un mil"; likewise "mil millones" (a paired multiplier of 1000
			     renders its own thousands through this rule). -->
			<Replacement oldValue="uno mil" newValue="mil" onScale="1" onValue="1" />
			<!-- NTS-27: DPD "cardinales" §4 and "uno" §2.2-2.3: uno and its compounds are apocopated before
			     mil and before the nouns millón/millones (veintiún mil, treinta y un mil, ciento un mil, un millón,
			     veintiún millones). Only the multiplier of a scale is affected, never a standalone cardinal.
			     The fused 21 comes first so that the generic "uno" ending does not leave "veintiun". NTS-30F: the
			     multiplier of millones is rendered as a whole cardinal, so these rules also give veintiún mil millones
			     (scale 1 inside the multiplier) and mil un millones, mil veintiún millones (scale 2). -->
			<Replacement oldValue="veintiuno mil" newValue="veintiún mil" scope="Anywhere" onScale="1" />
			<Replacement oldValue="uno mil" newValue="un mil" scope="EndsWith" onScale="1" />
			<Replacement oldValue="veintiuno millones" newValue="veintiún millones" scope="Anywhere" onScale="2" />
			<Replacement oldValue="uno millón" newValue="un millón" scope="EndsWith" onScale="2" />
			<Replacement oldValue="uno millones" newValue="un millones" scope="EndsWith" onScale="2" />
		</Replacements>
		<Exceptions>
			<Number value="11" string="once" />
			<Number value="12" string="doce" />
			<Number value="13" string="trece" />
			<Number value="14" string="catorce" />
			<Number value="15" string="quince" />
			<Number value="16" string="dieciséis" />
			<!-- NTS-08: RAE accentuation of the fused twenties (veintidós, veintitrés, veintiséis); the ordinal
			     word rules below are keyed on these accented cardinals. -->
			<Number value="22" string="veintidós" />
			<Number value="23" string="veintitrés" />
			<Number value="26" string="veintiséis" />
		</Exceptions>
		<Variants>
			<!--
			  In Spanish, only "uno" (1) and compound hundreds (-cientos) vary in
			  gender. The 21-29 compounds are fused words (veintiuno, veintidós…):
			  LastWord does not transform "uno" inside "veintiuno" because the
			  preceding character ('i') is neither a space nor a hyphen — handled
			  instead via a whole-word replacement below (item 41). 31-99 already
			  use a space-separated buildString ("treinta y *"), so LastWord works there.
			-->
			<Dimension name="gender" localName="género" values="masculino,femenino" />
			<!--
			  NTS-05: "form" models whether a numeral is standalone (an ordinary cardinal, e.g.
			  Convert(21)) or attributive (governing a noun, e.g. a time unit — "veintiún minutos").
			  Masculine attributive apocope ("uno"->"un", "veintiuno"->"veintiún", "treinta y
			  uno"->"treinta y un") applies only in the attributive context; standalone cardinals
			  are unaffected because "standalone" (declared first) is the default. Time units and
			  currency amounts (Currency below, NTS-30) force form=attributive; ordinary Convert(...) calls never do.
			-->
			<Dimension name="form" localName="forma" values="standalone,attributive" />

			<Variant type="gender" variant="femenino">
				<!-- Units: "uno" alone or at end of group (preceded by a space or hyphen) -->
				<Replacement oldValue="uno" newValue="una" scope="LastWord" />
				<!-- item 41: 21 is a fused word ("veintiuno") that LastWord cannot reach
				     (no space/hyphen before "uno"); handled with a whole-word replacement instead.
				     22-29 do not vary in gender ("uno" is the only variable unit). -->
				<Replacement oldValue="veintiuno" newValue="veintiuna" scope="Anywhere" />
				<!-- Hundreds: replaces the -cientos form with -cientas everywhere
				     (safe because these words do not appear in scale names) -->
				<Replacement oldValue="doscientos"    newValue="doscientas"    scope="Anywhere" />
				<Replacement oldValue="trescientos"   newValue="trescientas"   scope="Anywhere" />
				<Replacement oldValue="cuatrocientos" newValue="cuatrocientas" scope="Anywhere" />
				<Replacement oldValue="quinientos"    newValue="quinientas"    scope="Anywhere" />
				<Replacement oldValue="seiscientos"   newValue="seiscientas"   scope="Anywhere" />
				<Replacement oldValue="setecientos"   newValue="setecientas"   scope="Anywhere" />
				<Replacement oldValue="ochocientos"   newValue="ochocientas"   scope="Anywhere" />
				<Replacement oldValue="novecientos"   newValue="novecientas"   scope="Anywhere" />
			</Variant>

			<!-- NTS-05: masculine attributive apocope — only fires when BOTH gender=masculino
			     (the default) AND form=attributive are active, so it never affects the feminine
			     rule above (disjoint gender values) nor ordinary standalone cardinals. -->
			<Variant type="gender" variant="masculino">
				<Variant type="form" variant="attributive">
					<Replacement oldValue="uno" newValue="un" scope="LastWord" />
					<Replacement oldValue="veintiuno" newValue="veintiún" scope="Anywhere" />
				</Variant>
			</Variant>
		</Variants>
		<!--
		  Spanish ordinals are etymologically Latin-derived and unrelated in form to the cardinals.
		  Coverage:
		    - 1-12: OrdinalException (fully irregular).
		    - 13-19: word rule on the cardinal exception word.
		    - 20-90 (round): word rule on the round-ten word.
		    - 21-29: word rule on the fused cardinal form.
		    - Compound units (31-99, last word "uno"/"dos"…): word rule on the unit word.
		    - 100, 1000: word rule on the scale word.
		    - Other compounds (e.g. 31-99 non-round) fall back to the cardinal (no suffix).
		  Forms are listed in Dimension order: masculino, femenino.
		  The first form also serves as the default when no variant is specified.
		-->
		<!-- NTS-08: ordinal domain guard; values outside the validated domain fail closed (see SpanishOrdinalLanguageSpecifics). -->
		<LanguageSpecifics>SpanishOrdinalLanguageSpecifics</LanguageSpecifics>
		<!-- NTS-28: the suffix "o" (feminine "a", OrdinalVariants below) only forms the round thousands and
		     millions, whose scale noun is rewritten by an OrdinalStem (dosmil → dosmilésimo); every other
		     supported value is formed by an exception or a word rule. -->
		<Ordinals suffix="o">
			<!--
			  NTS-05 note: every entry below now carries an explicit top-level string=/to= value
			  (equal to the masculine/first-declared form the nested Variant already provides).
			  This is required because the "form" Dimension added above makes the ordinal
			  default-form resolver require exhaustive coverage of every declared Dimension for any
			  entry that relies on it (see NumberToStringConverter.Globalization.cs SelectDefaultForm);
			  since these gender-only Variant blocks intentionally say nothing about "form" (Spanish
			  ordinals have no attributive/standalone distinction), supplying the base form directly
			  sidesteps that resolver instead of nesting an unrelated "form" constraint into every
			  ordinal entry. Runtime gender dispatch (OrdinalVariants) is unaffected: it already
			  matched on gender alone via normal subset matching before this change.
			-->
			<!-- Irregulars 1-12 — forms: masculino, femenino -->
			<OrdinalException value="1"  string="primero">   <Variant type="gender" forms="primero,primera"     /></OrdinalException>
			<OrdinalException value="2"  string="segundo">   <Variant type="gender" forms="segundo,segunda"     /></OrdinalException>
			<OrdinalException value="3"  string="tercero">   <Variant type="gender" forms="tercero,tercera"     /></OrdinalException>
			<OrdinalException value="4"  string="cuarto">    <Variant type="gender" forms="cuarto,cuarta"       /></OrdinalException>
			<OrdinalException value="5"  string="quinto">    <Variant type="gender" forms="quinto,quinta"       /></OrdinalException>
			<OrdinalException value="6"  string="sexto">     <Variant type="gender" forms="sexto,sexta"         /></OrdinalException>
			<OrdinalException value="7"  string="séptimo">   <Variant type="gender" forms="séptimo,séptima"     /></OrdinalException>
			<OrdinalException value="8"  string="octavo">    <Variant type="gender" forms="octavo,octava"       /></OrdinalException>
			<OrdinalException value="9"  string="noveno">    <Variant type="gender" forms="noveno,novena"       /></OrdinalException>
			<OrdinalException value="10" string="décimo">    <Variant type="gender" forms="décimo,décima"       /></OrdinalException>
			<OrdinalException value="11" string="undécimo">  <Variant type="gender" forms="undécimo,undécima"   /></OrdinalException>
			<OrdinalException value="12" string="duodécimo"> <Variant type="gender" forms="duodécimo,duodécima" /></OrdinalException>
			<!-- Teens 13-19 (last word = cardinal exception word) -->
			<Ordinal from="trece"      to="decimotercero">   <Variant type="gender" forms="decimotercero,decimotercera"   /></Ordinal>
			<Ordinal from="catorce"    to="decimocuarto">    <Variant type="gender" forms="decimocuarto,decimocuarta"     /></Ordinal>
			<Ordinal from="quince"     to="decimoquinto">    <Variant type="gender" forms="decimoquinto,decimoquinta"     /></Ordinal>
			<Ordinal from="dieciséis"  to="decimosexto">     <Variant type="gender" forms="decimosexto,decimosexta"       /></Ordinal>
			<Ordinal from="diecisiete" to="decimoséptimo">   <Variant type="gender" forms="decimoséptimo,decimoséptima"   /></Ordinal>
			<Ordinal from="dieciocho"  to="decimoctavo">     <Variant type="gender" forms="decimoctavo,decimoctava"       /></Ordinal>
			<Ordinal from="diecinueve" to="decimonoveno">    <Variant type="gender" forms="decimonoveno,decimonovena"     /></Ordinal>
			<!-- Round tens 20-90 -->
			<Ordinal from="veinte"    to="vigésimo">      <Variant type="gender" forms="vigésimo,vigésima"          /></Ordinal>
			<Ordinal from="treinta"   to="trigésimo">     <Variant type="gender" forms="trigésimo,trigésima"         /></Ordinal>
			<Ordinal from="cuarenta"  to="cuadragésimo">  <Variant type="gender" forms="cuadragésimo,cuadragésima"   /></Ordinal>
			<Ordinal from="cincuenta" to="quincuagésimo"> <Variant type="gender" forms="quincuagésimo,quincuagésima" /></Ordinal>
			<Ordinal from="sesenta"   to="sexagésimo">    <Variant type="gender" forms="sexagésimo,sexagésima"       /></Ordinal>
			<Ordinal from="setenta"   to="septuagésimo">  <Variant type="gender" forms="septuagésimo,septuagésima"   /></Ordinal>
			<Ordinal from="ochenta"   to="octogésimo">    <Variant type="gender" forms="octogésimo,octogésima"       /></Ordinal>
			<Ordinal from="noventa"   to="nonagésimo">    <Variant type="gender" forms="nonagésimo,nonagésima"       /></Ordinal>
			<!-- Fused 21-29 (config produces "veintiuno", "veintidós"…). NTS-08, RAE DPD "ordinales": one word,
			     accent on the last component (vigesimoséptimo), vigesimoctavo preferred to vigesimooctavo, and only
			     the last component varies in gender (vigesimoprimera, vigesimotercera). -->
			<Ordinal from="veintiuno"    to="vigesimoprimero"> <Variant type="gender" forms="vigesimoprimero,vigesimoprimera" /></Ordinal>
			<!-- The feminine cardinal variant (veintiuno -> veintiuna) is applied before the ordinal word rules. -->
			<Ordinal from="veintiuna"    to="vigesimoprimero"> <Variant type="gender" forms="vigesimoprimero,vigesimoprimera" /></Ordinal>
			<!-- NTS-28: the attributive apocope (veintiún, form=attributive) is a cardinal form; its ordinal is the same. -->
			<Ordinal from="veintiún"     to="vigesimoprimero"> <Variant type="gender" forms="vigesimoprimero,vigesimoprimera" /></Ordinal>
			<Ordinal from="veintidós"    to="vigesimosegundo"> <Variant type="gender" forms="vigesimosegundo,vigesimosegunda" /></Ordinal>
			<Ordinal from="veintitrés"   to="vigesimotercero"> <Variant type="gender" forms="vigesimotercero,vigesimotercera" /></Ordinal>
			<Ordinal from="veinticuatro" to="vigesimocuarto">  <Variant type="gender" forms="vigesimocuarto,vigesimocuarta"   /></Ordinal>
			<Ordinal from="veinticinco"  to="vigesimoquinto">  <Variant type="gender" forms="vigesimoquinto,vigesimoquinta"   /></Ordinal>
			<Ordinal from="veintiséis"   to="vigesimosexto">   <Variant type="gender" forms="vigesimosexto,vigesimosexta"     /></Ordinal>
			<Ordinal from="veintisiete"  to="vigesimoséptimo"> <Variant type="gender" forms="vigesimoséptimo,vigesimoséptima" /></Ordinal>
			<Ordinal from="veintiocho"   to="vigesimoctavo">   <Variant type="gender" forms="vigesimoctavo,vigesimoctava"     /></Ordinal>
			<Ordinal from="veintinueve"  to="vigesimonoveno">  <Variant type="gender" forms="vigesimonoveno,vigesimonovena"   /></Ordinal>
			<!-- Compound last-word units (covers 31-99 when last word is separated by space in the config) -->
			<Ordinal from="uno"    to="primero">  <Variant type="gender" forms="primero,primera" /></Ordinal>
			<Ordinal from="dos"    to="segundo">  <Variant type="gender" forms="segundo,segunda" /></Ordinal>
			<Ordinal from="tres"   to="tercero">  <Variant type="gender" forms="tercero,tercera" /></Ordinal>
			<Ordinal from="cuatro" to="cuarto">   <Variant type="gender" forms="cuarto,cuarta"   /></Ordinal>
			<Ordinal from="cinco"  to="quinto">   <Variant type="gender" forms="quinto,quinta"   /></Ordinal>
			<Ordinal from="seis"   to="sexto">    <Variant type="gender" forms="sexto,sexta"     /></Ordinal>
			<Ordinal from="siete"  to="séptimo">  <Variant type="gender" forms="séptimo,séptima" /></Ordinal>
			<Ordinal from="ocho"   to="octavo">   <Variant type="gender" forms="octavo,octava"   /></Ordinal>
			<Ordinal from="nueve"  to="noveno">   <Variant type="gender" forms="noveno,novena"   /></Ordinal>
			<!-- Round scale words -->
			<Ordinal from="cien" to="centésimo"> <Variant type="gender" forms="centésimo,centésima" /></Ordinal>
			<Ordinal from="mil"  to="milésimo">  <Variant type="gender" forms="milésimo,milésima"   /></Ordinal>
			<!-- NTS-28, DPD "ordinales" §1, §2a: the round hundreds are simple ordinals; the feminine cardinal
			     (doscientas) is transformed before the word rules, hence both keys. -->
			<Ordinal from="doscientos"    to="ducentésimo">       <Variant type="gender" forms="ducentésimo,ducentésima" /></Ordinal>
			<Ordinal from="doscientas"    to="ducentésimo">       <Variant type="gender" forms="ducentésimo,ducentésima" /></Ordinal>
			<Ordinal from="trescientos"   to="tricentésimo">      <Variant type="gender" forms="tricentésimo,tricentésima" /></Ordinal>
			<Ordinal from="trescientas"   to="tricentésimo">      <Variant type="gender" forms="tricentésimo,tricentésima" /></Ordinal>
			<Ordinal from="cuatrocientos" to="cuadringentésimo">  <Variant type="gender" forms="cuadringentésimo,cuadringentésima" /></Ordinal>
			<Ordinal from="cuatrocientas" to="cuadringentésimo">  <Variant type="gender" forms="cuadringentésimo,cuadringentésima" /></Ordinal>
			<Ordinal from="quinientos"    to="quingentésimo">     <Variant type="gender" forms="quingentésimo,quingentésima" /></Ordinal>
			<Ordinal from="quinientas"    to="quingentésimo">     <Variant type="gender" forms="quingentésimo,quingentésima" /></Ordinal>
			<Ordinal from="seiscientos"   to="sexcentésimo">      <Variant type="gender" forms="sexcentésimo,sexcentésima" /></Ordinal>
			<Ordinal from="seiscientas"   to="sexcentésimo">      <Variant type="gender" forms="sexcentésimo,sexcentésima" /></Ordinal>
			<Ordinal from="setecientos"   to="septingentésimo">   <Variant type="gender" forms="septingentésimo,septingentésima" /></Ordinal>
			<Ordinal from="setecientas"   to="septingentésimo">   <Variant type="gender" forms="septingentésimo,septingentésima" /></Ordinal>
			<Ordinal from="ochocientos"   to="octingentésimo">    <Variant type="gender" forms="octingentésimo,octingentésima" /></Ordinal>
			<Ordinal from="ochocientas"   to="octingentésimo">    <Variant type="gender" forms="octingentésimo,octingentésima" /></Ordinal>
			<Ordinal from="novecientos"   to="noningentésimo">    <Variant type="gender" forms="noningentésimo,noningentésima" /></Ordinal>
			<Ordinal from="novecientas"   to="noningentésimo">    <Variant type="gender" forms="noningentésimo,noningentésima" /></Ordinal>
			<!-- NTS-28, DPD §2a: 1 000 000 is the simple ordinal millonésimo (the scale noun alone, OrdinalScale). -->
			<Ordinal from="millón" to="millonésimo"> <Variant type="gender" forms="millonésimo,millonésima" /></Ordinal>
			<!-- NTS-28, DPD §2d: the thousands and millions prefix the multiplying cardinal to the simple ordinal
			     (dosmilésimo, quinientosmilésimo, dosmillonésimo); OrdinalScale solders the multiplier to the
			     noun and the stems rewrite the noun before the suffix. -->
			<OrdinalScale scales="1..2" multiplierSeparator="" />
			<OrdinalStem from="mil" to="milésim" />
			<OrdinalStem from="millón" to="millonésim" />
			<!-- NTS-28, DPD §2b, §3: the complex ordinals juxtapose the simple ones from the highest order down,
			     in two words from the third decade (trigésimo primero, centésimo trigésimo cuarto, milésimo
			     ducentésimo cuadragésimo octavo, tresmilésimo tricentésimo cuadragésimo quinto); the tail is
			     itself composed recursively. A round value (tail 0) is formed directly. -->
			<OrdinalComposition for="31..99" divisor="10" separator=" " />
			<OrdinalComposition for="101..999" divisor="100" separator=" " />
			<OrdinalComposition for="1001..999999" divisor="1000" separator=" " />
			<!-- NTS-38, DPD §2d: from 10^9 the head is still a round value of millón, whose multiplier spans the pair
			     (pairedScalesFrom 2): 1 000 000 000 is mil × millón, milmillonésimo (DPD §2d, DLE milmillonésimo), and the
			     lower orders follow it (milmillonésimo primero). -->
			<OrdinalComposition for="1000001..999999999999" divisor="1000000" separator=" " />
			<OrdinalVariants>
				<Variant type="gender" variant="femenino" suffix="a" />
			</OrdinalVariants>
		</Ordinals>
		<!-- NTS-30: a currency amount is a numeral governing the currency noun, so it takes the attributive form: the
			 masculine apocope of DPD "uno" §2.2 (un euro, veintiún euros, treinta y un euros, ciento un euros) on the unit
			 and the subunit alike. The rule belongs to the numeral, not to a word: any caller-defined masculine currency
			 (peso, dólar) is apocopated, and a feminine one declared through CurrencyDefinition.UnitForcedVariants
			 (gender=femenino) reads una peseta, veintiuna pesetas.
			 NTS-51: millón and the higher scales are nouns (DPD "cardinales" §6): "cuando estos numerales se usan por sí
			 solos, la noción cuantificada se expresa en un complemento encabezado por la preposición de: un millón de
			 personas, dos billones de pesos; ahora bien, cuando van seguidos de otros cardinales formando parte de un
			 numeral complejo, el sustantivo que expresa la entidad cuantificada no va precedido de preposición: un millón
			 doscientas mil personas". So "de" follows a numeral ending on the noun of scale 2 (millón/millones; 10^9 is
			 "mil millones", the paired scale ending on it): un millón de euros, dos mil millones de euros, but un millón
			 doscientos mil euros, un millón un euros. Mil (scale 1) is a determiner, not a noun: mil euros.
			 NTS-52: declared as a NounConnector substitution (no default connector), identical output. -->
		<Currency forceVariants="form=attributive">
			<NounConnector default="">
				<Substitution terminalScales="2.." value="de" />
			</NounConnector>
		</Currency>
		<TimeUnits>
			<!-- NTS-05: "hora" is feminine; "minuto"/"segundo" are masculine (the language default,
			     so no gender= override needed). All three force form=attributive, which activates
			     the appropriate existing gender-specific Variant rule above — feminine "una"/
			     "veintiuna" for hora, masculine apocope "un"/"veintiún" for minuto/segundo — for
			     count==1 AND compound counts (21, 31, ...) alike. No count1form needed: the
			     generic mechanism already covers count==1 uniformly with compounds. -->
			<Unit name="hour"   singular="hora"    plural="horas"    forceVariants="gender=femenino,form=attributive" />
			<Unit name="minute" singular="minuto"  plural="minutos"  forceVariants="form=attributive" />
			<Unit name="second" singular="segundo" plural="segundos" forceVariants="form=attributive" />
		</TimeUnits>
		<!-- RAE, Diccionario panhispánico de dudas, "hora". Neutral 12-hour clock without day-part
			 wording: "y <n>" up to the half hour, "menos <n>" referring to the following hour after
			 it. The feminine article is singular for one (la una) and plural otherwise (las dos),
			 selected through displayHourRange; {hour} is forced to the feminine numeral. -->
		<ClockTime step="5" hourCycle="12">
			<Rule range="0" displayHourRange="1" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femenino" pattern="la {hour}" />
			<Rule range="0" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femenino" pattern="las {hour}" />
			<Rule range="5,10,20,25" displayHourRange="1" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femenino" amountReference="0" amountDirection="after" pattern="la {hour} y {amount}" />
			<Rule range="5,10,20,25" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femenino" amountReference="0" amountDirection="after" pattern="las {hour} y {amount}" />
			<Rule range="15" displayHourRange="1" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femenino" pattern="la {hour} y cuarto" />
			<Rule range="15" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femenino" pattern="las {hour} y cuarto" />
			<Rule range="30" displayHourRange="1" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femenino" pattern="la {hour} y media" />
			<Rule range="30" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femenino" pattern="las {hour} y media" />
			<Rule range="35,40,50,55" displayHourRange="1" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femenino" amountReference="60" amountDirection="before" pattern="la {hour} menos {amount}" />
			<Rule range="35,40,50,55" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femenino" amountReference="60" amountDirection="before" pattern="las {hour} menos {amount}" />
			<Rule range="45" displayHourRange="1" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femenino" pattern="la {hour} menos cuarto" />
			<Rule range="45" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femenino" pattern="las {hour} menos cuarto" />
		</ClockTime>
	</Language>
</Numbers>
