<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        baseOn="SCALE-SHORT-CYRILLIC"
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="нуль"
        minus="мінус *"
        decimalSeparator="кома"
        decimalDigitByDigitMaxDigits="0"
    >
        <!-- NTS-34: no automatic decimal reading (C: school readings: дев'ять цілих одна десята, declined fraction nouns; docs/NTS-34-decimal-reading-audit.md). LanguageDefault throws NotSupportedException for a decimal part; DecimalReadingMode.DigitByDigit, requested by the caller, is unchanged. -->
        <Culture>UK</Culture>
        <Culture>UK-UA</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="один" />
                <Digit digit="2" string="два" />
                <Digit digit="3" string="три" />
                <Digit digit="4" string="чотири" />
                <Digit digit="5" string="п'ять" />
                <Digit digit="6" string="шість" />
                <Digit digit="7" string="сім" />
                <Digit digit="8" string="вісім" />
                <Digit digit="9" string="дев'ять" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="десять" buildString="десять *" />
                <Digit digit="2" string="двадцять" buildString="двадцять *" />
                <Digit digit="3" string="тридцять" buildString="тридцять *" />
                <Digit digit="4" string="сорок" buildString="сорок *" />
                <Digit digit="5" string="п'ятдесят" buildString="п'ятдесят *" />
                <Digit digit="6" string="шістдесят" buildString="шістдесят *" />
                <Digit digit="7" string="сімдесят" buildString="сімдесят *" />
                <Digit digit="8" string="вісімдесят" buildString="вісімдесят *" />
                <Digit digit="9" string="дев'яносто" buildString="дев'яносто *" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="сто" buildString="сто *" />
                <Digit digit="2" string="двісті" buildString="двісті *" />
                <Digit digit="3" string="триста" buildString="триста *" />
                <Digit digit="4" string="чотириста" buildString="чотириста *" />
                <Digit digit="5" string="п'ятсот" buildString="п'ятсот *" />
                <Digit digit="6" string="шістсот" buildString="шістсот *" />
                <Digit digit="7" string="сімсот" buildString="сімсот *" />
                <Digit digit="8" string="вісімсот" buildString="вісімсот *" />
                <Digit digit="9" string="дев'ятсот" buildString="дев'ятсот *" />
            </Group>
        </Groups>
        <!-- Short scale with мільярд (NTS-25): мільйон 10^6 and мільярд 10^9 are static, then
             три+ль+йон(ів) = трильйон(ів) (10^12), квадрильйон(ів) (10^15), квінтильйон(ів)…
             startIndex=2 maps scale 4 (10^12) to Conway index 3.
             The four Conway tables are overridden in Ukrainian spelling: і after в, г, к, л, м, н
             and и after д, т, р, ц ("правило дев'ятки": вігінти, тригінта, квінгенти, центи);
             the geminate of кваттуор is simplified (кватуор); the void group is "ні".
             The engine uses the same junction between Conway groups and before the suffix, so
             n = 1000 is мі+ль+ні+ль+йон = мільнільйон (accepted limitation, NTS-25).
             Note: й (U+0439) starts suffix йон.
             NTS-30B: тисяча, мільйон and мільярд agree with their multiplier (ScaleForm below); NTS-30C:
             the generated names from трильйон up agree too, through GeneratedScaleForm (два трильйони),
             which replaces the former (ів) plural of the suffix. -->
        <NumberScale firstLetterUpperCase="false" voidGroup="ні" groupSeparator="ль" startIndex="2">
            <StaticNames>
                <Scale value="0" string="" />
                <Scale value="1" string="тисяча" />
                <Scale value="2" string="мільйон" />
                <Scale value="3" string="мільярд" />
            </StaticNames>
            <Suffixes>
                <Suffix>йон</Suffix>
            </Suffixes>
            <Scale0Prefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="мі" />
                <Digit digit="2" string="бі" />
                <Digit digit="3" string="три" />
                <Digit digit="4" string="квадри" />
                <Digit digit="5" string="квінти" />
                <Digit digit="6" string="сексти" />
                <Digit digit="7" string="септи" />
                <Digit digit="8" string="окти" />
                <Digit digit="9" string="нони" />
            </Scale0Prefixes>
            <UnitsPrefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="ун" />
                <Digit digit="2" string="дуо" />
                <Digit digit="3" string="тре(с)" />
                <Digit digit="4" string="кватуор" />
                <Digit digit="5" string="квінква" />
                <Digit digit="6" string="се(кс,с)" />
                <Digit digit="7" string="септе(мн)" />
                <Digit digit="8" string="окто" />
                <Digit digit="9" string="нове(мн)" />
            </UnitsPrefixes>
            <TensPrefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="(н)деци" />
                <Digit digit="2" string="(мс)вігінти" />
                <Digit digit="3" string="(нс)тригінт[а|-illi=>и]" />
                <Digit digit="4" string="(нс)квадрагінт[а|-illi=>и]" />
                <Digit digit="5" string="(нс)квінквагінт[а|-illi=>и]" />
                <Digit digit="6" string="(н)сексагінт[а|-illi=>и]" />
                <Digit digit="7" string="(н)септуагінт[а|-illi=>и]" />
                <Digit digit="8" string="(м,кс,с)октогінт[а|-illi=>и]" />
                <Digit digit="9" string="нонагінт[а|-illi=>и]" />
            </TensPrefixes>
            <HundredsPrefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="(н,кс,с)центи" />
                <Digit digit="2" string="(н)дуценти" />
                <Digit digit="3" string="(нс)треценти" />
                <Digit digit="4" string="(нс)квадрингенти" />
                <Digit digit="5" string="(нс)квінгенти" />
                <Digit digit="6" string="(н)сесценти" />
                <Digit digit="7" string="(н)септингенти" />
                <Digit digit="8" string="(м,кс,с)октингенти" />
                <Digit digit="9" string="нонгенти" />
            </HundredsPrefixes>
            <!-- NTS-30B: nominative singular after …1 (not …11), nominative plural after …2–4 (not …12–14),
                 genitive plural otherwise (Unicode CLDR plural rules, uk; Український правопис 2019 § 70.11:
                 тисяча, мільйон, мільярд decline as nouns; два/три/чотири govern the nominative plural,
                 п'ять and above the genitive plural: три тисячі, п'ятсот п'ятдесят вісім тисяч).
                 UkrainianPluralLexicalFormSelector returns the key, the words are here. -->
            <ScaleForm scale="1" formSelector="UkrainianPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="тисяча" />
                    <Form key="few" value="тисячі" />
                    <Form key="many" value="тисяч" />
                </Forms>
            </ScaleForm>
            <ScaleForm scale="2" formSelector="UkrainianPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="мільйон" />
                    <Form key="few" value="мільйони" />
                    <Form key="many" value="мільйонів" />
                </Forms>
            </ScaleForm>
            <ScaleForm scale="3" formSelector="UkrainianPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="мільярд" />
                    <Form key="few" value="мільярди" />
                    <Form key="many" value="мільярдів" />
                </Forms>
            </ScaleForm>
            <!-- NTS-30C: every generated scale (трильйон, квадрильйон, …) is a masculine noun of the
                 second declension declined like мільйон: трильйон, два трильйони, п'ять трильйонів
                 (Горох, "трильйон", словозміна; uk.wiktionary "трильйон": 5 трильйонів; Unicode CLDR
                 plural rules, uk). The forms are suffix fragments joined to the Conway prefix.
                 NTS-42 F: the case keys are read by UkrainianOrdinalLanguageSpecifics for the oblique cases of
                 fractions (одним трильйоном третіх). Paradigm of the second declension, hard group, as мільйон
                 (VESUM via Горох "трильйон", "квадрильйон", "квінтильйон": -а, -ові/-у, -ом, -і/-ові/-у; pl. -и,
                 -ів, -ам, -ами, -ах; ПНТУ 2015: трильйон, квадрильйон "відмінюються як іменники"); the first VESUM
                 form of each cell, as the plugin keeps for мільйон (мільйонові, мільйоні). -->
            <GeneratedScaleForm suffix="0" formSelector="UkrainianPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="йон" />
                    <Form key="few" value="йони" />
                    <Form key="many" value="йонів" />
                    <Form key="singular.nominative" value="йон" />
                    <Form key="singular.genitive" value="йона" />
                    <Form key="singular.dative" value="йонові" />
                    <Form key="singular.accusative" value="йон" />
                    <Form key="singular.locative" value="йоні" />
                    <Form key="singular.instrumental" value="йоном" />
                    <Form key="plural.nominative" value="йони" />
                    <Form key="plural.genitive" value="йонів" />
                    <Form key="plural.dative" value="йонам" />
                    <Form key="plural.accusative" value="йони" />
                    <Form key="plural.locative" value="йонах" />
                    <Form key="plural.instrumental" value="йонами" />
                </Forms>
            </GeneratedScaleForm>
        </NumberScale>
        <Replacements>
            <!-- Drop "один" before "тисяча": 1000 = "тисяча" not "один тисяча" -->
            <Replacement oldValue="один тисяча" newValue="тисяча" onScale="1" onValue="1" />
            <!-- NTS-30B: тисяча is feminine, so its multiplier ends in the feminine одна / дві
                 (двадцять одна тисяча, дві тисячі); мільйон and мільярд are masculine (два мільйони). -->
            <Replacement oldValue="один тисяча" newValue="одна тисяча" scope="EndsWith" onScale="1" />
            <Replacement oldValue="два тисячі" newValue="дві тисячі" scope="EndsWith" onScale="1" />
        </Replacements>
        <Exceptions>
            <Number value="11" string="одинадцять" />
            <Number value="12" string="дванадцять" />
            <Number value="13" string="тринадцять" />
            <Number value="14" string="чотирнадцять" />
            <Number value="15" string="п'ятнадцять" />
            <Number value="16" string="шістнадцять" />
            <Number value="17" string="сімнадцять" />
            <Number value="18" string="вісімнадцять" />
            <Number value="19" string="дев'ятнадцять" />
        </Exceptions>
        <!-- Gender and case. Cardinals are declined for gender in the nominative only; the case
             dimension applies to ordinals (UkrainianOrdinalLanguageSpecifics). -->
        <Variants>
            <Dimension name="gender" localName="рід" values="чоловічий,жіночий,середній" />
            <Dimension name="case" localName="відмінок" values="називний,родовий,давальний,знахідний,орудний,місцевий" />
            <Variant type="gender" variant="жіночий">
                <Replacement oldValue="один" newValue="одна" scope="LastWord" />
                <Replacement oldValue="два" newValue="дві" scope="LastWord" />
            </Variant>
            <Variant type="gender" variant="середній">
                <Replacement oldValue="один" newValue="одне" scope="LastWord" />
            </Variant>
        </Variants>
        <!-- NTS-30H: fractions are read by the language specifics (IFractionLanguageSpecifics), as Український правопис 2019
             §107.1 writes them: одна третя, дві третіх, три четвертих, дев'ять десятих (feminine numerator, ordinal
             denominator in the feminine singular after one, in the genitive plural otherwise; NTS-39: singular after a
             compound ending in одна, тридцять одна сота; NTS-40: every case, двом третім, трьома п'ятими). The former connector reading
             "один на тисяча" is gone; values outside the sourced domain fail closed. -->
        <LanguageSpecifics>UkrainianOrdinalLanguageSpecifics</LanguageSpecifics>
        <!-- Quarter-hour 12-hour clock without day-part wording. "година" is feminine: the hour is
             a feminine ordinal whose case follows the construction (перша; чверть по + locative;
             пів на + accusative; чверть до + genitive of the following hour). -->
        <ClockTime step="15" hourCycle="12">
            <Rule range="0" hourOffset="0" hourForm="ordinal" hourForceVariants="gender=жіночий,case=називний" pattern="{hour}" />
            <Rule range="15" hourOffset="0" hourForm="ordinal" hourForceVariants="gender=жіночий,case=місцевий" pattern="чверть по {hour}" />
            <Rule range="30" hourOffset="1" hourForm="ordinal" hourForceVariants="gender=жіночий,case=знахідний" pattern="пів на {hour}" />
            <Rule range="45" hourOffset="1" hourForm="ordinal" hourForceVariants="gender=жіночий,case=родовий" pattern="чверть до {hour}" />
        </ClockTime>
    </Language>
</Numbers>
