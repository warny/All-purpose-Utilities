<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="אפס"
        minus="מינוס *"
        decimalSeparator="נקודה"
        fractionSeparator="על"
        maxNumber="999999"
    >
        <Culture>HE</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="אחד" />
                <Digit digit="2" string="שתיים" />
                <Digit digit="3" string="שלוש" />
                <Digit digit="4" string="ארבע" />
                <Digit digit="5" string="חמש" />
                <Digit digit="6" string="שש" />
                <Digit digit="7" string="שבע" />
                <Digit digit="8" string="שמונה" />
                <Digit digit="9" string="תשע" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="עשר" buildString="עשר *" />
                <Digit digit="2" string="עשרים" buildString="עשרים ו*" />
                <Digit digit="3" string="שלושים" buildString="שלושים ו*" />
                <Digit digit="4" string="ארבעים" buildString="ארבעים ו*" />
                <Digit digit="5" string="חמישים" buildString="חמישים ו*" />
                <Digit digit="6" string="שישים" buildString="שישים ו*" />
                <Digit digit="7" string="שבעים" buildString="שבעים ו*" />
                <Digit digit="8" string="שמונים" buildString="שמונים ו*" />
                <Digit digit="9" string="תשעים" buildString="תשעים ו*" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="מאה" buildString="מאה ו*" />
                <Digit digit="2" string="מאתיים" buildString="מאתיים ו*" />
                <Digit digit="3" string="שלוש מאות" buildString="שלוש מאות ו*" />
                <Digit digit="4" string="ארבע מאות" buildString="ארבע מאות ו*" />
                <Digit digit="5" string="חמש מאות" buildString="חמש מאות ו*" />
                <Digit digit="6" string="שש מאות" buildString="שש מאות ו*" />
                <Digit digit="7" string="שבע מאות" buildString="שבע מאות ו*" />
                <Digit digit="8" string="שמונה מאות" buildString="שמונה מאות ו*" />
                <Digit digit="9" string="תשע מאות" buildString="תשע מאות ו*" />
            </Group>
        </Groups>
        <NumberScale firstLetterUpperCase="false">
            <StaticNames>
                <Scale value="0" string="" />
                <Scale value="1" string="אלף" />
            </StaticNames>
            <Suffixes>
                <Suffix>מיליון</Suffix>
            </Suffixes>
        </NumberScale>
        <!-- 11-19 in the counting (feminine) form; the zachar variant agrees them. -->
        <Exceptions>
            <Number value="11" string="אחת עשרה" />
            <Number value="12" string="שתים עשרה" />
            <Number value="13" string="שלוש עשרה" />
            <Number value="14" string="ארבע עשרה" />
            <Number value="15" string="חמש עשרה" />
            <Number value="16" string="שש עשרה" />
            <Number value="17" string="שבע עשרה" />
            <Number value="18" string="שמונה עשרה" />
            <Number value="19" string="תשע עשרה" />
        </Exceptions>
        <!-- "ו" joins only the last element: the hundreds add it before their remainder, so it is
             removed again when tens precede a final unit ("מאה עשרים ואחד").

             Thousands (NTS-11; CLDR RBNF he, ulpan.net, Academy of the Hebrew Language). The
             thousands group (onScale="1") gets its lexical forms: אלף, אלפיים, the construct
             forms שלושת … עשרת אלפים, and from eleven thousand the masculine multiplier agreeing
             with the masculine noun אלף (אחד עשר אלף, עשרים ושניים אלף). These rules run on the
             group text before any gender variant, which only reaches the final lower group.
             The final pass then puts "ו" after the thousands and removes it again when the lower
             group starts with hundreds followed by a remainder, or with tens followed by a unit,
             so that "ו" precedes the last element only ("אלף ומאה", "אלף מאה ואחד"). A round ten
             or hundred after thousands keeps its "ו" (Academy rule; m-math.co.il "אלפיים ושמונה
             מאות"), deliberately diverging from CLDR, which writes "אלף מאה". -->
        <Replacements>
            <Replacement oldValue="אחד אלף" newValue="אלף" onScale="1" />
            <Replacement oldValue="שתיים אלף" newValue="אלפיים" onScale="1" />
            <Replacement oldValue="שלוש אלף" newValue="שלושת אלפים" onScale="1" />
            <Replacement oldValue="ארבע אלף" newValue="ארבעת אלפים" onScale="1" />
            <Replacement oldValue="חמש אלף" newValue="חמשת אלפים" onScale="1" />
            <Replacement oldValue="שש אלף" newValue="ששת אלפים" onScale="1" />
            <Replacement oldValue="שבע אלף" newValue="שבעת אלפים" onScale="1" />
            <Replacement oldValue="שמונה אלף" newValue="שמונת אלפים" onScale="1" />
            <Replacement oldValue="תשע אלף" newValue="תשעת אלפים" onScale="1" />
            <Replacement oldValue="עשר אלף" newValue="עשרת אלפים" onScale="1" />
            <Replacement oldValue="אחת עשרה אלף" newValue="אחד עשר אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="שתים עשרה אלף" newValue="שנים עשר אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="שלוש עשרה אלף" newValue="שלושה עשר אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="ארבע עשרה אלף" newValue="ארבעה עשר אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="חמש עשרה אלף" newValue="חמישה עשר אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="שש עשרה אלף" newValue="שישה עשר אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="שבע עשרה אלף" newValue="שבעה עשר אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="שמונה עשרה אלף" newValue="שמונה עשר אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="תשע עשרה אלף" newValue="תשעה עשר אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="ושתיים אלף" newValue="ושניים אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="ושלוש אלף" newValue="ושלושה אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="וארבע אלף" newValue="וארבעה אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="וחמש אלף" newValue="וחמישה אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="ושש אלף" newValue="ושישה אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="ושבע אלף" newValue="ושבעה אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="ותשע אלף" newValue="ותשעה אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="ועשר אלף" newValue="ועשרה אלף" scope="EndsWith" onScale="1" />
            <Replacement oldValue="אלף " newValue="אלף ו" scope="Anywhere" />
            <Replacement oldValue="אלפיים " newValue="אלפיים ו" scope="Anywhere" />
            <Replacement oldValue="אלפים " newValue="אלפים ו" scope="Anywhere" />
            <Replacement oldValue="ומאה " newValue="מאה " scope="Anywhere" />
            <Replacement oldValue="ומאתיים " newValue="מאתיים " scope="Anywhere" />
            <Replacement oldValue="ושלוש מאות " newValue="שלוש מאות " scope="Anywhere" />
            <Replacement oldValue="וארבע מאות " newValue="ארבע מאות " scope="Anywhere" />
            <Replacement oldValue="וחמש מאות " newValue="חמש מאות " scope="Anywhere" />
            <Replacement oldValue="ושש מאות " newValue="שש מאות " scope="Anywhere" />
            <Replacement oldValue="ושבע מאות " newValue="שבע מאות " scope="Anywhere" />
            <Replacement oldValue="ושמונה מאות " newValue="שמונה מאות " scope="Anywhere" />
            <Replacement oldValue="ותשע מאות " newValue="תשע מאות " scope="Anywhere" />
            <Replacement oldValue="ועשרים ו" newValue="עשרים ו" scope="Anywhere" />
            <Replacement oldValue="ושלושים ו" newValue="שלושים ו" scope="Anywhere" />
            <Replacement oldValue="וארבעים ו" newValue="ארבעים ו" scope="Anywhere" />
            <Replacement oldValue="וחמישים ו" newValue="חמישים ו" scope="Anywhere" />
            <Replacement oldValue="ושישים ו" newValue="שישים ו" scope="Anywhere" />
            <Replacement oldValue="ושבעים ו" newValue="שבעים ו" scope="Anywhere" />
            <Replacement oldValue="ושמונים ו" newValue="שמונים ו" scope="Anywhere" />
            <Replacement oldValue="ותשעים ו" newValue="תשעים ו" scope="Anywhere" />
        </Replacements>
        <!--
          Hebrew ordinals exist only for 1-10; higher ordinals are expressed
          as cardinals in practice. The default (zachar / standalone) forms are
          masculine; the nekeva variant provides feminine forms.
        -->
        <!--
          Ordinals 1-10 — forms listed in Dimension order: standalone, zachar, nekeva.
          standalone and zachar share the same forms (both use the masculine ordinal);
          nekeva carries the feminine form. The first entry also serves as the default
          when ConvertOrdinal is called without an explicit gender variant.
        -->
        <Ordinals>
            <OrdinalException value="1">  <Variant type="gender" forms="ראשון,ראשון,ראשונה"   /></OrdinalException>
            <OrdinalException value="2">  <Variant type="gender" forms="שני,שני,שנייה"         /></OrdinalException>
            <OrdinalException value="3">  <Variant type="gender" forms="שלישי,שלישי,שלישית"   /></OrdinalException>
            <OrdinalException value="4">  <Variant type="gender" forms="רביעי,רביעי,רביעית"   /></OrdinalException>
            <OrdinalException value="5">  <Variant type="gender" forms="חמישי,חמישי,חמישית"   /></OrdinalException>
            <OrdinalException value="6">  <Variant type="gender" forms="שישי,שישי,שישית"       /></OrdinalException>
            <OrdinalException value="7">  <Variant type="gender" forms="שביעי,שביעי,שביעית"   /></OrdinalException>
            <OrdinalException value="8">  <Variant type="gender" forms="שמיני,שמיני,שמינית"   /></OrdinalException>
            <OrdinalException value="9">  <Variant type="gender" forms="תשיעי,תשיעי,תשיעית"   /></OrdinalException>
            <OrdinalException value="10"> <Variant type="gender" forms="עשירי,עשירי,עשירית"   /></OrdinalException>
            <!-- Above ten the ordinal is the agreeing cardinal (intentional, see the NTS-08 record).
                 Without a gender it is masculine like 1-10: 11-19 are exceptions and the standalone
                 (counting) final unit of 21-99 is made masculine. -->
            <OrdinalException value="11"> <Variant type="gender" forms="אחד עשר,אחד עשר,אחת עשרה" /></OrdinalException>
            <OrdinalException value="12"> <Variant type="gender" forms="שנים עשר,שנים עשר,שתים עשרה" /></OrdinalException>
            <OrdinalException value="13"> <Variant type="gender" forms="שלושה עשר,שלושה עשר,שלוש עשרה" /></OrdinalException>
            <OrdinalException value="14"> <Variant type="gender" forms="ארבעה עשר,ארבעה עשר,ארבע עשרה" /></OrdinalException>
            <OrdinalException value="15"> <Variant type="gender" forms="חמישה עשר,חמישה עשר,חמש עשרה" /></OrdinalException>
            <OrdinalException value="16"> <Variant type="gender" forms="שישה עשר,שישה עשר,שש עשרה" /></OrdinalException>
            <OrdinalException value="17"> <Variant type="gender" forms="שבעה עשר,שבעה עשר,שבע עשרה" /></OrdinalException>
            <OrdinalException value="18"> <Variant type="gender" forms="שמונה עשר,שמונה עשר,שמונה עשרה" /></OrdinalException>
            <OrdinalException value="19"> <Variant type="gender" forms="תשעה עשר,תשעה עשר,תשע עשרה" /></OrdinalException>
            <OrdinalVariants>
                <Variant type="gender" variant="standalone">
                    <Ordinal from="ושתיים" to="ושניים" />
                    <Ordinal from="ושלוש" to="ושלושה" />
                    <Ordinal from="וארבע" to="וארבעה" />
                    <Ordinal from="וחמש" to="וחמישה" />
                    <Ordinal from="ושש" to="ושישה" />
                    <Ordinal from="ושבע" to="ושבעה" />
                    <Ordinal from="ותשע" to="ותשעה" />
                    <!-- Masculine final ten after "ו" ("מאה ועשרה", "אלף ועשרה"), like 3-9 above. -->
                    <Ordinal from="ועשר" to="ועשרה" />
                </Variant>
            </OrdinalVariants>
        </Ordinals>
        <Variants>
            <!--
              In Hebrew, digits 3-10 exhibit a "gender paradox":
              the grammatically feminine form (-ה) is used with masculine nouns
              (zachar), and the form without ה is used with feminine nouns (nekeva).

              The "standalone" mode (default) reproduces the current configuration
              behaviour: forms 3-9 are compatible with feminine nouns and abstract
              counting, but 1 is in its masculine form (אחד).

              ZACHAR (masculine nouns): 2→שניים, 3-9 add ה (except 8, invariable),
                10→עשרה. Hundreds (שלוש מאות etc.) remain unchanged because מאות
                is feminine: the unit form is already correct there.
              NEKEVA (feminine nouns): only 1 changes (אחד→אחת); forms 2-10
                are already correct for feminine nouns in the configuration.

              Limitation: the multiplier before אלף (thousands) is not converted
              because "אלף" is the last word, not the unit.
            -->
            <Dimension name="gender" localName="מגדר" values="standalone,zachar,nekeva" />

            <!-- ── Zachar (masculine nouns) ──────────────────────────────── -->
            <Variant type="gender" variant="zachar">
                <!-- Units (LastWord: does not affect the interior of compound hundreds) -->
                <Replacement oldValue="שתיים" newValue="שניים"  scope="LastWord" />
                <Replacement oldValue="שלוש"  newValue="שלושה" scope="LastWord" />
                <Replacement oldValue="ארבע"  newValue="ארבעה" scope="LastWord" />
                <Replacement oldValue="חמש"   newValue="חמישה" scope="LastWord" />
                <Replacement oldValue="שש"    newValue="שישה"  scope="LastWord" />
                <Replacement oldValue="שבע"   newValue="שבעה"  scope="LastWord" />
                <Replacement oldValue="תשע"   newValue="תשעה"  scope="LastWord" />
                <!-- standalone 10 -->
                <Replacement oldValue="עשר"   newValue="עשרה"  scope="LastWord" />
                <!-- Final unit after "ו", then the 11-19 forms (after the single-word rules, so the
                     final "עשר" of the masculine teens is not lengthened again). -->
                <Replacement oldValue="ושתיים" newValue="ושניים" scope="LastWord" />
                <Replacement oldValue="ושלוש" newValue="ושלושה" scope="LastWord" />
                <Replacement oldValue="וארבע" newValue="וארבעה" scope="LastWord" />
                <Replacement oldValue="וחמש" newValue="וחמישה" scope="LastWord" />
                <Replacement oldValue="ושש" newValue="ושישה" scope="LastWord" />
                <Replacement oldValue="ושבע" newValue="ושבעה" scope="LastWord" />
                <Replacement oldValue="ותשע" newValue="ותשעה" scope="LastWord" />
                <Replacement oldValue="ועשר" newValue="ועשרה" scope="LastWord" />
                <Replacement oldValue="אחת עשרה" newValue="אחד עשר" scope="EndsWith" />
                <Replacement oldValue="שתים עשרה" newValue="שנים עשר" scope="EndsWith" />
                <Replacement oldValue="שלוש עשרה" newValue="שלושה עשר" scope="EndsWith" />
                <Replacement oldValue="ארבע עשרה" newValue="ארבעה עשר" scope="EndsWith" />
                <Replacement oldValue="חמש עשרה" newValue="חמישה עשר" scope="EndsWith" />
                <Replacement oldValue="שש עשרה" newValue="שישה עשר" scope="EndsWith" />
                <Replacement oldValue="שבע עשרה" newValue="שבעה עשר" scope="EndsWith" />
                <Replacement oldValue="שמונה עשרה" newValue="שמונה עשר" scope="EndsWith" />
                <Replacement oldValue="תשע עשרה" newValue="תשעה עשר" scope="EndsWith" />
            </Variant>

            <!-- ── Nekeva (feminine nouns) ───────────────────────────────── -->
            <Variant type="gender" variant="nekeva">
                <!-- Only 1 changes; forms 2-9 are already correct for feminine nouns -->
                <Replacement oldValue="אחד" newValue="אחת" scope="LastWord" />
                <Replacement oldValue="ואחד" newValue="ואחת" scope="LastWord" />
            </Variant>
        </Variants>
        <!-- "שעה" is feminine: the feminine cardinal is forced on {hour}. Quarter-hour 12-hour clock
             without day-part wording: "ורבע", "וחצי", "רבע ל" + the following hour. -->
        <ClockTime step="15" hourCycle="12">
            <Rule range="0" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=nekeva" pattern="{hour}" />
            <Rule range="15" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=nekeva" pattern="{hour} ורבע" />
            <Rule range="30" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=nekeva" pattern="{hour} וחצי" />
            <Rule range="45" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=nekeva" pattern="רבע ל{hour}" />
        </ClockTime>
    </Language>
</Numbers>
