<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <!-- NTS-27: Sino-Korean numbers count by groups of four digits named 만, 억, 조 and are spaced by units of
         만 only (한글 맞춤법 제44항: "십이억 삼천사백오십육만 칠천팔백구십팔"): no space inside a group nor before
         its unit (the trigger below removes the separator the engine puts before the unit), one space between
         groups. 일 is not written before 십, 백, 천, but the multiplier one of 만/억/조 is (일억 삼천만). The word
         separator stays a space for the decimals and fractions ("일 점 오", "삼 나누기 이"). -->
    <Language
        groupSize="4"
        separator=" "
        groupSeparator=""
        zero="영"
        minus="마이너스 *"
        decimalSeparator="점"
        decimalDigitByDigitMaxDigits="0"
        fractionSeparator="나누기"
        maxNumber="9999999999999999"
    >
        <!-- NTS-34: no automatic decimal reading (D: NIKL: the reading of decimals is not regulated by the language norms; docs/NTS-34-decimal-reading-audit.md). LanguageDefault throws NotSupportedException for a decimal part; DecimalReadingMode.DigitByDigit, requested by the caller, is unchanged. -->
        <Culture>KO</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="일" />
                <Digit digit="2" string="이" />
                <Digit digit="3" string="삼" />
                <Digit digit="4" string="사" />
                <Digit digit="5" string="오" />
                <Digit digit="6" string="육" />
                <Digit digit="7" string="칠" />
                <Digit digit="8" string="팔" />
                <Digit digit="9" string="구" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="십" buildString="십*" />
                <Digit digit="2" string="이십" buildString="이십*" />
                <Digit digit="3" string="삼십" buildString="삼십*" />
                <Digit digit="4" string="사십" buildString="사십*" />
                <Digit digit="5" string="오십" buildString="오십*" />
                <Digit digit="6" string="육십" buildString="육십*" />
                <Digit digit="7" string="칠십" buildString="칠십*" />
                <Digit digit="8" string="팔십" buildString="팔십*" />
                <Digit digit="9" string="구십" buildString="구십*" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="백" buildString="백*" />
                <Digit digit="2" string="이백" buildString="이백*" />
                <Digit digit="3" string="삼백" buildString="삼백*" />
                <Digit digit="4" string="사백" buildString="사백*" />
                <Digit digit="5" string="오백" buildString="오백*" />
                <Digit digit="6" string="육백" buildString="육백*" />
                <Digit digit="7" string="칠백" buildString="칠백*" />
                <Digit digit="8" string="팔백" buildString="팔백*" />
                <Digit digit="9" string="구백" buildString="구백*" />
            </Group>
            <Group level="4">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="천" buildString="천*" />
                <Digit digit="2" string="이천" buildString="이천*" />
                <Digit digit="3" string="삼천" buildString="삼천*" />
                <Digit digit="4" string="사천" buildString="사천*" />
                <Digit digit="5" string="오천" buildString="오천*" />
                <Digit digit="6" string="육천" buildString="육천*" />
                <Digit digit="7" string="칠천" buildString="칠천*" />
                <Digit digit="8" string="팔천" buildString="팔천*" />
                <Digit digit="9" string="구천" buildString="구천*" />
            </Group>
        </Groups>
        <NumberScale firstLetterUpperCase="false">
            <StaticNames>
                <Scale value="0" string="" />
                <Scale value="1" string="만" />
                <Scale value="2" string="억" />
                <Scale value="3" string="조" />
            </StaticNames>
        </NumberScale>
        <Exceptions />
        <!-- NTS-27, 제44항: the unit of a group is attached to its multiplier (삼천사백오십육만, 일억). -->
        <Trigger executeAt="groupWithScale">
            <Replace from=" (만|억|조)$" to="$1" regex="true" />
        </Trigger>
        <!-- NTS-08: ordinal domain guard; values outside the validated domain fail closed (see KoreanOrdinalLanguageSpecifics). -->
        <LanguageSpecifics>KoreanOrdinalLanguageSpecifics</LanguageSpecifics>
        <Ordinals prefix="제" />
        <!-- Hours use native Korean attributive numerals (한, 두 ... 열두) while minutes use the
             Sino-Korean cardinals. The native forms are literal, clock-only patterns selected per
             displayed hour, so Convert and ConvertOrdinal keep the Sino-Korean numerals. Spacing
             follows Hangeul Matchumbeop art. 43 ("한 시 십오 분"). Neutral 12-hour clock without
             오전/오후. -->
        <ClockTime step="5" hourCycle="12">
            <Rule range="0" displayHourRange="1" hourOffset="0" hourForm="cardinal" pattern="한 시" />
            <Rule range="5,10,15,20,25,35,40,45,50,55" displayHourRange="1" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="한 시 {amount} 분" />
            <Rule range="30" displayHourRange="1" hourOffset="0" hourForm="cardinal" pattern="한 시 반" />
            <Rule range="0" displayHourRange="2" hourOffset="0" hourForm="cardinal" pattern="두 시" />
            <Rule range="5,10,15,20,25,35,40,45,50,55" displayHourRange="2" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="두 시 {amount} 분" />
            <Rule range="30" displayHourRange="2" hourOffset="0" hourForm="cardinal" pattern="두 시 반" />
            <Rule range="0" displayHourRange="3" hourOffset="0" hourForm="cardinal" pattern="세 시" />
            <Rule range="5,10,15,20,25,35,40,45,50,55" displayHourRange="3" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="세 시 {amount} 분" />
            <Rule range="30" displayHourRange="3" hourOffset="0" hourForm="cardinal" pattern="세 시 반" />
            <Rule range="0" displayHourRange="4" hourOffset="0" hourForm="cardinal" pattern="네 시" />
            <Rule range="5,10,15,20,25,35,40,45,50,55" displayHourRange="4" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="네 시 {amount} 분" />
            <Rule range="30" displayHourRange="4" hourOffset="0" hourForm="cardinal" pattern="네 시 반" />
            <Rule range="0" displayHourRange="5" hourOffset="0" hourForm="cardinal" pattern="다섯 시" />
            <Rule range="5,10,15,20,25,35,40,45,50,55" displayHourRange="5" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="다섯 시 {amount} 분" />
            <Rule range="30" displayHourRange="5" hourOffset="0" hourForm="cardinal" pattern="다섯 시 반" />
            <Rule range="0" displayHourRange="6" hourOffset="0" hourForm="cardinal" pattern="여섯 시" />
            <Rule range="5,10,15,20,25,35,40,45,50,55" displayHourRange="6" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="여섯 시 {amount} 분" />
            <Rule range="30" displayHourRange="6" hourOffset="0" hourForm="cardinal" pattern="여섯 시 반" />
            <Rule range="0" displayHourRange="7" hourOffset="0" hourForm="cardinal" pattern="일곱 시" />
            <Rule range="5,10,15,20,25,35,40,45,50,55" displayHourRange="7" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="일곱 시 {amount} 분" />
            <Rule range="30" displayHourRange="7" hourOffset="0" hourForm="cardinal" pattern="일곱 시 반" />
            <Rule range="0" displayHourRange="8" hourOffset="0" hourForm="cardinal" pattern="여덟 시" />
            <Rule range="5,10,15,20,25,35,40,45,50,55" displayHourRange="8" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="여덟 시 {amount} 분" />
            <Rule range="30" displayHourRange="8" hourOffset="0" hourForm="cardinal" pattern="여덟 시 반" />
            <Rule range="0" displayHourRange="9" hourOffset="0" hourForm="cardinal" pattern="아홉 시" />
            <Rule range="5,10,15,20,25,35,40,45,50,55" displayHourRange="9" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="아홉 시 {amount} 분" />
            <Rule range="30" displayHourRange="9" hourOffset="0" hourForm="cardinal" pattern="아홉 시 반" />
            <Rule range="0" displayHourRange="10" hourOffset="0" hourForm="cardinal" pattern="열 시" />
            <Rule range="5,10,15,20,25,35,40,45,50,55" displayHourRange="10" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="열 시 {amount} 분" />
            <Rule range="30" displayHourRange="10" hourOffset="0" hourForm="cardinal" pattern="열 시 반" />
            <Rule range="0" displayHourRange="11" hourOffset="0" hourForm="cardinal" pattern="열한 시" />
            <Rule range="5,10,15,20,25,35,40,45,50,55" displayHourRange="11" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="열한 시 {amount} 분" />
            <Rule range="30" displayHourRange="11" hourOffset="0" hourForm="cardinal" pattern="열한 시 반" />
            <Rule range="0" displayHourRange="12" hourOffset="0" hourForm="cardinal" pattern="열두 시" />
            <Rule range="5,10,15,20,25,35,40,45,50,55" displayHourRange="12" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="열두 시 {amount} 분" />
            <Rule range="30" displayHourRange="12" hourOffset="0" hourForm="cardinal" pattern="열두 시 반" />
        </ClockTime>
    </Language>
</Numbers>
