<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        baseOn="SCALE-LONG"
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="nula"
        minus="mínus *"
        decimalSeparator="celá"
    >
        <Culture>SK</Culture>
        <Culture>SK-SK</Culture>
        <!-- NTS-30B, Pravidlá slovenského pravopisu (JÚĽŠ SAV, 3rd ed. 2000, "Písanie slov osobitne a
             dovedna"; same rule in the 2013 edition, cf. TASR "Slovenčina: jednoslovné a viacslovné
             číslovky"): cardinals are one word (dvadsaťsedem, sedemstodvadsať); in complex cases the
             thousands, the hundreds and the tens-with-units may be written apart for readability
             (7 283 sedemtisíc dvesto osemdesiattri; 15 348 848 pätnásť miliónov tristoštyridsaťosemtisíc
             osemsto štyridsaťosem), which is the convention used here. Tens and units are always one
             word (dvadsaťdva), the hundreds are one word (dvesto, päťsto), the thousands are one word
             with their whole multiplier (tritisíc, dvadsaťsedemtisíc, stoosemdesiatdvatisíc, dvetisíc:
             KSSJ 4 / PSP 2013 / OGS 2022 "dvetisíc neskl. čísl."), millions and milliards are apart
             (štyri milióny, päť miliónov, tri miliardy). Jarošová, Slovenská reč 86/2 (2021), table
             2.4.1: tisíc dvadsaťdva, tisíc sto dva, tritisíc tristo dvadsaťdva, päťstoštyridsaťtritisíc
             tristo dvadsaťšesť, päť miliónov dvestotridsaťštyritisíc päťsto šesťdesiatsedem. -->
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="jeden" />
                <Digit digit="2" string="dva" />
                <Digit digit="3" string="tri" />
                <Digit digit="4" string="štyri" />
                <Digit digit="5" string="päť" />
                <Digit digit="6" string="šesť" />
                <Digit digit="7" string="sedem" />
                <Digit digit="8" string="osem" />
                <Digit digit="9" string="deväť" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <!-- 11–19 are handled as Exceptions -->
                <Digit digit="1" string="desať" buildString="desať*" />
                <Digit digit="2" string="dvadsať" buildString="dvadsať*" />
                <Digit digit="3" string="tridsať" buildString="tridsať*" />
                <Digit digit="4" string="štyridsať" buildString="štyridsať*" />
                <Digit digit="5" string="päťdesiat" buildString="päťdesiat*" />
                <Digit digit="6" string="šesťdesiat" buildString="šesťdesiat*" />
                <Digit digit="7" string="sedemdesiat" buildString="sedemdesiat*" />
                <Digit digit="8" string="osemdesiat" buildString="osemdesiat*" />
                <Digit digit="9" string="deväťdesiat" buildString="deväťdesiat*" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="sto" buildString="sto *" />
                <Digit digit="2" string="dvesto" buildString="dvesto *" />
                <Digit digit="3" string="tristo" buildString="tristo *" />
                <Digit digit="4" string="štyristo" buildString="štyristo *" />
                <Digit digit="5" string="päťsto" buildString="päťsto *" />
                <Digit digit="6" string="šesťsto" buildString="šesťsto *" />
                <Digit digit="7" string="sedemsto" buildString="sedemsto *" />
                <Digit digit="8" string="osemsto" buildString="osemsto *" />
                <Digit digit="9" string="deväťsto" buildString="deväťsto *" />
            </Group>
        </Groups>
        <!-- NTS-30B: the multiplier of tisíc is written as one word with it, its hundreds included
             (stoosemdesiatdvatisíc, päťstoštyridsaťtritisíc); the space before tisíc is removed by the
             onScale="1" replacement below. -->
        <Groups onScale="1">
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="jeden" />
                <Digit digit="2" string="dva" />
                <Digit digit="3" string="tri" />
                <Digit digit="4" string="štyri" />
                <Digit digit="5" string="päť" />
                <Digit digit="6" string="šesť" />
                <Digit digit="7" string="sedem" />
                <Digit digit="8" string="osem" />
                <Digit digit="9" string="deväť" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="desať" buildString="desať*" />
                <Digit digit="2" string="dvadsať" buildString="dvadsať*" />
                <Digit digit="3" string="tridsať" buildString="tridsať*" />
                <Digit digit="4" string="štyridsať" buildString="štyridsať*" />
                <Digit digit="5" string="päťdesiat" buildString="päťdesiat*" />
                <Digit digit="6" string="šesťdesiat" buildString="šesťdesiat*" />
                <Digit digit="7" string="sedemdesiat" buildString="sedemdesiat*" />
                <Digit digit="8" string="osemdesiat" buildString="osemdesiat*" />
                <Digit digit="9" string="deväťdesiat" buildString="deväťdesiat*" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="sto" buildString="sto*" />
                <Digit digit="2" string="dvesto" buildString="dvesto*" />
                <Digit digit="3" string="tristo" buildString="tristo*" />
                <Digit digit="4" string="štyristo" buildString="štyristo*" />
                <Digit digit="5" string="päťsto" buildString="päťsto*" />
                <Digit digit="6" string="šesťsto" buildString="šesťsto*" />
                <Digit digit="7" string="sedemsto" buildString="sedemsto*" />
                <Digit digit="8" string="osemsto" buildString="osemsto*" />
                <Digit digit="9" string="deväťsto" buildString="deväťsto*" />
            </Group>
        </Groups>
        <!-- Long scale with groupSeparator="li" (single l): mi+li+ón=milión, mi+li+ard=miliard,
             bi+li+ón=bilión, bi+li+ard=biliard, tri+li+ón=trilión…
             NTS-30B: milión and miliarda (feminine) agree with their multiplier (ScaleForm below);
             NTS-30C: the generated names from bilión up agree too, through one GeneratedScaleForm per
             suffix (dva bilióny, dve biliardy). -->
        <NumberScale firstLetterUpperCase="false" groupSeparator="li">
            <StaticNames>
                <Scale value="0" string="" />
                <!-- Slovak: "tisíc" alone for 1000; "jeden tisíc" → "tisíc" via Replacement -->
                <Scale value="1" string="tisíc" />
            </StaticNames>
            <Suffixes>
                <Suffix>ón</Suffix>
                <Suffix>ard</Suffix>
            </Suffixes>
            <!-- NTS-30B: nominative singular after one, nominative plural after 2-4, genitive plural otherwise;
                 a compound (dvadsaťjeden, dvadsaťdva) is one indeclinable word governing the genitive plural
                 (PSP 2000: štyri milióny, päť miliónov, tri miliardy; KSSJ 4 / PSP 2013: miliarda -y -iárd ž.;
                 Jarošová 2021, table 2.4.1: dvadsaťdva žien, detí; Unicode CLDR plural rules, sk).
                 CzechSlovakPluralLexicalFormSelector returns the key, the words are here. -->
            <ScaleForm scale="2" formSelector="CzechSlovakPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="milión" />
                    <Form key="few" value="milióny" />
                    <Form key="other" value="miliónov" />
                </Forms>
            </ScaleForm>
            <ScaleForm scale="3" formSelector="CzechSlovakPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="miliarda" />
                    <Form key="few" value="miliardy" />
                    <Form key="other" value="miliárd" />
                </Forms>
            </ScaleForm>
            <!-- NTS-30C: the generated scales alternate two families, by suffix index. -ón (bilión, trilión…)
                 is masculine: bilión, dva bilióny, päť biliónov (KSSJ 4: bilión -a m. čísl. zákl.; PSP 2000:
                 sedem biliónov); -arda is feminine like miliarda: jedna biliarda, dve biliardy, päť biliárd
                 (KSSJ 4 / PSP 2013: miliarda -y -árd ž.; Slovak Wikipedia "Biliarda": biliarda, triliarda,
                 kvadriliarda). A one-word compound stays indeclinable (dvadsaťdva biliárd, NTS-30B). -->
            <GeneratedScaleForm suffix="0" formSelector="CzechSlovakPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="ón" />
                    <Form key="few" value="óny" />
                    <Form key="other" value="ónov" />
                </Forms>
            </GeneratedScaleForm>
            <GeneratedScaleForm suffix="1" formSelector="CzechSlovakPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="arda" forceVariants="gender=ženský" />
                    <Form key="few" value="ardy" forceVariants="gender=ženský" />
                    <Form key="other" value="árd" />
                </Forms>
            </GeneratedScaleForm>
        </NumberScale>
        <Replacements>
            <!-- Drop "jeden" before "tisíc": 1000 = "tisíc" not "jeden tisíc" -->
            <Replacement oldValue="jeden tisíc" newValue="tisíc" onScale="1" onValue="1" />
            <!-- NTS-30B: 2000 is dvetisíc (KSSJ 4, PSP 2013, OGS 2022), a compound keeps dva
                 (stoosemdesiatdvatisíc, PSP); then the multiplier is joined to tisíc (tritisíc). -->
            <Replacement oldValue="dva tisíc" newValue="dvetisíc" onScale="1" onValue="2" />
            <Replacement oldValue=" tisíc" newValue="tisíc" scope="EndsWith" onScale="1" />
            <!-- NTS-30B: miliarda is feminine (jedna miliarda, dve miliardy); only the multipliers 1 and 2
                 themselves agree, a compound stays indeclinable (dvadsaťjeden, dvadsaťdva miliárd). -->
            <Replacement oldValue="jeden miliarda" newValue="jedna miliarda" onScale="3" onValue="1" />
            <Replacement oldValue="dva miliardy" newValue="dve miliardy" onScale="3" onValue="2" />
        </Replacements>
        <Exceptions>
            <Number value="11" string="jedenásť" />
            <Number value="12" string="dvanásť" />
            <Number value="13" string="trinásť" />
            <Number value="14" string="štrnásť" />
            <Number value="15" string="pätnásť" />
            <Number value="16" string="šestnásť" />
            <Number value="17" string="sedemnásť" />
            <Number value="18" string="osemnásť" />
            <Number value="19" string="devätnásť" />
        </Exceptions>
        <!-- Gender and case. Cardinals are declined for gender in the nominative only; the case
             dimension applies to ordinals (SlovakOrdinalLanguageSpecifics). -->
        <Variants>
            <Dimension name="gender" localName="rod" values="mužský,ženský,stredný" />
            <Dimension name="case" localName="pád" values="nominatív,genitív,datív,akuzatív,lokál,inštrumentál" />
            <Variant type="gender" variant="ženský">
                <Replacement oldValue="jeden" newValue="jedna" scope="LastWord" />
                <Replacement oldValue="dva" newValue="dve" scope="LastWord" />
            </Variant>
            <Variant type="gender" variant="stredný">
                <Replacement oldValue="jeden" newValue="jedno" scope="LastWord" />
                <Replacement oldValue="dva" newValue="dve" scope="LastWord" />
            </Variant>
        </Variants>
        <!-- NTS-30H: fractions are read by the language specifics (IFractionLanguageSpecifics) with the fraction nouns of
             P. Ondrus (Slovenská reč 1968) and KSSJ/PSP: jedna tretina, dve tretiny, päť tretín, jedna tisícina. "ku" reads
             a ratio (dvadsaťsedem má sa ku deviatim), not a fraction; "lomené" + instrumental needs a cardinal
             instrumental. Unestablished forms fail closed. -->
        <LanguageSpecifics>SlovakOrdinalLanguageSpecifics</LanguageSpecifics>
        <!-- Quarter-hour 12-hour clock without day-part wording. "hodina" is feminine: the whole
             hour agrees the noun with the count (jedna hodina, dve hodiny, päť hodín); quarters take
             the feminine accusative of the following hour (štvrť na dve); the half hour takes its
             feminine genitive ORDINAL (pol druhej). Hour one is spelled out where the
             accusative/genitive cardinal differs from the nominative ("na jednu", "pol jednej"). -->
        <ClockTime step="15" hourCycle="12">
            <Rule range="0" displayHourRange="1" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=ženský" pattern="{hour} hodina" />
            <Rule range="0" displayHourRange="2-4" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=ženský" pattern="{hour} hodiny" />
            <Rule range="0" displayHourRange="5-12" hourOffset="0" hourForm="cardinal" pattern="{hour} hodín" />
            <Rule range="15" displayHourRange="1" hourOffset="1" hourForm="cardinal" pattern="štvrť na jednu" />
            <Rule range="15" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=ženský" pattern="štvrť na {hour}" />
            <Rule range="30" displayHourRange="1" hourOffset="1" hourForm="cardinal" pattern="pol jednej" />
            <Rule range="30" displayHourRange="2-12" hourOffset="1" hourForm="ordinal" hourForceVariants="gender=ženský,case=genitív" pattern="pol {hour}" />
            <Rule range="45" displayHourRange="1" hourOffset="1" hourForm="cardinal" pattern="tri štvrte na jednu" />
            <Rule range="45" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=ženský" pattern="tri štvrte na {hour}" />
        </ClockTime>
    </Language>
</Numbers>
