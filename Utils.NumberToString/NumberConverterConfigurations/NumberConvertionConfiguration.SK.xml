<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        baseOn="SCALE-LONG"
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="nula"
        minus="mínus *"
        decimalSeparator="celá"
        fractionSeparator="ku"
    >
        <Culture>SK</Culture>
        <Culture>SK-SK</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="jeden" />
                <Digit digit="2" string="dva" />
                <Digit digit="3" string="tri" />
                <Digit digit="4" string="štyri" />
                <Digit digit="5" string="päť" />
                <Digit digit="6" string="šesť" />
                <Digit digit="7" string="sedem" />
                <Digit digit="8" string="osem" />
                <Digit digit="9" string="deväť" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <!-- 11–19 are handled as Exceptions -->
                <Digit digit="1" string="desať" buildString="desať *" />
                <Digit digit="2" string="dvadsať" buildString="dvadsať *" />
                <Digit digit="3" string="tridsať" buildString="tridsať *" />
                <Digit digit="4" string="štyridsať" buildString="štyridsať *" />
                <Digit digit="5" string="päťdesiat" buildString="päťdesiat *" />
                <Digit digit="6" string="šesťdesiat" buildString="šesťdesiat *" />
                <Digit digit="7" string="sedemdesiat" buildString="sedemdesiat *" />
                <Digit digit="8" string="osemdesiat" buildString="osemdesiat *" />
                <Digit digit="9" string="deväťdesiat" buildString="deväťdesiat *" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <!-- Slovak hundreds: sto, dvesto, tristo, štyri sto, päť sto … deväť sto -->
                <Digit digit="1" string="sto" buildString="sto *" />
                <Digit digit="2" string="dvesto" buildString="dvesto *" />
                <Digit digit="3" string="tristo" buildString="tristo *" />
                <Digit digit="4" string="štyri sto" buildString="štyri sto *" />
                <Digit digit="5" string="päť sto" buildString="päť sto *" />
                <Digit digit="6" string="šesť sto" buildString="šesť sto *" />
                <Digit digit="7" string="sedem sto" buildString="sedem sto *" />
                <Digit digit="8" string="osem sto" buildString="osem sto *" />
                <Digit digit="9" string="deväť sto" buildString="deväť sto *" />
            </Group>
        </Groups>
        <!-- Long scale with groupSeparator="li" (single l): mi+li+ón=milión, mi+li+ard=miliard,
             bi+li+ón=bilión, bi+li+ard=biliard, tri+li+ón=trilión…
             Note: Slovak uses "miliarda" (feminine) for 10^9 but invariant "miliard" is used here
             as a simplification since noun gender inflection is not supported by the engine. -->
        <NumberScale firstLetterUpperCase="false" groupSeparator="li">
            <StaticNames>
                <Scale value="0" string="" />
                <!-- Slovak: "tisíc" alone for 1000; "jeden tisíc" → "tisíc" via Replacement -->
                <Scale value="1" string="tisíc" />
            </StaticNames>
            <Suffixes>
                <Suffix>ón</Suffix>
                <Suffix>ard</Suffix>
            </Suffixes>
        </NumberScale>
        <Replacements>
            <!-- Drop "jeden" before "tisíc": 1000 = "tisíc" not "jeden tisíc" -->
            <Replacement oldValue="jeden tisíc" newValue="tisíc" onScale="1" onValue="1" />
        </Replacements>
        <Exceptions>
            <Number value="11" string="jedenásť" />
            <Number value="12" string="dvanásť" />
            <Number value="13" string="trinásť" />
            <Number value="14" string="štrnásť" />
            <Number value="15" string="pätnásť" />
            <Number value="16" string="šestnásť" />
            <Number value="17" string="sedemnásť" />
            <Number value="18" string="osemnásť" />
            <Number value="19" string="devätnásť" />
        </Exceptions>
        <!-- Gender and case. Cardinals are declined for gender in the nominative only; the case
             dimension applies to ordinals (SlovakOrdinalLanguageSpecifics). -->
        <Variants>
            <Dimension name="gender" localName="rod" values="mužský,ženský,stredný" />
            <Dimension name="case" localName="pád" values="nominatív,genitív,datív,akuzatív,lokál,inštrumentál" />
            <Variant type="gender" variant="ženský">
                <Replacement oldValue="jeden" newValue="jedna" scope="LastWord" />
                <Replacement oldValue="dva" newValue="dve" scope="LastWord" />
            </Variant>
            <Variant type="gender" variant="stredný">
                <Replacement oldValue="jeden" newValue="jedno" scope="LastWord" />
                <Replacement oldValue="dva" newValue="dve" scope="LastWord" />
            </Variant>
        </Variants>
        <LanguageSpecifics>SlovakOrdinalLanguageSpecifics</LanguageSpecifics>
        <!-- Quarter-hour 12-hour clock without day-part wording. "hodina" is feminine: the whole
             hour agrees the noun with the count (jedna hodina, dve hodiny, päť hodín); quarters take
             the feminine accusative of the following hour (štvrť na dve); the half hour takes its
             feminine genitive ORDINAL (pol druhej). Hour one is spelled out where the
             accusative/genitive cardinal differs from the nominative ("na jednu", "pol jednej"). -->
        <ClockTime step="15" hourCycle="12">
            <Rule range="0" displayHourRange="1" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=ženský" pattern="{hour} hodina" />
            <Rule range="0" displayHourRange="2-4" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=ženský" pattern="{hour} hodiny" />
            <Rule range="0" displayHourRange="5-12" hourOffset="0" hourForm="cardinal" pattern="{hour} hodín" />
            <Rule range="15" displayHourRange="1" hourOffset="1" hourForm="cardinal" pattern="štvrť na jednu" />
            <Rule range="15" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=ženský" pattern="štvrť na {hour}" />
            <Rule range="30" displayHourRange="1" hourOffset="1" hourForm="cardinal" pattern="pol jednej" />
            <Rule range="30" displayHourRange="2-12" hourOffset="1" hourForm="ordinal" hourForceVariants="gender=ženský,case=genitív" pattern="pol {hour}" />
            <Rule range="45" displayHourRange="1" hourOffset="1" hourForm="cardinal" pattern="tri štvrte na jednu" />
            <Rule range="45" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=ženský" pattern="tri štvrte na {hour}" />
        </ClockTime>
    </Language>
</Numbers>
