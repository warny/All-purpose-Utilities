<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        baseOn="SCALE-LONG"
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="nul"
        minus="min *"
        decimalSeparator="komma"
        decimalDigitByDigitMaxDigits="0"
        fractionSeparator="op"
        >
        <!-- NTS-34: no automatic decimal reading (D: no Taalunie or ANS statement; primary-school sites only; docs/NTS-34-decimal-reading-audit.md). LanguageDefault throws NotSupportedException for a decimal part; DecimalReadingMode.DigitByDigit, requested by the caller, is unchanged. -->
        <Culture>NL</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="een" />
                <Digit digit="2" string="twee" />
                <Digit digit="3" string="drie" />
                <Digit digit="4" string="vier" />
                <Digit digit="5" string="vijf" />
                <Digit digit="6" string="zes" />
                <Digit digit="7" string="zeven" />
                <Digit digit="8" string="acht" />
                <Digit digit="9" string="negen" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="tien" buildString="tien *" />
                <Digit digit="2" string="twintig" buildString="*entwintig" />
                <Digit digit="3" string="dertig" buildString="*endertig" />
                <Digit digit="4" string="veertig" buildString="*enveertig" />
                <Digit digit="5" string="vijftig" buildString="*envijftig" />
                <Digit digit="6" string="zestig" buildString="*enzestig" />
                <Digit digit="7" string="zeventig" buildString="*enzeventig" />
                <Digit digit="8" string="tachtig" buildString="*entachtig" />
                <Digit digit="9" string="negentig" buildString="*ennegentig" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="honderd" buildString="honderd*" />
                <Digit digit="2" string="tweehonderd" buildString="tweehonderd*" />
                <Digit digit="3" string="driehonderd" buildString="driehonderd*" />
                <Digit digit="4" string="vierhonderd" buildString="vierhonderd*" />
                <Digit digit="5" string="vijfhonderd" buildString="vijfhonderd*" />
                <Digit digit="6" string="zeshonderd" buildString="zeshonderd*" />
                <Digit digit="7" string="zevenhonderd" buildString="zevenhonderd*" />
                <Digit digit="8" string="achthonderd" buildString="achthonderd*" />
                <Digit digit="9" string="negenhonderd" buildString="negenhonderd*" />
            </Group>
        </Groups>
        <!-- NTS-31: long scale inherited from SCALE-LONG (Onze Taal 70, 2001, "Een miljard of een biljoen?":
             -iljoen/-iljard, "een miljoen miljoen is een biljoen", "duizend miljoen is een miljard"). The
             Conway-Guy-Wechsler tables are inherited unchanged: Dutch keeps the Latin quadri/quinti/sexti/octi
             (nl.wikipedia "Lijst van machten van tien": quadriljoen ... centiljoen). Only the junction before
             the suffix is Dutch: mi + l + joen (miljoen, biljard); the strict Conway -illi- joint between the
             groups of an index from 1000 stays inherited, so 10^6000 is milliniljoen (milli + ni + l + joen).
             The traditional milliljoen listed at 10^6000 by the same secondary table belongs to a different
             extension system: recorded in the sources, deliberately not used as an exception. The scale
             nouns are invariable after an exact numeral (twee miljoen, vijf miljard: Taaladvies). -->
        <NumberScale firstLetterUpperCase="false" suffixSeparator="l">
            <StaticNames>
                <Scale value="0" string="" />
                <Scale value="1" string="duizend" />
            </StaticNames>
            <Suffixes>
                <Suffix>joen</Suffix>
                <Suffix>jard</Suffix>
            </Suffixes>
        </NumberScale>
        <!-- NTS-08, Taaladvies (Taalunie) "Aaneenschrijven van telwoorden (algemeen)": numbers are written as
             one word up to and including duizend (honderdeen, tweeduizend, achtentwintigduizend), with a space
             after duizend (vierduizend twee); a diaeresis separates twee/drie from -en- (tweeëntwintig,
             drieënveertig). -->
        <Replacements>
            <Replacement oldValue="een duizend" newValue="duizend" onScale="1" onValue="1" />
            <Replacement oldValue=" duizend" newValue="duizend" onScale="1" scope="Anywhere" />
            <Replacement oldValue="tweeen" newValue="tweeën" scope="Anywhere" />
            <Replacement oldValue="drieen" newValue="drieën" scope="Anywhere" />
        </Replacements>
        <Exceptions>
            <Number value="11" string="elf" />
            <Number value="12" string="twaalf" />
            <Number value="13" string="dertien" />
            <Number value="14" string="veertien" />
            <Number value="15" string="vijftien" />
            <Number value="16" string="zestien" />
            <Number value="17" string="zeventien" />
            <Number value="18" string="achttien" />
            <Number value="19" string="negentien" />
        </Exceptions>
        <!--
          NTS-08: an ordinal keeps the spelling of its cardinal and adds -ste, -de or -e (Taaladvies:
          honderdste, honderdvijfendertigste, honderdentweede, drieduizend tweehonderdtwintigste; Woordenlijst:
          nulde, tweeëntwintigste, tweeduizendste, honderdeerste). Because the cardinals are written as one word
          up to duizend, the ending of the last word decides the suffix: the stem rules rewrite that ending and
          the suffix "e" completes it (een -> eerste, twee -> tweede, drie -> derde, acht -> achtste,
          -tig -> -tigste, honderd -> honderdste, duizend -> duizendste, nul -> nulde).
        -->
        <!-- NTS-31: the ordinal rule is productive over the whole ordinal domain of the engine (-long.MaxValue to
             long.MaxValue; long.MinValue is rejected by the engine); DutchOrdinalLanguageSpecifics keeps the
             explicit domain declaration (magnitudes 0 to long.MaxValue) and rejects nothing inside it. -->
        <LanguageSpecifics>DutchOrdinalLanguageSpecifics</LanguageSpecifics>
        <Ordinals suffix="e">
            <OrdinalException value="1" string="eerste" />
            <OrdinalStem from="nul"     to="nuld" />
            <OrdinalStem from="een"     to="eerst" />
            <OrdinalStem from="twee"    to="tweed" />
            <OrdinalStem from="drie"    to="derd" />
            <OrdinalStem from="vier"    to="vierd" />
            <OrdinalStem from="vijf"    to="vijfd" />
            <OrdinalStem from="zes"     to="zesd" />
            <OrdinalStem from="zeven"   to="zevend" />
            <OrdinalStem from="acht"    to="achtst" />
            <OrdinalStem from="negen"   to="negend" />
            <OrdinalStem from="tien"    to="tiend" />
            <OrdinalStem from="elf"     to="elfd" />
            <OrdinalStem from="twaalf"  to="twaalfd" />
            <OrdinalStem from="tig"     to="tigst" />
            <OrdinalStem from="honderd" to="honderdst" />
            <OrdinalStem from="duizend" to="duizendst" />
            <!-- NTS-31. e-ANS (Algemene Nederlandse Spraakkunst), rangtelwoorden: the scale nouns take -ste (miljoen ->
                 miljoenste, miljard -> miljardste), productive on every -joen/-jard noun. Besluit bekendmaking
                 spellingvoorschriften 2005, rule 6.N: "de twee miljoenste", "de twee miljoen tweehonderdduizendste",
                 "de twee miljoen tweehonderdduizend tweehonderdtweeëntwintigste": the earlier groups stay cardinal and
                 only the final element becomes ordinal (the usual last-word path, no OrdinalComposition), the multiplier
                 stays a separate cardinal word. OrdinalScale only drops "een" before a round scale noun (miljoenste,
                 miljardste); 2..6 = miljoen .. triljoen, the highest scale a long reaches. duizend (scale 1) is left
                 to the cardinal, which already drops "een" (duizendste, tweeduizendste). -->
            <OrdinalStem from="joen"    to="joenst" />
            <OrdinalStem from="jard"    to="jardst" />
            <OrdinalScale scales="2..6" multiplierSeparator=" " />
        </Ordinals>
        <YearFormat hundredWord="honderd">
            <SplitRange from="1100" to="1999" />
        </YearFormat>
        <!-- Taaladvies.net, "Kloktijden": "<n> over <h>", "<n> voor half <h+1>", "half <h+1>",
             "<n> over half <h+1>", "kwart voor <h+1>", "<n> voor <h+1>". The whole hour one keeps
             the distinctive accent ("één uur", Taaladvies "Klemtoonteken"); elsewhere "een" cannot
             be read as the article and stays unaccented. Neutral 12-hour clock without day part. -->
        <ClockTime step="5" hourCycle="12">
            <Rule range="0" displayHourRange="1" hourOffset="0" hourForm="cardinal" pattern="één uur" />
            <Rule range="0" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" pattern="{hour} uur" />
            <Rule range="5,10" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="{amount} over {hour}" />
            <Rule range="15" hourOffset="0" hourForm="cardinal" pattern="kwart over {hour}" />
            <Rule range="20,25" hourOffset="1" hourForm="cardinal" amountReference="30" amountDirection="before" pattern="{amount} voor half {hour}" />
            <Rule range="30" hourOffset="1" hourForm="cardinal" pattern="half {hour}" />
            <Rule range="35,40" hourOffset="1" hourForm="cardinal" amountReference="30" amountDirection="after" pattern="{amount} over half {hour}" />
            <Rule range="45" hourOffset="1" hourForm="cardinal" pattern="kwart voor {hour}" />
            <Rule range="50,55" hourOffset="1" hourForm="cardinal" amountReference="60" amountDirection="before" pattern="{amount} voor {hour}" />
        </ClockTime>
    </Language>
</Numbers>
