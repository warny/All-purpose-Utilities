<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        baseOn="SCALE-LONG"
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="nula"
        minus="minus *"
        decimalSeparator="celá"
    >
        <Culture>CS</Culture>
        <Culture>CS-CZ</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="jedna" />
                <Digit digit="2" string="dva" />
                <Digit digit="3" string="tři" />
                <Digit digit="4" string="čtyři" />
                <Digit digit="5" string="pět" />
                <Digit digit="6" string="šest" />
                <Digit digit="7" string="sedm" />
                <Digit digit="8" string="osm" />
                <Digit digit="9" string="devět" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <!-- 11–19 are handled as Exceptions -->
                <Digit digit="1" string="deset" buildString="deset *" />
                <Digit digit="2" string="dvacet" buildString="dvacet *" />
                <Digit digit="3" string="třicet" buildString="třicet *" />
                <Digit digit="4" string="čtyřicet" buildString="čtyřicet *" />
                <Digit digit="5" string="padesát" buildString="padesát *" />
                <Digit digit="6" string="šedesát" buildString="šedesát *" />
                <Digit digit="7" string="sedmdesát" buildString="sedmdesát *" />
                <Digit digit="8" string="osmdesát" buildString="osmdesát *" />
                <Digit digit="9" string="devadesát" buildString="devadesát *" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <!-- Czech hundreds: sto, dvě stě, tři sta, čtyři sta, pět set … devět set -->
                <Digit digit="1" string="sto" buildString="sto *" />
                <Digit digit="2" string="dvě stě" buildString="dvě stě *" />
                <Digit digit="3" string="tři sta" buildString="tři sta *" />
                <Digit digit="4" string="čtyři sta" buildString="čtyři sta *" />
                <Digit digit="5" string="pět set" buildString="pět set *" />
                <Digit digit="6" string="šest set" buildString="šest set *" />
                <Digit digit="7" string="sedm set" buildString="sedm set *" />
                <Digit digit="8" string="osm set" buildString="osm set *" />
                <Digit digit="9" string="devět set" buildString="devět set *" />
            </Group>
        </Groups>
        <!-- Long scale with groupSeparator="li" (single l): mi+li+on=milion, mi+li+ard=miliard,
             bi+li+on=bilion, bi+li+ard=biliard, tri+li+on=trilion…
             NTS-30B: tisíc, milion and miliarda (feminine) agree with their multiplier (ScaleForm
             below); NTS-30C: the generated names from bilion up agree too, through one
             GeneratedScaleForm per suffix (dva biliony, dvě biliardy). -->
        <NumberScale firstLetterUpperCase="false" groupSeparator="li">
            <StaticNames>
                <Scale value="0" string="" />
                <!-- Czech: "tisíc" alone for 1000; "jedna tisíc" → "tisíc" via Replacement -->
                <Scale value="1" string="tisíc" />
            </StaticNames>
            <!-- NTS-36: the SCALE-LONG Conway tables in Czech spelling. Attested (IJP, ÚJČ AV ČR, entries bilion,
                 trilion, triliarda, kvadrilion, kvintilion, sextilion, septilion, biliarda): qu is written kv
                 (kvadrilion, kvintilion), x and the other letters are kept (sextilion, septilion). The other
                 components follow the spelling rules of the domesticated Latin loans, each attested in the IJP:
                 qu → kv (kvartet, kvadragesima: kvadragint-), c read [k] → k (oktet, oktáva: okti-, okto,
                 oktogint-, oktingenti), c read [ts] kept (decimetr, centimetr: deci, centi, ducenti, trecenti,
                 sescenti), x kept (sexta: sexti, sexagint-), a Latin double consonant simplified (atribut <
                 attributum: kvatuor). Conway's construction and linking markers are unchanged (NTS-24); only the
                 spelling of the components differs from SCALE-LONG. -->
            <Scale0Prefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="mi" />
                <Digit digit="2" string="bi" />
                <Digit digit="3" string="tri" />
                <Digit digit="4" string="kvadri" />
                <Digit digit="5" string="kvinti" />
                <Digit digit="6" string="sexti" />
                <Digit digit="7" string="septi" />
                <Digit digit="8" string="okti" />
                <Digit digit="9" string="noni" />
            </Scale0Prefixes>
            <UnitsPrefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="un" />
                <Digit digit="2" string="duo" />
                <Digit digit="3" string="tre(s)" />
                <Digit digit="4" string="kvatuor" />
                <Digit digit="5" string="kvinkva" />
                <Digit digit="6" string="se(xs)" />
                <Digit digit="7" string="septe(mn)" />
                <Digit digit="8" string="okto" />
                <Digit digit="9" string="nove(mn)" />
            </UnitsPrefixes>
            <TensPrefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="(n)deci" />
                <Digit digit="2" string="(ms)viginti" />
                <Digit digit="3" string="(ns)trigint[a|-illi=>i]" />
                <Digit digit="4" string="(ns)kvadragint[a|-illi=>i]" />
                <Digit digit="5" string="(ns)kvinkvagint[a|-illi=>i]" />
                <Digit digit="6" string="(n)sexagint[a|-illi=>i]" />
                <Digit digit="7" string="(n)septuagint[a|-illi=>i]" />
                <Digit digit="8" string="(mxs)oktogint[a|-illi=>i]" />
                <Digit digit="9" string="nonagint[a|-illi=>i]" />
            </TensPrefixes>
            <HundredsPrefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="(nxs)centi" />
                <Digit digit="2" string="(n)ducenti" />
                <Digit digit="3" string="(ns)trecenti" />
                <Digit digit="4" string="(ns)kvadringenti" />
                <Digit digit="5" string="(ns)kvingenti" />
                <Digit digit="6" string="(n)sescenti" />
                <Digit digit="7" string="(n)septingenti" />
                <Digit digit="8" string="(mxs)oktingenti" />
                <Digit digit="9" string="nongenti" />
            </HundredsPrefixes>
            <!-- NTS-30B: nominative singular after one, nominative plural after 2-4, genitive plural otherwise,
                 including the compounds (Internetová jazyková příručka, ÚJČ AV ČR, "Počítaný předmět po
                 číslovkách": after dvacet jeden / dvacet dva the genitive is "more common and more natural";
                 "Členění čísel": dva tisíce dvě stě třicet jedna, jeden milion tři sta tisíc; entries tisíc,
                 milion, miliarda; Unicode CLDR plural rules, cs). CzechSlovakPluralLexicalFormSelector
                 returns the key, the words are here. -->
            <ScaleForm scale="1" formSelector="CzechSlovakPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="tisíc" />
                    <Form key="few" value="tisíce" />
                    <Form key="other" value="tisíc" />
                </Forms>
            </ScaleForm>
            <ScaleForm scale="2" formSelector="CzechSlovakPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="milion" />
                    <Form key="few" value="miliony" />
                    <Form key="other" value="milionů" />
                </Forms>
            </ScaleForm>
            <ScaleForm scale="3" formSelector="CzechSlovakPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="miliarda" />
                    <Form key="few" value="miliardy" />
                    <Form key="other" value="miliard" />
                </Forms>
            </ScaleForm>
            <!-- NTS-30C: the generated scales alternate two families, by suffix index. -on (bilion, trilion,
                 kvadrilion…) is masculine inanimate: bilion, dva biliony, pět bilionů, jeden bilion; -ard is
                 the feminine biliarda: jedna biliarda, dvě biliardy, pět biliard (IJP, ÚJČ AV ČR, entries
                 bilion, trilion, kvadrilion, biliarda: 23 biliard dolarů). After a compound the genitive
                 construction keeps the counting form of the numeral, as for milion and miliarda above
                 (IJP "Počítaný předmět po číslovkách": dvacet jedna žáků; "Členění čísel": dvacet dva
                 korunám): dvacet dva biliard. Only the exact multipliers 1-4 agree in gender.
                 NTS-42 F: the singular.* and plural.* keys are the cases the fraction plugin declines
                 (CzechOrdinalLanguageSpecifics, through the converter: the plugin holds no Conway name). They
                 are the IJP paradigms of the family, identical for every attested member, the prefix never
                 touching the ending: bilion, trilion, kvadrilion, kvintilion, sextilion (2. -u, 3. -u, 6. -u,
                 7. -em; pl. -y, -ů, -ům, -y, -ech, -y; septilion also 6. septilioně), biliarda, triliarda
                 (pattern žena: 2. -y, 3. -ě, 4. -u, 6. -ě, 7. -ou; pl. -y, -0, -ám, -y, -ách, -ami). -->
            <GeneratedScaleForm suffix="0" formSelector="CzechSlovakPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="on" forceVariants="gender=mužský" />
                    <Form key="few" value="ony" />
                    <Form key="other" value="onů" />
                    <Form key="singular.nominative" value="on" />
                    <Form key="singular.genitive" value="onu" />
                    <Form key="singular.dative" value="onu" />
                    <Form key="singular.accusative" value="on" />
                    <Form key="singular.locative" value="onu" />
                    <Form key="singular.instrumental" value="onem" />
                    <Form key="plural.nominative" value="ony" />
                    <Form key="plural.genitive" value="onů" />
                    <Form key="plural.dative" value="onům" />
                    <Form key="plural.accusative" value="ony" />
                    <Form key="plural.locative" value="onech" />
                    <Form key="plural.instrumental" value="ony" />
                </Forms>
            </GeneratedScaleForm>
            <GeneratedScaleForm suffix="1" formSelector="CzechSlovakPluralLexicalFormSelector">
                <Forms>
                    <Form key="one" value="arda" forceVariants="gender=ženský" />
                    <Form key="few" value="ardy" forceVariants="gender=ženský" />
                    <Form key="other" value="ard" />
                    <Form key="singular.nominative" value="arda" />
                    <Form key="singular.genitive" value="ardy" />
                    <Form key="singular.dative" value="ardě" />
                    <Form key="singular.accusative" value="ardu" />
                    <Form key="singular.locative" value="ardě" />
                    <Form key="singular.instrumental" value="ardou" />
                    <Form key="plural.nominative" value="ardy" />
                    <Form key="plural.genitive" value="ard" />
                    <Form key="plural.dative" value="ardám" />
                    <Form key="plural.accusative" value="ardy" />
                    <Form key="plural.locative" value="ardách" />
                    <Form key="plural.instrumental" value="ardami" />
                </Forms>
            </GeneratedScaleForm>
        </NumberScale>
        <Replacements>
            <!-- Drop "jedna" before "tisíc": 1000 = "tisíc" not "jedna tisíc" -->
            <Replacement oldValue="jedna tisíc" newValue="tisíc" onScale="1" onValue="1" />
            <!-- NTS-30B: the default digits are the counting forms (jedna, dva). milion is masculine (jeden
                 milion), miliarda feminine (dvě miliardy). Only the multipliers 1 and 2 themselves agree:
                 in the genitive construction of the compounds the counting form stays (dvacet jedna
                 milionů, IJP: dvacet jedna žáků). -->
            <Replacement oldValue="jedna milion" newValue="jeden milion" onScale="2" onValue="1" />
            <Replacement oldValue="dva miliardy" newValue="dvě miliardy" onScale="3" onValue="2" />
        </Replacements>
        <Exceptions>
            <Number value="11" string="jedenáct" />
            <Number value="12" string="dvanáct" />
            <Number value="13" string="třináct" />
            <Number value="14" string="čtrnáct" />
            <Number value="15" string="patnáct" />
            <Number value="16" string="šestnáct" />
            <Number value="17" string="sedmnáct" />
            <Number value="18" string="osmnáct" />
            <Number value="19" string="devatenáct" />
        </Exceptions>
        <!-- Gender and case. The default "standalone" value keeps the counting forms of the
             cardinals (jedna, dva) and the masculine citation form of the ordinals (první, druhý).
             Cardinals are declined for gender in the nominative only; the case dimension applies
             to ordinals (CzechOrdinalLanguageSpecifics). -->
        <Variants>
            <Dimension name="gender" localName="rod" values="standalone,mužský,ženský,střední" />
            <Dimension name="case" localName="pád" values="nominativ,genitiv,dativ,akuzativ,lokál,instrumentál" />
            <Variant type="gender" variant="mužský">
                <Replacement oldValue="jedna" newValue="jeden" scope="LastWord" />
            </Variant>
            <Variant type="gender" variant="ženský">
                <Replacement oldValue="dva" newValue="dvě" scope="LastWord" />
            </Variant>
            <Variant type="gender" variant="střední">
                <Replacement oldValue="jedna" newValue="jedno" scope="LastWord" />
                <Replacement oldValue="dva" newValue="dvě" scope="LastWord" />
            </Variant>
        </Variants>
        <!-- NTS-30H: fractions are read by the language specifics (IFractionLanguageSpecifics) with the fraction nouns of the
             IJP: jedna třetina, dvě třetiny, pět sedmin, jedna tisícina. the IJP gives no fraction reading with "ku".
             NTS-39: genitive plural after a compound numerator (dvacet dva třetin); denominators 2-999 without a noun
             read "lomeno" + instrumental (dvě lomeno třemi, jedna lomeno dvaceti třemi). NTS-41: every part declined up
             to 999 999 999 999 (jedna lomeno dvěma tisíci dvaceti třemi, jedna lomeno sto jednou). NTS-40: the fraction
             nouns in every case (dvěma třetinám, třemi sty šedesáti pěti tisícinami). Other values fail closed. -->
        <LanguageSpecifics>CzechOrdinalLanguageSpecifics</LanguageSpecifics>
        <!-- Internetová jazyková příručka (ÚJČ AV ČR), "Časové údaje". Quarter-hour 12-hour clock
             without day-part wording. "hodina" is feminine: the whole hour agrees the noun with the
             count (jedna hodina, dvě hodiny, pět hodin); quarters take the feminine accusative of
             the following hour (čtvrt na dvě); the half hour takes its feminine genitive ORDINAL
             (půl druhé). Hour one is spelled out where the accusative/genitive cardinal differs
             from the nominative ("na jednu", "půl jedné"). -->
        <ClockTime step="15" hourCycle="12">
            <Rule range="0" displayHourRange="1" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=ženský" pattern="{hour} hodina" />
            <Rule range="0" displayHourRange="2-4" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=ženský" pattern="{hour} hodiny" />
            <Rule range="0" displayHourRange="5-12" hourOffset="0" hourForm="cardinal" pattern="{hour} hodin" />
            <Rule range="15" displayHourRange="1" hourOffset="1" hourForm="cardinal" pattern="čtvrt na jednu" />
            <Rule range="15" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=ženský" pattern="čtvrt na {hour}" />
            <Rule range="30" displayHourRange="1" hourOffset="1" hourForm="cardinal" pattern="půl jedné" />
            <Rule range="30" displayHourRange="2-12" hourOffset="1" hourForm="ordinal" hourForceVariants="gender=ženský,case=genitiv" pattern="půl {hour}" />
            <Rule range="45" displayHourRange="1" hourOffset="1" hourForm="cardinal" pattern="tři čtvrtě na jednu" />
            <Rule range="45" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=ženský" pattern="tři čtvrtě na {hour}" />
        </ClockTime>
    </Language>
</Numbers>
