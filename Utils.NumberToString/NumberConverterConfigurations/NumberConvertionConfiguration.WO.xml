<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <!--
      NTS-19 orthography. Spelling: decree 2005-992 (one accent on a closed long vowel: téeméer,
      juróom; the connective -u/-i attached to the completed term, Art. 13: "ñaari tomb"). The words
      of a numeral are separated by spaces, as in every consulted grammar (Kosogorova 2023, Robert
      2021, Gaye 1980, Wiktionary); the decree hyphenates only lexicalized compounds (Art. 21).
      The multiplier of téeméer and junni bears the connective -i on its last element ("ñaari
      téeméer", "juróom benni téeméer", "ñaari junni", "fukki junni", "téeméeri junni"); the tens do
      not ("ñaar fukk"). "ak" joins every lower part ("téeméer ak benn", "junni ak benn").
      Zero is "tus" (Boston University 200 Word Project, Wiktionary, Janga Wolof).
      NTS-21: the scales above junni are the French loans milyoŋ (10^6) and milyaar (10^9): Wolof Bible
      (eBible wolmbs, Mt 25 "benn milyoŋ", "ñaari milyoŋ", "juróomi milyoŋ"), Wolof Ajami Reader (Boston
      University, "juróomi milyaar", "juróom fukki milyoŋ"), BU 200 Word Project "benn milyoŋ"; Guérin and
      Wolof university teaching material (milyoŋ / milyaar) as checked in the PR #628 review. Their
      pair is the LONG scale (million, milliard), which the library extends productively with the
      Conway-Guy-Wechsler tables below; the higher names are a library convention, not attested usage.
    -->
    <Language
        groupSize="3"
        separator=" "
        groupSeparator=""
        groupConnector="ak"
        groupConnectorThreshold="1000"
        zero="tus"
        minus="minus *"
        decimalSeparator="pojint"
        fractionSeparator="ci"
        >
        <Culture>WO</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="benn" />
                <Digit digit="2" string="ñaar" />
                <Digit digit="3" string="ñett" />
                <Digit digit="4" string="ñent" />
                <Digit digit="5" string="juróom" />
                <Digit digit="6" string="juróom benn" />
                <Digit digit="7" string="juróom ñaar" />
                <Digit digit="8" string="juróom ñett" />
                <Digit digit="9" string="juróom ñent" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="fukk" buildString="fukk ak *" />
                <Digit digit="2" string="ñaar fukk" buildString="ñaar fukk ak *" />
                <Digit digit="3" string="ñett fukk" buildString="ñett fukk ak *" />
                <Digit digit="4" string="ñent fukk" buildString="ñent fukk ak *" />
                <Digit digit="5" string="juróom fukk" buildString="juróom fukk ak *" />
                <Digit digit="6" string="juróom benn fukk" buildString="juróom benn fukk ak *" />
                <Digit digit="7" string="juróom ñaar fukk" buildString="juróom ñaar fukk ak *" />
                <Digit digit="8" string="juróom ñett fukk" buildString="juróom ñett fukk ak *" />
                <Digit digit="9" string="juróom ñent fukk" buildString="juróom ñent fukk ak *" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="téeméer" buildString="téeméer ak *" />
                <Digit digit="2" string="ñaari téeméer" buildString="ñaari téeméer ak *" />
                <Digit digit="3" string="ñetti téeméer" buildString="ñetti téeméer ak *" />
                <Digit digit="4" string="ñenti téeméer" buildString="ñenti téeméer ak *" />
                <Digit digit="5" string="juróomi téeméer" buildString="juróomi téeméer ak *" />
                <Digit digit="6" string="juróom benni téeméer" buildString="juróom benni téeméer ak *" />
                <Digit digit="7" string="juróom ñaari téeméer" buildString="juróom ñaari téeméer ak *" />
                <Digit digit="8" string="juróom ñetti téeméer" buildString="juróom ñetti téeméer ak *" />
                <Digit digit="9" string="juróom ñenti téeméer" buildString="juróom ñenti téeméer ak *" />
            </Group>
        </Groups>
        <!--
          NTS-21. Long scale (-yoŋ for 10^(6n), -yaar for 10^(6n+3)) on the strict Conway-Guy-Wechsler
          structure of SCALE.xml (NTS-24), spelled with Wolof letter values: qu → kw, x → ks, v → w,
          soft c → s, hard c → k (centi → senti, octo → okto, novem → nowem); -on → -yoŋ and -ard → -yaar after the
          junction l (mi + l + yoŋ = milyoŋ). Groups above 999 are joined by li, an empty one being ni:
          1000 = mi + li + ni + l + yoŋ = milinilyoŋ. Only milyoŋ and milyaar are attested.
        -->
        <NumberScale firstLetterUpperCase="false" groupSeparator="li" suffixSeparator="l" voidGroup="ni">
            <StaticNames>
                <Scale value="0" string="" />
                <Scale value="1" string="junni" />
            </StaticNames>
            <Suffixes>
                <Suffix>yoŋ</Suffix>
                <Suffix>yaar</Suffix>
            </Suffixes>
            <Scale0Prefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="mi" />
                <Digit digit="2" string="bi" />
                <Digit digit="3" string="tri" />
                <Digit digit="4" string="kwadri" />
                <Digit digit="5" string="kwinti" />
                <Digit digit="6" string="seksti" />
                <Digit digit="7" string="septi" />
                <Digit digit="8" string="okti" />
                <Digit digit="9" string="noni" />
            </Scale0Prefixes>
            <UnitsPrefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="un" />
                <Digit digit="2" string="duo" />
                <Digit digit="3" string="tre(s)" />
                <Digit digit="4" string="kwattuor" />
                <Digit digit="5" string="kwinkwa" />
                <Digit digit="6" string="se(ks,s)" />
                <Digit digit="7" string="septe(mn)" />
                <Digit digit="8" string="okto" />
                <Digit digit="9" string="nowe(mn)" />
            </UnitsPrefixes>
            <TensPrefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="(n)desi" />
                <Digit digit="2" string="(ms)wiginti" />
                <Digit digit="3" string="(ns)trigint[a|-illi=>i]" />
                <Digit digit="4" string="(ns)kwadragint[a|-illi=>i]" />
                <Digit digit="5" string="(ns)kwinkwagint[a|-illi=>i]" />
                <Digit digit="6" string="(n)seksagint[a|-illi=>i]" />
                <Digit digit="7" string="(n)septuagint[a|-illi=>i]" />
                <Digit digit="8" string="(m,ks,s)oktogint[a|-illi=>i]" />
                <Digit digit="9" string="nonagint[a|-illi=>i]" />
            </TensPrefixes>
            <HundredsPrefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="(n,ks,s)senti" />
                <Digit digit="2" string="(n)dusenti" />
                <Digit digit="3" string="(ns)tresenti" />
                <Digit digit="4" string="(ns)kwadringenti" />
                <Digit digit="5" string="(ns)kwingenti" />
                <Digit digit="6" string="(n)sessenti" />
                <Digit digit="7" string="(n)septingenti" />
                <Digit digit="8" string="(m,ks,s)oktingenti" />
                <Digit digit="9" string="nongenti" />
            </HundredsPrefixes>
        </NumberScale>
        <Replacements>
            <!-- 1000 is junni alone -->
            <Replacement oldValue="benn junni" newValue="junni" onScale="1" onValue="1" />
            <!-- The connective -i on the last element of any other multiplier of junni -->
            <Replacement oldValue="benn junni" newValue="benni junni" scope="EndsWith" onScale="1" onValue="2..999" />
            <Replacement oldValue="ñaar junni" newValue="ñaari junni" scope="EndsWith" onScale="1" />
            <Replacement oldValue="ñett junni" newValue="ñetti junni" scope="EndsWith" onScale="1" />
            <Replacement oldValue="ñent junni" newValue="ñenti junni" scope="EndsWith" onScale="1" />
            <Replacement oldValue="juróom junni" newValue="juróomi junni" scope="EndsWith" onScale="1" />
            <Replacement oldValue="fukk junni" newValue="fukki junni" scope="EndsWith" onScale="1" />
            <Replacement oldValue="téeméer junni" newValue="téeméeri junni" scope="EndsWith" onScale="1" />
        </Replacements>
        <Exceptions>
            <Number value="11" string="fukk ak benn" />
            <Number value="12" string="fukk ak ñaar" />
            <Number value="13" string="fukk ak ñett" />
            <Number value="14" string="fukk ak ñent" />
            <Number value="15" string="fukk ak juróom" />
            <Number value="16" string="fukk ak juróom benn" />
            <Number value="17" string="fukk ak juróom ñaar" />
            <Number value="18" string="fukk ak juróom ñett" />
            <Number value="19" string="fukk ak juróom ñent" />
        </Exceptions>
        <!--
          NTS-21. The multiplier of milyoŋ, milyaar and every higher scale (all ending in yoŋ or yaar)
          takes the connective -i on its last element, as for téeméer and junni. Attested: "benn milyoŋ"
          (bare one), "ñaari milyoŋ", "juróomi milyoŋ", "fukki milyoŋ" (Wolof Bible, Mt 25), "juróom
          fukki milyoŋ", "juróomi milyaar" (Wolof Ajami Reader). The other multipliers 1-999 apply the
          same NTS-19 rule productively ("fukk ak benni milyoŋ").
        -->
        <Trigger executeAt="groupWithScale">
            <Replace from="(?&lt;!\S)(ñaar|ñett|ñent|juróom|fukk|téeméer) (\S+(?:yoŋ|yaar))$" to="${1}i ${2}" regex="true" />
            <Replace from="(?&lt;= )benn (\S+(?:yoŋ|yaar))$" to="benni ${1}" regex="true" />
        </Trigger>
        <!--
          Ordinals (NTS-16, spelling NTS-19): the suffix goes on the last element of the cardinal
          (Kosogorova 2023 §4.2: "juróom ñetteel", "fukk ak ñaareel"; Robert 2021). Spelling -éel:
          decree 2005-992 Art. 13 "fukkéelu garab gi", a suffix's spelling being invariable (Art. 20).
          The guard rejects zero (no attested ordinal of zero) and the round thousands, whose last
          element junni has conflicting forms (Omniglot "junneel", Janga Wolof "junniéél").
        -->
        <LanguageSpecifics>WolofOrdinalLanguageSpecifics</LanguageSpecifics>
        <Ordinals suffix="éel">
            <!-- 1: suppletive relative form of jëkk "to be first", cited in class B (Ngom 2003: "xale b-u njëkk") -->
            <OrdinalException value="1" string="bu njëkk" />
        </Ordinals>
    </Language>
</Numbers>
