<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        baseOn="SCALE-LONG"
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="noll"
        minus="minus *"
        decimalSeparator="komma"
        decimalDigitByDigitMaxDigits="0"
        fractionSeparator="över"
    >
        <!-- NTS-34: no automatic decimal reading (C: Isof, Frågelådan: 10,85 läser ut det tio komma åttiofem (the decimal part read as a number); docs/NTS-34-decimal-reading-audit.md). LanguageDefault throws NotSupportedException for a decimal part; DecimalReadingMode.DigitByDigit, requested by the caller, is unchanged. -->
        <Culture>SV</Culture>
        <Culture>SV-SE</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="ett" />
                <Digit digit="2" string="två" />
                <Digit digit="3" string="tre" />
                <Digit digit="4" string="fyra" />
                <Digit digit="5" string="fem" />
                <Digit digit="6" string="sex" />
                <Digit digit="7" string="sju" />
                <Digit digit="8" string="åtta" />
                <Digit digit="9" string="nio" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <!-- 11–19 are handled as Exceptions; tio* is the fallback -->
                <Digit digit="1" string="tio" buildString="tio*" />
                <!-- 20s fuse without space: tjugoett, tjugotvå, etc. -->
                <Digit digit="2" string="tjugo" buildString="tjugo*" />
                <Digit digit="3" string="trettio" buildString="trettio*" />
                <Digit digit="4" string="fyrtio" buildString="fyrtio*" />
                <Digit digit="5" string="femtio" buildString="femtio*" />
                <Digit digit="6" string="sextio" buildString="sextio*" />
                <Digit digit="7" string="sjuttio" buildString="sjuttio*" />
                <Digit digit="8" string="åttio" buildString="åttio*" />
                <Digit digit="9" string="nittio" buildString="nittio*" />
            </Group>
            <!-- NTS-27: Språkrådet, Frågelådan 27138: numbers below a million are one word (tjugofem,
                 femhundra, femtusentrettio); 21216: "etthundratjugoen". -->
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="etthundra" buildString="etthundra*" />
                <Digit digit="2" string="tvåhundra" buildString="tvåhundra*" />
                <Digit digit="3" string="trehundra" buildString="trehundra*" />
                <Digit digit="4" string="fyrahundra" buildString="fyrahundra*" />
                <Digit digit="5" string="femhundra" buildString="femhundra*" />
                <Digit digit="6" string="sexhundra" buildString="sexhundra*" />
                <Digit digit="7" string="sjuhundra" buildString="sjuhundra*" />
                <Digit digit="8" string="åttahundra" buildString="åttahundra*" />
                <Digit digit="9" string="niohundra" buildString="niohundra*" />
            </Group>
        </Groups>
        <!-- Long scale with groupSeparator="l": mi+l+jon(er)=miljon(er), mi+l+jard(er)=miljard(er),
             bi+l+jon(er)=biljon(er), bi+l+jard(er)=biljard(er), tri+l+jon(er)=triljon(er)…
             Swedish uses kv spellings for quadri/quinti: kvadriljon, kvintiljon. -->
        <NumberScale firstLetterUpperCase="false" groupSeparator="l">
            <StaticNames>
                <Scale value="0" string="" />
                <!-- Swedish: "tusen" alone for 1000; "ett tusen" is non-standard -->
                <Scale value="1" string="tusen" />
            </StaticNames>
            <Suffixes>
                <Suffix>jon(er)</Suffix>
                <Suffix>jard(er)</Suffix>
            </Suffixes>
            <Scale0Prefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="mi" />
                <Digit digit="2" string="bi" />
                <Digit digit="3" string="tri" />
                <Digit digit="4" string="kvadri" />
                <Digit digit="5" string="kvinti" />
                <Digit digit="6" string="sexti" />
                <Digit digit="7" string="septi" />
                <Digit digit="8" string="okti" />
                <Digit digit="9" string="noni" />
            </Scale0Prefixes>
        </NumberScale>
        <Replacements>
            <!-- Drop "ett" before "tusen": 1000 = "tusen" not "ett tusen" -->
            <Replacement oldValue="ett tusen" newValue="tusen" onScale="1" onValue="1" />
        </Replacements>
        <Exceptions>
            <Number value="11" string="elva" />
            <Number value="12" string="tolv" />
            <Number value="13" string="tretton" />
            <Number value="14" string="fjorton" />
            <Number value="15" string="femton" />
            <Number value="16" string="sexton" />
            <Number value="17" string="sjutton" />
            <Number value="18" string="arton" />
            <Number value="19" string="nitton" />
        </Exceptions>
        <!-- NTS-27 (Språkrådet, Frågelådan 27138, 21216, 31080). Below a million the number is one word: the
             thousands are soldered to their multiplier and to the units group (femtusentrettio); after the tens
             the multiplier ends in "en" (tjugoentusen, like "tjugoen kilo"); ett + tusen drops one t
             (etthundraettusen). From a million, miljon, miljard … stand apart and take "en" for one and after
             the tens (en miljon, tjugoen miljoner). A standalone number keeps "ett" (tjugoett, "Han är tjugoett"). -->
        <Trigger executeAt="groupWithScale(1)">
            <Replace from="(tjugo|trettio|fyrtio|femtio|sextio|sjuttio|åttio|nittio)ett tusen$" to="${1}en tusen" regex="true" />
            <Replace from=" tusen$" to="tusen" regex="true" />
            <Replace from="etttusen$" to="ettusen" regex="true" />
        </Trigger>
        <Trigger executeAt="groupWithScale">
            <Replace from="^((?:\S*(?:tjugo|trettio|fyrtio|femtio|sextio|sjuttio|åttio|nittio))?)ett (\S*l(?:jon|jard)(?:er)?)$" to="${1}en ${2}" regex="true" />
        </Trigger>
        <Trigger executeAt="end">
            <Replace from="tusen (?=\S)" to="tusen" regex="true" />
        </Trigger>
        <!-- Productive ordinals (första, tjugoförsta, hundraförsta, tusende): see
             SwedishOrdinalLanguageSpecifics. -->
        <LanguageSpecifics>SwedishOrdinalLanguageSpecifics</LanguageSpecifics>
        <!-- Neutral 12-hour clock without day-part wording. The clock hour one is "ett", which is
             already the Swedish cardinal. "tjugo över" (:20) and "tjugo i" (:40) keep the minute
             count; :25 and :35 refer to "halv <next hour>". -->
        <ClockTime step="5" hourCycle="12">
            <Rule range="0" hourOffset="0" hourForm="cardinal" pattern="{hour}" />
            <Rule range="5,10,20" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="{amount} över {hour}" />
            <Rule range="15" hourOffset="0" hourForm="cardinal" pattern="kvart över {hour}" />
            <Rule range="25" hourOffset="1" hourForm="cardinal" amountReference="30" amountDirection="before" pattern="{amount} i halv {hour}" />
            <Rule range="30" hourOffset="1" hourForm="cardinal" pattern="halv {hour}" />
            <Rule range="35" hourOffset="1" hourForm="cardinal" amountReference="30" amountDirection="after" pattern="{amount} över halv {hour}" />
            <Rule range="40,50,55" hourOffset="1" hourForm="cardinal" amountReference="60" amountDirection="before" pattern="{amount} i {hour}" />
            <Rule range="45" hourOffset="1" hourForm="cardinal" pattern="kvart i {hour}" />
        </ClockTime>
    </Language>
</Numbers>
