            <Number value="17" string="सत्रह" />
            <Number value="18" string="अठारह" />
            <Number value="19" string="उन्नीस" />
            <!-- 21-99 are lexicalized (NTS-10). Sources: Wiktionary Module:number_list/data/hi,
                 Unicode CLDR RBNF hi and a school counting list; divergent spellings follow the
                 majority (31 इकतीस, 44 चौवालीस, 53 तिरपन, 63 तिरसठ, 79 उन्यासी, 91-99 in -नवे).
                 Round tens stay composed from the tens digit. -->
