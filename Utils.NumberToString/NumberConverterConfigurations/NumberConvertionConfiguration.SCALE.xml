<?xml version="1.0" encoding="utf-8" ?>
<!--
    Scale base configurations.
    These languages are NOT intended for direct use.  They define only the
    NumberScale section and the minimum required fields so that other language
    configurations can inherit a complete scale definition via baseOn=.

    SCALE-SHORT  Short scale (English/American system)
                 10^3 = thousand, 10^6 = million, 10^9 = billion, …
                 Suffix cycle: [on]  →  mill-on, bill-on, trill-on, …

    SCALE-LONG   Long scale (continental European system)
                 10^3 = thousand, 10^6 = million, 10^9 = milliard,
                 10^12 = billion, 10^15 = billiard, …
                 Suffix cycle: [on, ard]  →  mill-on, milliard, bill-on, …
                 Note: suffix text is language-specific; override Suffixes in the
                 derived configuration as needed (e.g. "on(s)"/"ard(s)" in French).

    SCALE-SHORT-CYRILLIC  Short scale with the Conway tables transliterated into
                 Cyrillic (NTS-25), inherited by RU, BG and UK.

    Prefix tables follow the strict Conway-Guy-Wechsler system (NTS-24):
    - the prefix value (Conway index) is split into groups of three digits, each
      named on its own and joined by groupSeparator ("-illi-"): 0 → voidGroup
      ("ni"), 1..9 → Scale0Prefixes, 10..999 → units + tens + hundreds
      (1000 millinillion, 1 000 003 millinillitrillion);
    - entries read "(start)stem[default|-illi=>form](end)": a component takes the
      first of its (end) consonants accepted by the next component's (start)
      markers (septe(mn) + (n)deci → septendeci), and [a|-illi=>i] turns the
      final vowel into i before the -illi- junction (30 trigintillion, but
      130 trigintacentillion);
    - Conway marks tre to take an s before an s- or x-marked component; the
      x-marked components therefore also carry s ((nxs)centi, (mxs)octoginta,
      (mxs)octingenti), and se(xs) lists x first so that it still yields sex.
-->
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="Utils/NumberConvertionConfiguration.xsd ./NumberConvertionConfiguration.xsd">
	<!-- ── Short scale ──────────────────────────────────────────────────────── -->
	<Language
		groupSize="3"
		separator=" "
		groupSeparator=","
		zero="zero"
		minus="minus *"
	>
		<Culture>SCALE-SHORT</Culture>
		<Groups>
			<Group level="1">
				<Digit digit="0" string=""  />
				<Digit digit="1" string="one" />
				<Digit digit="2" string="two" />
				<Digit digit="3" string="three" />
				<Digit digit="4" string="four" />
				<Digit digit="5" string="five" />
				<Digit digit="6" string="six"  />
				<Digit digit="7" string="seven" />
				<Digit digit="8" string="eight" />
				<Digit digit="9" string="nine" />
			</Group>
		</Groups>
		<NumberScale firstLetterUpperCase="false">
			<StaticNames>
				<Scale value="0" string=""/>
				<Scale value="1" string="thousand"/>
			</StaticNames>
			<Suffixes>
				<Suffix>on</Suffix>
			</Suffixes>
			<Scale0Prefixes>
				<Digit digit="0" string=""  />
				<Digit digit="1" string="mi" />
				<Digit digit="2" string="bi" />
				<Digit digit="3" string="tri" />
				<Digit digit="4" string="quadri" />
				<Digit digit="5" string="quinti" />
				<Digit digit="6" string="sexti"  />
				<Digit digit="7" string="septi" />
				<Digit digit="8" string="octi" />
				<Digit digit="9" string="noni" />
			</Scale0Prefixes>
			<UnitsPrefixes>
				<Digit digit="0" string="" />
				<Digit digit="1" string="un" />
				<Digit digit="2" string="duo" />
				<Digit digit="3" string="tre(s)" />
				<Digit digit="4" string="quattuor" />
				<Digit digit="5" string="quinqua" />
				<Digit digit="6" string="se(xs)" />
				<Digit digit="7" string="septe(mn)" />
				<Digit digit="8" string="octo" />
				<Digit digit="9" string="nove(mn)" />
			</UnitsPrefixes>
			<TensPrefixes>
				<Digit digit="0" string="" />
				<Digit digit="1" string="(n)deci" />
				<Digit digit="2" string="(ms)viginti" />
				<Digit digit="3" string="(ns)trigint[a|-illi=>i]" />
				<Digit digit="4" string="(ns)quadragint[a|-illi=>i]" />
				<Digit digit="5" string="(ns)quinquagint[a|-illi=>i]" />
				<Digit digit="6" string="(n)sexagint[a|-illi=>i]" />
				<Digit digit="7" string="(n)septuagint[a|-illi=>i]" />
				<Digit digit="8" string="(mxs)octogint[a|-illi=>i]" />
				<Digit digit="9" string="nonagint[a|-illi=>i]" />
			</TensPrefixes>
			<HundredsPrefixes>
				<Digit digit="0" string="" />
				<Digit digit="1" string="(nxs)centi" />
				<Digit digit="2" string="(n)ducenti" />
				<Digit digit="3" string="(ns)trecenti" />
				<Digit digit="4" string="(ns)quadringenti" />
				<Digit digit="5" string="(ns)quingenti" />
				<Digit digit="6" string="(n)sescenti" />
				<Digit digit="7" string="(n)septingenti" />
				<Digit digit="8" string="(mxs)octingenti" />
				<Digit digit="9" string="nongenti" />
			</HundredsPrefixes>
		</NumberScale>
	</Language>

	<!-- ── Long scale ───────────────────────────────────────────────────────── -->
	<Language
		groupSize="3"
		separator=" "
		groupSeparator=","
		zero="zero"
		minus="minus *"
	>
		<Culture>SCALE-LONG</Culture>
		<Groups>
			<Group level="1">
				<Digit digit="0" string=""  />
				<Digit digit="1" string="one" />
				<Digit digit="2" string="two" />
				<Digit digit="3" string="three" />
				<Digit digit="4" string="four" />
				<Digit digit="5" string="five" />
				<Digit digit="6" string="six"  />
				<Digit digit="7" string="seven" />
				<Digit digit="8" string="eight" />
				<Digit digit="9" string="nine" />
			</Group>
		</Groups>
		<NumberScale firstLetterUpperCase="false">
			<StaticNames>
				<Scale value="0" string=""/>
				<Scale value="1" string="thousand"/>
			</StaticNames>
			<Suffixes>
				<Suffix>on</Suffix>
				<Suffix>ard</Suffix>
			</Suffixes>
			<Scale0Prefixes>
				<Digit digit="0" string=""  />
				<Digit digit="1" string="mi" />
				<Digit digit="2" string="bi" />
				<Digit digit="3" string="tri" />
				<Digit digit="4" string="quadri" />
				<Digit digit="5" string="quinti" />
				<Digit digit="6" string="sexti"  />
				<Digit digit="7" string="septi" />
				<Digit digit="8" string="octi" />
				<Digit digit="9" string="noni" />
			</Scale0Prefixes>
			<UnitsPrefixes>
				<Digit digit="0" string="" />
				<Digit digit="1" string="un" />
				<Digit digit="2" string="duo" />
				<Digit digit="3" string="tre(s)" />
				<Digit digit="4" string="quattuor" />
				<Digit digit="5" string="quinqua" />
				<Digit digit="6" string="se(xs)" />
				<Digit digit="7" string="septe(mn)" />
				<Digit digit="8" string="octo" />
				<Digit digit="9" string="nove(mn)" />
			</UnitsPrefixes>
			<TensPrefixes>
				<Digit digit="0" string="" />
				<Digit digit="1" string="(n)deci" />
				<Digit digit="2" string="(ms)viginti" />
				<Digit digit="3" string="(ns)trigint[a|-illi=>i]" />
				<Digit digit="4" string="(ns)quadragint[a|-illi=>i]" />
				<Digit digit="5" string="(ns)quinquagint[a|-illi=>i]" />
				<Digit digit="6" string="(n)sexagint[a|-illi=>i]" />
				<Digit digit="7" string="(n)septuagint[a|-illi=>i]" />
				<Digit digit="8" string="(mxs)octogint[a|-illi=>i]" />
				<Digit digit="9" string="nonagint[a|-illi=>i]" />
			</TensPrefixes>
			<HundredsPrefixes>
				<Digit digit="0" string="" />
				<Digit digit="1" string="(nxs)centi" />
				<Digit digit="2" string="(n)ducenti" />
				<Digit digit="3" string="(ns)trecenti" />
				<Digit digit="4" string="(ns)quadringenti" />
				<Digit digit="5" string="(ns)quingenti" />
				<Digit digit="6" string="(n)sescenti" />
				<Digit digit="7" string="(n)septingenti" />
				<Digit digit="8" string="(mxs)octingenti" />
				<Digit digit="9" string="nongenti" />
			</HundredsPrefixes>
		</NumberScale>
	</Language>

	<!-- ── Short scale, Cyrillic Conway tables (NTS-25) ─────────────────────── -->
	<!--
	    Cyrillic transliteration of the SCALE-SHORT Conway-Guy-Wechsler tables, for the
	    languages that adopted the ми/би/три… family (RU, BG, UK). The algorithm is the
	    NTS-24 one unchanged; only the spelling of the components changes:
	    - Latin c/qu/x are written ц/кв/кс, the -illi- junction ending a → и;
	    - Conway's linking consonants keep their markers: n → н, m → м, s → с, and x → кс,
	      a two-letter consonant written as a comma-separated marker list
	      (се(кс,с) + (н,кс,с)центи → сексцентиллион, тре(с) + (н,кс,с)центи → тресцентиллион);
	    - the void group 000 is "ни" (миллиниллион).
	    The base spelling follows Russian usage (кваттуордециллион, дуцентиллион); derived
	    languages override a table only where their orthography differs (BG кватуор, UK і).
	    StaticNames, Suffixes and groupSeparator are placeholders: each language sets its own.
	-->
	<Language baseOn="SCALE-SHORT">
		<Culture>SCALE-SHORT-CYRILLIC</Culture>
		<NumberScale firstLetterUpperCase="false" voidGroup="ни" groupSeparator="лли">
			<StaticNames>
				<Scale value="0" string=""/>
				<Scale value="1" string="тысяча"/>
			</StaticNames>
			<Suffixes>
				<Suffix>он</Suffix>
			</Suffixes>
			<Scale0Prefixes>
				<Digit digit="0" string="" />
				<Digit digit="1" string="ми" />
				<Digit digit="2" string="би" />
				<Digit digit="3" string="три" />
				<Digit digit="4" string="квадри" />
				<Digit digit="5" string="квинти" />
				<Digit digit="6" string="сексти" />
				<Digit digit="7" string="септи" />
				<Digit digit="8" string="окти" />
				<Digit digit="9" string="нони" />
			</Scale0Prefixes>
			<UnitsPrefixes>
				<Digit digit="0" string="" />
				<Digit digit="1" string="ун" />
				<Digit digit="2" string="дуо" />
				<Digit digit="3" string="тре(с)" />
				<Digit digit="4" string="кваттуор" />
				<Digit digit="5" string="квинква" />
				<Digit digit="6" string="се(кс,с)" />
				<Digit digit="7" string="септе(мн)" />
				<Digit digit="8" string="окто" />
				<Digit digit="9" string="нове(мн)" />
			</UnitsPrefixes>
			<TensPrefixes>
				<Digit digit="0" string="" />
				<Digit digit="1" string="(н)деци" />
				<Digit digit="2" string="(мс)вигинти" />
				<Digit digit="3" string="(нс)тригинт[а|-illi=>и]" />
				<Digit digit="4" string="(нс)квадрагинт[а|-illi=>и]" />
				<Digit digit="5" string="(нс)квинквагинт[а|-illi=>и]" />
				<Digit digit="6" string="(н)сексагинт[а|-illi=>и]" />
				<Digit digit="7" string="(н)септуагинт[а|-illi=>и]" />
				<Digit digit="8" string="(м,кс,с)октогинт[а|-illi=>и]" />
				<Digit digit="9" string="нонагинт[а|-illi=>и]" />
			</TensPrefixes>
			<HundredsPrefixes>
				<Digit digit="0" string="" />
				<Digit digit="1" string="(н,кс,с)центи" />
				<Digit digit="2" string="(н)дуценти" />
				<Digit digit="3" string="(нс)треценти" />
				<Digit digit="4" string="(нс)квадрингенти" />
				<Digit digit="5" string="(нс)квингенти" />
				<Digit digit="6" string="(н)сесценти" />
				<Digit digit="7" string="(н)септингенти" />
				<Digit digit="8" string="(м,кс,с)октингенти" />
				<Digit digit="9" string="нонгенти" />
			</HundredsPrefixes>
		</NumberScale>
	</Language>
</Numbers>
