<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
	<!-- NTS-27: groups of four digits named 万, 億, 兆 (ja.wikipedia "漢数字": 4 桁ごとに区切り、各 4 桁の組に
	     「万」、「億」などの単位を付けて、上位から読む), written without spaces. 一 is not said before 百 and 十 and
	     is optional before 千 (kept as 千), but the multiplier one of 万/億/兆 is written (一万, 一億). -->
	<Language
        groupSize="4"
        separator=""
        groupSeparator=""
        zero="零"
        minus="マイナス *"
        decimalSeparator="点"
        decimalDigitByDigitMaxDigits="0"
        fractionSeparator="割る"
        maxNumber="9999999999999999"
    >
		<!-- NTS-34: no automatic decimal reading (D: no MEXT or institutional statement on the reading found; docs/NTS-34-decimal-reading-audit.md). LanguageDefault throws NotSupportedException for a decimal part; DecimalReadingMode.DigitByDigit, requested by the caller, is unchanged. -->
		<Culture>JA</Culture>
		<Groups>
			<Group level="1">
				<Digit digit="0" string="" />
				<Digit digit="1" string="一" />
				<Digit digit="2" string="二" />
				<Digit digit="3" string="三" />
				<Digit digit="4" string="四" />
				<Digit digit="5" string="五" />
				<Digit digit="6" string="六" />
				<Digit digit="7" string="七" />
				<Digit digit="8" string="八" />
				<Digit digit="9" string="九" />
			</Group>
			<Group level="2">
				<Digit digit="0" string="" buildString="*" />
				<Digit digit="1" string="十" buildString="十*" />
				<Digit digit="2" string="二十" buildString="二十*" />
				<Digit digit="3" string="三十" buildString="三十*" />
				<Digit digit="4" string="四十" buildString="四十*" />
				<Digit digit="5" string="五十" buildString="五十*" />
				<Digit digit="6" string="六十" buildString="六十*" />
				<Digit digit="7" string="七十" buildString="七十*" />
				<Digit digit="8" string="八十" buildString="八十*" />
				<Digit digit="9" string="九十" buildString="九十*" />
			</Group>
			<Group level="3">
				<Digit digit="0" string="" buildString="*" />
				<Digit digit="1" string="百" buildString="百*" />
				<Digit digit="2" string="二百" buildString="二百*" />
				<Digit digit="3" string="三百" buildString="三百*" />
				<Digit digit="4" string="四百" buildString="四百*" />
				<Digit digit="5" string="五百" buildString="五百*" />
				<Digit digit="6" string="六百" buildString="六百*" />
				<Digit digit="7" string="七百" buildString="七百*" />
				<Digit digit="8" string="八百" buildString="八百*" />
				<Digit digit="9" string="九百" buildString="九百*" />
			</Group>
			<Group level="4">
				<Digit digit="0" string="" buildString="*" />
				<Digit digit="1" string="千" buildString="千*" />
				<Digit digit="2" string="二千" buildString="二千*" />
				<Digit digit="3" string="三千" buildString="三千*" />
				<Digit digit="4" string="四千" buildString="四千*" />
				<Digit digit="5" string="五千" buildString="五千*" />
				<Digit digit="6" string="六千" buildString="六千*" />
				<Digit digit="7" string="七千" buildString="七千*" />
				<Digit digit="8" string="八千" buildString="八千*" />
				<Digit digit="9" string="九千" buildString="九千*" />
			</Group>
		</Groups>
		<NumberScale firstLetterUpperCase="false">
			<StaticNames>
				<Scale value="0" string="" />
				<Scale value="1" string="万" />
				<Scale value="2" string="億" />
				<Scale value="3" string="兆" />
			</StaticNames>
		</NumberScale>
		<Exceptions />
		<!-- NTS-08: ordinal domain guard; values outside the validated domain fail closed (see JapaneseOrdinalLanguageSpecifics). -->
		<LanguageSpecifics>JapaneseOrdinalLanguageSpecifics</LanguageSpecifics>
		<Ordinals prefix="第" />
		<!-- Neutral 12-hour clock without 午前/午後: "<hour>時", "<hour>時<minutes>分", "<hour>時半". -->
		<ClockTime step="5" hourCycle="12">
			<Rule range="0" hourOffset="0" hourForm="cardinal" pattern="{hour}時" />
			<Rule range="5,10,15,20,25,35,40,45,50,55" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="{hour}時{amount}分" />
			<Rule range="30" hourOffset="0" hourForm="cardinal" pattern="{hour}時半" />
		</ClockTime>
	</Language>
</Numbers>
