<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language baseOn="ID" zero="sifar">
        <Culture>MS</Culture>
        <Culture>MS-MY</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" /><Digit digit="1" string="satu" /><Digit digit="2" string="dua" /><Digit digit="3" string="tiga" /><Digit digit="4" string="empat" /><Digit digit="5" string="lima" /><Digit digit="6" string="enam" /><Digit digit="7" string="tujuh" /><Digit digit="8" string="lapan" /><Digit digit="9" string="sembilan" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" /><Digit digit="1" string="sepuluh" buildString="sepuluh *" /><Digit digit="2" string="dua puluh" buildString="dua puluh *" /><Digit digit="3" string="tiga puluh" buildString="tiga puluh *" /><Digit digit="4" string="empat puluh" buildString="empat puluh *" /><Digit digit="5" string="lima puluh" buildString="lima puluh *" /><Digit digit="6" string="enam puluh" buildString="enam puluh *" /><Digit digit="7" string="tujuh puluh" buildString="tujuh puluh *" /><Digit digit="8" string="lapan puluh" buildString="lapan puluh *" /><Digit digit="9" string="sembilan puluh" buildString="sembilan puluh *" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" /><Digit digit="1" string="seratus" buildString="seratus *" /><Digit digit="2" string="dua ratus" buildString="dua ratus *" /><Digit digit="3" string="tiga ratus" buildString="tiga ratus *" /><Digit digit="4" string="empat ratus" buildString="empat ratus *" /><Digit digit="5" string="lima ratus" buildString="lima ratus *" /><Digit digit="6" string="enam ratus" buildString="enam ratus *" /><Digit digit="7" string="tujuh ratus" buildString="tujuh ratus *" /><Digit digit="8" string="lapan ratus" buildString="lapan ratus *" /><Digit digit="9" string="sembilan ratus" buildString="sembilan ratus *" />
            </Group>
        </Groups>
        <NumberScale>
            <StaticNames>
                <Scale value="0" string="" />
                <Scale value="1" string="ribu" />
                <Scale value="2" string="juta" />
                <Scale value="3" string="bilion" />
                <Scale value="4" string="trilion" />
            </StaticNames>
            <Suffixes>
                <Suffix>lion</Suffix>
            </Suffixes>
        </NumberScale>
        <Exceptions>
            <Number value="11" string="sebelas" /><Number value="12" string="dua belas" /><Number value="13" string="tiga belas" /><Number value="14" string="empat belas" /><Number value="15" string="lima belas" /><Number value="16" string="enam belas" /><Number value="17" string="tujuh belas" /><Number value="18" string="lapan belas" /><Number value="19" string="sembilan belas" />
        </Exceptions>
        <LanguageSpecifics>MalayOrdinalLanguageSpecifics</LanguageSpecifics>
        <ClockTime step="5" hourCycle="12">
            <Rule range="0" hourOffset="0" hourForm="cardinal" pattern="pukul {hour}" />
            <Rule range="5,10,20,25" hourOffset="0" hourForm="cardinal" amountReference="0" amountDirection="after" pattern="pukul {hour} {amount} minit" />
            <Rule range="15" hourOffset="0" hourForm="cardinal" pattern="pukul {hour} suku" />
            <Rule range="30" hourOffset="0" hourForm="cardinal" pattern="pukul {hour} setengah" />
            <Rule range="35,40,50,55" hourOffset="1" hourForm="cardinal" amountReference="60" amountDirection="before" pattern="pukul {hour} kurang {amount} minit" />
            <Rule range="45" hourOffset="1" hourForm="cardinal" pattern="pukul {hour} kurang suku" />
        </ClockTime>
    </Language>
</Numbers>
