<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="không"
        minus="âm *"
        decimalSeparator="phẩy"
        fractionSeparator="trên"
        maxNumber="999999999999"
        internalZeroGroupString="không"
    >
        <Culture>VN</Culture>
        <Culture>VI</Culture>
        <Culture>VI-VN</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="một" />
                <Digit digit="2" string="hai" />
                <Digit digit="3" string="ba" />
                <Digit digit="4" string="bốn" />
                <Digit digit="5" string="năm" />
                <Digit digit="6" string="sáu" />
                <Digit digit="7" string="bảy" />
                <Digit digit="8" string="tám" />
                <Digit digit="9" string="chín" />
            </Group>
            <!-- NTS-27: "linh" joins a lone unit to the hundreds (một trăm linh năm), and to the zero hundreds
                 of a class that follows a higher class (hai nghìn không trăm linh năm): the zero tens take the
                 inner form "linh *" whenever a higher digit of the number is non-zero. -->
            <Group level="2">
                <Digit digit="0" string="" buildString="*" innerBuildString="linh *" />
                <Digit digit="1" string="mười" buildString="mười *" />
                <Digit digit="2" string="hai mươi" buildString="hai mươi *" />
                <Digit digit="3" string="ba mươi" buildString="ba mươi *" />
                <Digit digit="4" string="bốn mươi" buildString="bốn mươi *" />
                <Digit digit="5" string="năm mươi" buildString="năm mươi *" />
                <Digit digit="6" string="sáu mươi" buildString="sáu mươi *" />
                <Digit digit="7" string="bảy mươi" buildString="bảy mươi *" />
                <Digit digit="8" string="tám mươi" buildString="tám mươi *" />
                <Digit digit="9" string="chín mươi" buildString="chín mươi *" />
            </Group>
            <!-- NTS-27: a class (lớp) that follows a higher non-zero class is read with its zero hundreds,
                 "không trăm" (SGK Toán 4 solution keys: 400 070 192 "bốn trăm triệu không trăm bảy mươi nghìn
                 …", 178 320 005 "… nghìn không trăm linh năm"); the most significant class omits them. -->
            <Group level="3">
                <Digit digit="0" string="" buildString="*" innerBuildString="không trăm *" />
                <Digit digit="1" string="một trăm" buildString="một trăm *" />
                <Digit digit="2" string="hai trăm" buildString="hai trăm *" />
                <Digit digit="3" string="ba trăm" buildString="ba trăm *" />
                <Digit digit="4" string="bốn trăm" buildString="bốn trăm *" />
                <Digit digit="5" string="năm trăm" buildString="năm trăm *" />
                <Digit digit="6" string="sáu trăm" buildString="sáu trăm *" />
                <Digit digit="7" string="bảy trăm" buildString="bảy trăm *" />
                <Digit digit="8" string="tám trăm" buildString="tám trăm *" />
                <Digit digit="9" string="chín trăm" buildString="chín trăm *" />
            </Group>
        </Groups>
        <!-- NTS-30: a whole zero class between two non-zero classes is read "không" + class name (internalZeroGroupString):
             SGK Toán 4, Chân trời sáng tạo, Bài 25, model "307 000 262 Đọc số: Ba trăm linh bảy triệu không nghìn hai trăm
             sáu mươi hai", "Ba triệu không nghìn không trăm mười ba: 3 000 013"; the method reads class by class
             ("lần lượt từ lớp triệu, lớp nghìn, lớp đơn vị"). A trailing zero class is not read ("5 000 000 đọc là: Năm
             triệu"). Distinct from the zero hundreds "không trăm" and the zero tens "linh" of a non-zero class (Groups). -->
        <!-- Vietnamese number names are standardized only up to tỷ (10^9).
             Beyond tỷ there is no established native system; maxNumber caps conversion at 10^12-1.
             Note: "một triệu" / "một tỷ" are correct Vietnamese (no drop of "một" for these scales). -->
        <NumberScale firstLetterUpperCase="false">
            <StaticNames>
                <Scale value="0" string="" />
                <Scale value="1" string="nghìn" />
                <Scale value="2" string="triệu" />
                <Scale value="3" string="tỷ" />
            </StaticNames>
        </NumberScale>
        <Replacements>

            <!-- "mốt" replaces "một" after tens particle mươi (21, 31, …) — Anywhere: appears inside longer strings -->
            <Replacement oldValue="mươi một" newValue="mươi mốt" scope="Anywhere" />
            <!-- "lăm" replaces "năm" after tens particle mươi (25, 35, …) -->
            <Replacement oldValue="mươi năm" newValue="mươi lăm" scope="Anywhere" />
            <!-- "lăm" replaces "năm" after "mười" for 15 -->
            <Replacement oldValue="mười năm" newValue="mười lăm" scope="Anywhere" />
        </Replacements>
        <!-- NTS-27: 1000 is "một nghìn" (the former bare "nghìn" was wrong); "linh" is the inner form of
             the zero tens (see Groups), which replaces the former intraGroupConnector. -->
        <!-- NTS-08: ordinal domain guard; values outside the validated domain fail closed (see VietnameseOrdinalLanguageSpecifics). -->
        <LanguageSpecifics>VietnameseOrdinalLanguageSpecifics</LanguageSpecifics>
        <Ordinals prefix="thứ ">
            <!-- 1st is "thứ nhất", not "thứ một" -->
            <OrdinalException value="1" string="nhất" />
            <!-- The ordinal of four alone is the Sino-Vietnamese "tư" ("thứ tư"). -->
            <OrdinalException value="4" string="tư" />
        </Ordinals>
        <!-- Neutral 12-hour clock without day-part wording (no sáng/chiều/tối): "<hour> giờ",
             "<hour> giờ mười lăm", "<hour> giờ rưỡi", "<next hour> giờ kém mười lăm". -->
        <ClockTime step="15" hourCycle="12">
            <Rule range="0" hourOffset="0" hourForm="cardinal" pattern="{hour} giờ" />
            <Rule range="15" hourOffset="0" hourForm="cardinal" pattern="{hour} giờ mười lăm" />
            <Rule range="30" hourOffset="0" hourForm="cardinal" pattern="{hour} giờ rưỡi" />
            <Rule range="45" hourOffset="1" hourForm="cardinal" pattern="{hour} giờ kém mười lăm" />
        </ClockTime>
    </Language>
</Numbers>
