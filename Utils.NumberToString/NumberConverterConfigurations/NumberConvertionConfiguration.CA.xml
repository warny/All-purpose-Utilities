<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
        <Language
                groupSize="3"
                separator=" "
                groupSeparator=""
                zero="zero"
                minus="menys *"
                decimalSeparator="coma"
                fractionSeparator="partit per"

                maxNumber="999999999999"
        >
                <Culture>CA</Culture>
                <Culture>ca-ES</Culture>
                <Groups>
                        <Group level="1">
                                <Digit digit="0" string="" />
                                <Digit digit="1" string="un" />
                                <Digit digit="2" string="dos" />
                                <Digit digit="3" string="tres" />
                                <Digit digit="4" string="quatre" />
                                <Digit digit="5" string="cinc" />
                                <Digit digit="6" string="sis" />
                                <Digit digit="7" string="set" />
                                <Digit digit="8" string="vuit" />
                                <Digit digit="9" string="nou" />
                        </Group>
                        <Group level="2">
                                <Digit digit="0" string="" buildString="*" />
                                <Digit digit="1" string="deu" buildString="deu i *" />
                                <Digit digit="2" string="vint" buildString="vint-i-*" />
                                <Digit digit="3" string="trenta" buildString="trenta-*" />
                                <Digit digit="4" string="quaranta" buildString="quaranta-*" />
                                <Digit digit="5" string="cinquanta" buildString="cinquanta-*" />
                                <Digit digit="6" string="seixanta" buildString="seixanta-*" />
                                <Digit digit="7" string="setanta" buildString="setanta-*" />
                                <Digit digit="8" string="vuitanta" buildString="vuitanta-*" />
                                <Digit digit="9" string="noranta" buildString="noranta-*" />
                        </Group>
                        <Group level="3">
                                <Digit digit="0" string="" buildString="*" />
                                <Digit digit="1" string="cent" buildString="cent *" />
                                <Digit digit="2" string="dos-cents" buildString="dos-cents *" />
                                <Digit digit="3" string="tres-cents" buildString="tres-cents *" />
                                <Digit digit="4" string="quatre-cents" buildString="quatre-cents *" />
                                <Digit digit="5" string="cinc-cents" buildString="cinc-cents *" />
                                <Digit digit="6" string="sis-cents" buildString="sis-cents *" />
                                <Digit digit="7" string="set-cents" buildString="set-cents *" />
                                <Digit digit="8" string="vuit-cents" buildString="vuit-cents *" />
                                <Digit digit="9" string="nou-cents" buildString="nou-cents *" />
                        </Group>
                </Groups>
                <!-- NTS-53: milió is a noun whose plural is milions, the accent falling (IEC, Ortografia catalana
                     §4.4.2.2a: "dos milions cent mil"; DIEC2 "milió": "Dos milions d'habitants"), so the singular and
                     the plural alternate on the whole ending (mili(ó|ons)), not "milió" + "ns". 10^9 has no name of its
                     own in the numeral: it is "mil milions" (DIEC2 "miliard": "Mil milions"; IEC, Revista de Tecnologia
                     10, p. 4-9: "dos mil milions de dòlars"; UPC, "Com s'escriuen els nombres": "els milers de milions
                     s'escriuen [...] amb el mot milions"), so the multiplier of milió is a complete cardinal of up to six
                     digits and the scales are paired from the million (pairedScalesFrom 2), like ES and EU. The long
                     scale continues the same way: bilió = "milió de milions", trilió = "milió de bilions" (DIEC2), and
                     "mil bilions" (Ortografia catalana §4.4.3.4: "mil bilionèsim (de mil bilions)"). -->
                <NumberScale firstLetterUpperCase="false" pairedScalesFrom="2">
                        <StaticNames>
                                <Scale value="0" string="" />
                                <Scale value="1" string="mil" />
                                <Scale value="2" string="mili(ó|ons)" />
                        </StaticNames>
                        <Suffixes>
                                <Suffix>(ó|ons)</Suffix>
                        </Suffixes>
                        <!-- NTS-53 (NTS-55): milió is a masculine noun (DIEC2 "milió" m.) and governs its multiplier,
                             whatever the gender of the counted noun: "una dos-cents mil milionèsima (part) de segon"
                             (GEIEC §12.3.2), so dos-cents milions, dos-cents mil milions under gender=femení, while the
                             lower groups keep agreeing (dues-centes mil persones). Same mechanism as ES (NTS-30G). -->
                        <ScaleForm scale="2">
                                <Forms>
                                        <Form key="singular" value="milió" forceVariants="gender=masculí" />
                                        <Form key="plural" value="milions" forceVariants="gender=masculí" />
                                </Forms>
                        </ScaleForm>
                </NumberScale>
                <Replacements>
                        <Replacement oldValue="un mil" newValue="mil" onScale="1" onValue="1" />
                </Replacements>
		<Exceptions>
			<Number value="11" string="onze" />
			<Number value="12" string="dotze" />
			<Number value="13" string="tretze" />
			<Number value="14" string="catorze" />
			<Number value="15" string="quinze" />
			<Number value="16" string="setze" />
			<Number value="17" string="disset" />
			<Number value="18" string="divuit" />
			<Number value="19" string="dinou" />
		</Exceptions>
		<!--
		  Catalan ordinals: 1-4 are irregular; 5-19 have specific stem changes;
		  20+ take suffix "-è" (masc) / "-ena" (fem) with trailing "a" removed.
		  Compound numbers use hyphens as word boundaries, so the ordinal suffix
		  applies to the last hyphenated component automatically.
		  The feminine variant supplies the feminized unit forms (cinc→cinquena…)
		  and handles "dues" (from cardinal "dos→dues") correctly.
		-->
		<!-- NTS-14: no normative source (IEC, Optimot, TERMCAT) attests an ordinal of zero; the suffix would form "zeroè"/"zeroena", so zero fails closed (inherited by CA-valencia). -->
		<LanguageSpecifics>ZeroOrdinalUnsupportedLanguageSpecifics</LanguageSpecifics>
		<Ordinals suffix="è" removeTrailing="a">
			<!-- Irregular masculine 1-4 -->
			<OrdinalException value="1"  string="primer" />
			<OrdinalException value="2"  string="segon" />
			<OrdinalException value="3"  string="tercer" />
			<OrdinalException value="4"  string="quart" />
			<!-- Word rules 5-19 (cardinal form → masculine ordinal) -->
			<Ordinal from="cinc"    to="cinquè" />
			<Ordinal from="sis"     to="sisè" />
			<Ordinal from="set"     to="setè" />
			<Ordinal from="vuit"    to="vuitè" />
			<Ordinal from="nou"     to="novè" />
			<Ordinal from="deu"     to="desè" />
			<Ordinal from="onze"    to="onzè" />
			<Ordinal from="dotze"   to="dotzè" />
			<Ordinal from="tretze"  to="tretzè" />
			<Ordinal from="catorze" to="catorzè" />
			<Ordinal from="quinze"  to="quinzè" />
			<Ordinal from="setze"   to="setzè" />
			<Ordinal from="disset"  to="dissetè" />
			<Ordinal from="divuit"  to="divuitè" />
			<Ordinal from="dinou"   to="dinovè" />
			<!-- NTS-53: the IEC attests two ordinal series for milió, "milionè - milionena" and "milionèsim -
			     milionèsima" (GBU §18.5, quadre 18.6, row 1.000.000), and prefers the first: "En general, són
			     preferibles els ordinals en -er/-er(a) i en -è/-en(a) [...], mentre que els ordinals en -èsim/-èsim(a)
			     són d'ús poc freqüent" (GIEC §17.2.5). The -è series is kept, consistent with milè, centè (project
			     decision). Its multiples follow the cardinal (GIEC §17.2.5: "deu mil·lèsim, cent milionèsim, mil
			     bilionèsim"): milionè, dos milionè, mil milionè, dos mil cinc-cents milionè; like milè for mil, the
			     single million drops its "un". The multiplier stays masculine (ScaleForm above). -->
			<OrdinalException value="1000000" string="milionè" />
			<Ordinal from="milions" to="milionè" />

			<!-- Feminine variant -->
			<OrdinalVariants>
				<Variant type="gender" variant="femení" suffix="ena" removeTrailing="a">
					<OrdinalException value="1"  string="primera" />
					<OrdinalException value="2"  string="segona" />
					<OrdinalException value="3"  string="tercera" />
					<OrdinalException value="4"  string="quarta" />
					<!-- Word rules for 5-19 (cardinal form → feminine ordinal) -->
					<Ordinal from="cinc"    to="cinquena" />
					<Ordinal from="sis"     to="sisena" />
					<Ordinal from="set"     to="setena" />
					<Ordinal from="vuit"    to="vuitena" />
					<Ordinal from="nou"     to="novena" />
					<Ordinal from="deu"     to="desena" />
					<Ordinal from="onze"    to="onzena" />
					<Ordinal from="dotze"   to="dotzena" />
					<Ordinal from="tretze"  to="tretzena" />
					<Ordinal from="catorze" to="catorzena" />
					<Ordinal from="quinze"  to="quinzena" />
					<Ordinal from="setze"   to="setzena" />
					<Ordinal from="disset"  to="dissetena" />
					<Ordinal from="divuit"  to="divuitena" />
					<Ordinal from="dinou"   to="dinovena" />
					<!-- "dos→dues" via cardinal femení: map the feminized form to the feminine ordinal -->
					<Ordinal from="dues"    to="dosena" />
					<!-- NTS-53: milionena (GBU §18.5, quadre 18.6). -->
					<OrdinalException value="1000000" string="milionena" />
					<Ordinal from="milions" to="milionena" />
				</Variant>
			</OrdinalVariants>
		</Ordinals>
		<Variants>
			<!--
			  In Catalan, digits 1 (un/una) and 2 (dos/dues) vary in gender,
			  as does two-hundred (dos-cents/dues-centes). All other hundreds
			  are invariable. Tens compounds use hyphens (vint-i-un, trenta-un…):
			  the hyphen is a word boundary for LastWord, so the rule applies
			  correctly to compound numbers.
			-->
			<Dimension name="gender" localName="gènere" values="masculí,femení" />

			<Variant type="gender" variant="femení">
				<!-- Gender-variable units (works on compounds because hyphens are word boundaries) -->
				<Replacement oldValue="un"  newValue="una"  scope="LastWord" />
				<Replacement oldValue="dos" newValue="dues" scope="LastWord" />
				<!-- Only the 200-hundred has a feminine form in Catalan -->
				<Replacement oldValue="dos-cents" newValue="dues-centes" scope="Anywhere" />
			</Variant>
		</Variants>
		<!-- NTS-52: milió and the higher scales are nouns introducing the counted noun with "de" (UOC, Servei
			 Lingüístic, "Escriptura dels numerals": "Tenien un pressupost de dos milions d'euros [però: Tenien un
			 pressupost d'1.265.250 euros]"). The preposition is elided before a vowel or a mute h, but not before a
			 consonantal i or u (UOC, "L'apòstrof": "de s'apostrofa davant de totes les vocals (també precedides de h
			 muda): d'herba, d'altres, d'asimetries, d'universitat"; "no s'apostrofa [...] davant de i i u consonants: de
			 iens, de iod"; consonantal onsets also in "el iogurt, el uombat", "la hiena"; UB, Llibre d'estil: "el iode;
			 el hiat; el iogurt; el uadi; el ioga"). Catalan h is mute in native words, so it is listed. The consonantal
			 onsets are declared before the elision: both have two constraints, and at equal specificity the first
			 declared wins (de iens, de hienes). So: un milió de pessetes, dos milions d'euros, but un milió dos-cents mil
			 euros, un milió un euros. -->
		<Currency>
			<NounConnector default="">
				<Substitution terminalScales="2.." value="de" />
				<Substitution terminalScales="2.." beforeNoun="ia,ie,io,iu,ua,ue,uo,hia,hie,hio,hiu,hua,hue,huo" value="de" />
				<Substitution terminalScales="2.." beforeNoun="a,à,e,è,é,i,í,ï,o,ò,ó,u,ú,ü,h"
				              value="d'" nounSeparator="" />
			</NounConnector>
		</Currency>
		<ClockTime step="15" hourCycle="12">
			<Rule range="0" displayHourRange="1" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femení" pattern="la {hour} en punt" />
			<Rule range="0" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femení" pattern="les {hour} en punt" />
			<Rule range="15" displayHourRange="1" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femení" pattern="un quart d&apos;{hour}" />
			<Rule range="15" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femení" pattern="un quart de {hour}" />
			<Rule range="30" displayHourRange="1" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femení" pattern="dos quarts d&apos;{hour}" />
			<Rule range="30" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femení" pattern="dos quarts de {hour}" />
			<Rule range="45" displayHourRange="1" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femení" pattern="tres quarts d&apos;{hour}" />
			<Rule range="45" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femení" pattern="tres quarts de {hour}" />
		</ClockTime>
		<TimeUnits>
			<!-- "hora" is feminine; forceVariants applies the existing gender=femení
			     cardinal rules ("un"->"una", "dos"->"dues") to the hour numeral without
			     requiring the caller to pass a variant. "minut"/"segon" are masculine,
			     matching the Catalan default, so they force nothing. -->
			<Unit name="hour"   singular="hora"  plural="hores"  forceVariants="gender=femení" />
			<Unit name="minute" singular="minut" plural="minuts" />
			<Unit name="second" singular="segon" plural="segons" />
		</TimeUnits>
	</Language>
</Numbers>
