<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        baseOn="SCALE-SHORT"
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="sıfır"
        minus="eksi *"
        decimalSeparator="virgül"
        fractionSeparator="bölü"
    >
        <Culture>TR</Culture>
        <Culture>TR-TR</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="bir" />
                <Digit digit="2" string="iki" />
                <Digit digit="3" string="üç" />
                <Digit digit="4" string="dört" />
                <Digit digit="5" string="beş" />
                <Digit digit="6" string="altı" />
                <Digit digit="7" string="yedi" />
                <Digit digit="8" string="sekiz" />
                <Digit digit="9" string="dokuz" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="on" buildString="on *" />
                <Digit digit="2" string="yirmi" buildString="yirmi *" />
                <Digit digit="3" string="otuz" buildString="otuz *" />
                <Digit digit="4" string="kırk" buildString="kırk *" />
                <Digit digit="5" string="elli" buildString="elli *" />
                <Digit digit="6" string="altmış" buildString="altmış *" />
                <Digit digit="7" string="yetmiş" buildString="yetmiş *" />
                <Digit digit="8" string="seksen" buildString="seksen *" />
                <Digit digit="9" string="doksan" buildString="doksan *" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <!-- Turkish: "yüz" alone for 100; "bir yüz" is ungrammatical -->
                <Digit digit="1" string="yüz" buildString="yüz *" />
                <Digit digit="2" string="iki yüz" buildString="iki yüz *" />
                <Digit digit="3" string="üç yüz" buildString="üç yüz *" />
                <Digit digit="4" string="dört yüz" buildString="dört yüz *" />
                <Digit digit="5" string="beş yüz" buildString="beş yüz *" />
                <Digit digit="6" string="altı yüz" buildString="altı yüz *" />
                <Digit digit="7" string="yedi yüz" buildString="yedi yüz *" />
                <Digit digit="8" string="sekiz yüz" buildString="sekiz yüz *" />
                <Digit digit="9" string="dokuz yüz" buildString="dokuz yüz *" />
            </Group>
        </Groups>
        <!-- Turkish hybrid scale: milyon (10^6) and milyar (10^9) are borrowed from French
             and treated as static names. From 10^12, Turkish uses suffix "lyon" with Turkish
             prefix names: tri+lyon=trilyon, katri+lyon=katrilyon, kenti+lyon=kentilyon…
             startIndex=2 shifts the first generated prefix to index 3 ("tri") for scale 4 (10^12). -->
        <NumberScale firstLetterUpperCase="false" groupSeparator="" startIndex="2">
            <StaticNames>
                <Scale value="0" string="" />
                <!-- Turkish: "bin" alone for 1000; "bir bin" is ungrammatical -->
                <Scale value="1" string="bin" />
                <Scale value="2" string="milyon" />
                <Scale value="3" string="milyar" />
            </StaticNames>
            <Suffixes>
                <Suffix>lyon</Suffix>
            </Suffixes>
            <Scale0Prefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="mi" />
                <Digit digit="2" string="bi" />
                <Digit digit="3" string="tri" />
                <Digit digit="4" string="katri" />
                <Digit digit="5" string="kenti" />
                <Digit digit="6" string="seksi" />
                <Digit digit="7" string="septi" />
                <Digit digit="8" string="okti" />
                <Digit digit="9" string="noni" />
            </Scale0Prefixes>
        </NumberScale>
        <Replacements>
            <!-- Safety net: drop "bir" before "bin" if the engine generates "bir bin" -->
            <Replacement oldValue="bir bin" newValue="bin" onScale="1" onValue="1" />
        </Replacements>
        <!-- Case of the numeral: only the last word inflects ("on ikiye"). Used by the clock
             ("saat yediyi çeyrek geçiyor", "saat sekize çeyrek var"). -->
        <Variants>
            <Dimension name="case" localName="hal" values="nominative,accusative,dative" />
            <Variant type="case" variant="accusative">
                <Replacement oldValue="bir" newValue="biri" scope="LastWord" />
                <Replacement oldValue="iki" newValue="ikiyi" scope="LastWord" />
                <Replacement oldValue="üç" newValue="üçü" scope="LastWord" />
                <Replacement oldValue="dört" newValue="dördü" scope="LastWord" />
                <Replacement oldValue="beş" newValue="beşi" scope="LastWord" />
                <Replacement oldValue="altı" newValue="altıyı" scope="LastWord" />
                <Replacement oldValue="yedi" newValue="yediyi" scope="LastWord" />
                <Replacement oldValue="sekiz" newValue="sekizi" scope="LastWord" />
                <Replacement oldValue="dokuz" newValue="dokuzu" scope="LastWord" />
                <Replacement oldValue="on" newValue="onu" scope="LastWord" />
                <Replacement oldValue="yirmi" newValue="yirmiyi" scope="LastWord" />
                <Replacement oldValue="otuz" newValue="otuzu" scope="LastWord" />
                <Replacement oldValue="kırk" newValue="kırkı" scope="LastWord" />
                <Replacement oldValue="elli" newValue="elliyi" scope="LastWord" />
                <Replacement oldValue="altmış" newValue="altmışı" scope="LastWord" />
                <Replacement oldValue="yetmiş" newValue="yetmişi" scope="LastWord" />
                <Replacement oldValue="seksen" newValue="sekseni" scope="LastWord" />
                <Replacement oldValue="doksan" newValue="doksanı" scope="LastWord" />
                <Replacement oldValue="yüz" newValue="yüzü" scope="LastWord" />
                <Replacement oldValue="bin" newValue="bini" scope="LastWord" />
                <Replacement oldValue="milyon" newValue="milyonu" scope="LastWord" />
                <Replacement oldValue="milyar" newValue="milyarı" scope="LastWord" />
                <Replacement oldValue="trilyon" newValue="trilyonu" scope="LastWord" />
                <Replacement oldValue="katrilyon" newValue="katrilyonu" scope="LastWord" />
                <Replacement oldValue="kentilyon" newValue="kentilyonu" scope="LastWord" />
            </Variant>
            <Variant type="case" variant="dative">
                <Replacement oldValue="bir" newValue="bire" scope="LastWord" />
                <Replacement oldValue="iki" newValue="ikiye" scope="LastWord" />
                <Replacement oldValue="üç" newValue="üçe" scope="LastWord" />
                <Replacement oldValue="dört" newValue="dörde" scope="LastWord" />
                <Replacement oldValue="beş" newValue="beşe" scope="LastWord" />
                <Replacement oldValue="altı" newValue="altıya" scope="LastWord" />
                <Replacement oldValue="yedi" newValue="yediye" scope="LastWord" />
                <Replacement oldValue="sekiz" newValue="sekize" scope="LastWord" />
                <Replacement oldValue="dokuz" newValue="dokuza" scope="LastWord" />
                <Replacement oldValue="on" newValue="ona" scope="LastWord" />
                <Replacement oldValue="yirmi" newValue="yirmiye" scope="LastWord" />
                <Replacement oldValue="otuz" newValue="otuza" scope="LastWord" />
                <Replacement oldValue="kırk" newValue="kırka" scope="LastWord" />
                <Replacement oldValue="elli" newValue="elliye" scope="LastWord" />
                <Replacement oldValue="altmış" newValue="altmışa" scope="LastWord" />
                <Replacement oldValue="yetmiş" newValue="yetmişe" scope="LastWord" />
                <Replacement oldValue="seksen" newValue="seksene" scope="LastWord" />
                <Replacement oldValue="doksan" newValue="doksana" scope="LastWord" />
                <Replacement oldValue="yüz" newValue="yüze" scope="LastWord" />
                <Replacement oldValue="bin" newValue="bine" scope="LastWord" />
                <Replacement oldValue="milyon" newValue="milyona" scope="LastWord" />
                <Replacement oldValue="milyar" newValue="milyara" scope="LastWord" />
                <Replacement oldValue="trilyon" newValue="trilyona" scope="LastWord" />
                <Replacement oldValue="katrilyon" newValue="katrilyona" scope="LastWord" />
                <Replacement oldValue="kentilyon" newValue="kentilyona" scope="LastWord" />
            </Variant>
        </Variants>
        <!-- The ordinal suffix -(I)ncI follows vowel harmony and attaches to the last word only
             ("yirmi birinci"); every word that can end a cardinal is listed ("dört" voices to
             "dördüncü"). -->
        <Ordinals>
            <Ordinal from="bir" to="birinci" />
            <Ordinal from="iki" to="ikinci" />
            <Ordinal from="üç" to="üçüncü" />
            <Ordinal from="dört" to="dördüncü" />
            <Ordinal from="beş" to="beşinci" />
            <Ordinal from="altı" to="altıncı" />
            <Ordinal from="yedi" to="yedinci" />
            <Ordinal from="sekiz" to="sekizinci" />
            <Ordinal from="dokuz" to="dokuzuncu" />
            <Ordinal from="on" to="onuncu" />
            <Ordinal from="yirmi" to="yirminci" />
            <Ordinal from="otuz" to="otuzuncu" />
            <Ordinal from="kırk" to="kırkıncı" />
            <Ordinal from="elli" to="ellinci" />
            <Ordinal from="altmış" to="altmışıncı" />
            <Ordinal from="yetmiş" to="yetmişinci" />
            <Ordinal from="seksen" to="sekseninci" />
            <Ordinal from="doksan" to="doksanıncı" />
            <Ordinal from="yüz" to="yüzüncü" />
            <Ordinal from="bin" to="bininci" />
            <Ordinal from="milyon" to="milyonuncu" />
            <Ordinal from="milyar" to="milyarıncı" />
            <Ordinal from="trilyon" to="trilyonuncu" />
            <Ordinal from="katrilyon" to="katrilyonuncu" />
            <Ordinal from="kentilyon" to="kentilyonuncu" />
        </Ordinals>
        <!-- TDK usage. Quarter-hour 12-hour clock without day-part wording: accusative before
             "çeyrek geçiyor", nominative before "buçuk", dative of the following hour before
             "çeyrek var". -->
        <ClockTime step="15" hourCycle="12">
            <Rule range="0" hourOffset="0" hourForm="cardinal" pattern="saat {hour}" />
            <Rule range="15" hourOffset="0" hourForm="cardinal" hourForceVariants="case=accusative" pattern="saat {hour} çeyrek geçiyor" />
            <Rule range="30" hourOffset="0" hourForm="cardinal" pattern="saat {hour} buçuk" />
            <Rule range="45" hourOffset="1" hourForm="cardinal" hourForceVariants="case=dative" pattern="saat {hour} çeyrek var" />
        </ClockTime>
    </Language>
</Numbers>
