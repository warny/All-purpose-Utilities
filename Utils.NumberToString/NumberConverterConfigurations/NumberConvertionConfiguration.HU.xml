<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        baseOn="SCALE-LONG"
        groupSize="3"
        separator=""
        groupSeparator=""
        zero="nulla"
        minus="mínusz *"
        decimalSeparator="egész"
        fractionSeparator="per"
    >
        <Culture>HU</Culture>
        <Culture>HU-HU</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="egy" />
                <!-- "két" is the combining form; standalone 2 = "kettő" via Exception -->
                <Digit digit="2" string="két" />
                <Digit digit="3" string="három" />
                <Digit digit="4" string="négy" />
                <Digit digit="5" string="öt" />
                <Digit digit="6" string="hat" />
                <Digit digit="7" string="hét" />
                <Digit digit="8" string="nyolc" />
                <Digit digit="9" string="kilenc" />
            </Group>
            <Group level="2">
                <Digit digit="0" string=""          buildString="*" />
                <!-- tíz standalone, tizen* for 11–19 -->
                <Digit digit="1" string="tíz"       buildString="tizen*" />
                <!-- húsz standalone, huszon* for 21–29 -->
                <Digit digit="2" string="húsz"      buildString="huszon*" />
                <Digit digit="3" string="harminc"   buildString="harminc*" />
                <Digit digit="4" string="negyven"   buildString="negyven*" />
                <Digit digit="5" string="ötven"     buildString="ötven*" />
                <Digit digit="6" string="hatvan"    buildString="hatvan*" />
                <Digit digit="7" string="hetven"    buildString="hetven*" />
                <Digit digit="8" string="nyolcvan"  buildString="nyolcvan*" />
                <Digit digit="9" string="kilencven" buildString="kilencven*" />
            </Group>
            <Group level="3">
                <Digit digit="0" string=""            buildString="*" />
                <!-- 100 = "száz", "egyszáz" → "száz" via Replacement -->
                <Digit digit="1" string="száz"        buildString="száz*" />
                <Digit digit="2" string="kétszáz"     buildString="kétszáz*" />
                <Digit digit="3" string="háromszáz"   buildString="háromszáz*" />
                <Digit digit="4" string="négyszáz"    buildString="négyszáz*" />
                <Digit digit="5" string="ötszáz"      buildString="ötszáz*" />
                <Digit digit="6" string="hatszáz"     buildString="hatszáz*" />
                <Digit digit="7" string="hétszáz"     buildString="hétszáz*" />
                <Digit digit="8" string="nyolcszáz"   buildString="nyolcszáz*" />
                <Digit digit="9" string="kilencszáz"  buildString="kilencszáz*" />
            </Group>
        </Groups>
        <!-- Hungarian long scale: millió / milliárd / billió / billiárd …
             groupSeparator="ll": mi+ll+ió=millió, mi+ll+iárd=milliárd
             startIndex="2": scale 4 → prefix index 2+1=3 (bi) → billió ✓ -->
        <NumberScale firstLetterUpperCase="false" groupSeparator="ll" startIndex="2">
            <StaticNames>
                <Scale value="0" string="" />
                <Scale value="1" string="ezer" />
                <Scale value="2" string="millió" />
                <Scale value="3" string="milliárd" />
            </StaticNames>
            <Suffixes>
                <Suffix>ió</Suffix>
                <Suffix>iárd</Suffix>
            </Suffixes>
        </NumberScale>
        <Replacements>
            <!-- Drop "egy" before scale names: "egyezer" → "ezer", "egyszáz" → "száz" -->
            <Replacement oldValue="egyezer" newValue="ezer" scope="Anywhere" onScale="1" onValue="1" />
            <Replacement oldValue="egyszáz" newValue="száz" scope="Anywhere" />
            <Replacement oldValue="egymillió" newValue="millió" scope="Anywhere" onScale="2" onValue="1" />
            <Replacement oldValue="egymilliárd" newValue="milliárd" scope="Anywhere" onScale="3" onValue="1" />
            <!-- Same for generated long-scale names (billió, billiárd, …) -->
            <Replacement oldValue="egybillió" newValue="billió" scope="Anywhere" onScale="4" onValue="1" />
            <Replacement oldValue="egybilliárd" newValue="billiárd" scope="Anywhere" onScale="5" onValue="1" />
            <!-- Exception[2]="kettő" fires in ConvertGroup when chunk=2; replace back to "két" before scale names -->
            <Replacement oldValue="kettőezer" newValue="kétezer" scope="Anywhere" onScale="1" onValue="2" />
            <Replacement oldValue="kettőmillió" newValue="kétmillió" scope="Anywhere" onScale="2" onValue="2" />
            <Replacement oldValue="kettőmilliárd" newValue="kétmilliárd" scope="Anywhere" onScale="3" onValue="2" />
            <Replacement oldValue="kettőbillió" newValue="kétbillió" scope="Anywhere" onScale="4" onValue="2" />
            <Replacement oldValue="kettőbilliárd" newValue="kétbilliárd" scope="Anywhere" onScale="5" onValue="2" />
        </Replacements>
        <Exceptions>
            <!-- Standalone 2 = "kettő" (compound uses "két" from Groups) -->
            <Number value="2" string="kettő" />
        </Exceptions>
        <!-- Productive written ordinals (első, tizenegyedik, huszonkettedik, kétezer-egyedik):
             see HungarianOrdinalLanguageSpecifics. The former suffix="." fallback produced
             digit-style abbreviations ("tizenegy.") rather than ordinal words. -->
        <LanguageSpecifics>HungarianOrdinalLanguageSpecifics</LanguageSpecifics>
        <!-- Quarter-hour 12-hour clock without day-part wording. Quarters refer to the following
             hour ("negyed kettő", "fél kettő", "háromnegyed kettő"); the whole hour uses the
             attributive numeral before "óra" ("két óra", "tizenkét óra"). The hour twelve is
             spelled out literally because the configured cardinal of 12 is the attributive
             "tizenkét", whereas the quarters need the standalone "tizenkettő". -->
        <ClockTime step="15" hourCycle="12">
            <Rule range="0" displayHourRange="1,3-11" hourOffset="0" hourForm="cardinal" pattern="{hour} óra" />
            <Rule range="0" displayHourRange="2" hourOffset="0" hourForm="cardinal" pattern="két óra" />
            <Rule range="0" displayHourRange="12" hourOffset="0" hourForm="cardinal" pattern="tizenkét óra" />
            <Rule range="15" displayHourRange="1-11" hourOffset="1" hourForm="cardinal" pattern="negyed {hour}" />
            <Rule range="15" displayHourRange="12" hourOffset="1" hourForm="cardinal" pattern="negyed tizenkettő" />
            <Rule range="30" displayHourRange="1-11" hourOffset="1" hourForm="cardinal" pattern="fél {hour}" />
            <Rule range="30" displayHourRange="12" hourOffset="1" hourForm="cardinal" pattern="fél tizenkettő" />
            <Rule range="45" displayHourRange="1-11" hourOffset="1" hourForm="cardinal" pattern="háromnegyed {hour}" />
            <Rule range="45" displayHourRange="12" hourOffset="1" hourForm="cardinal" pattern="háromnegyed tizenkettő" />
        </ClockTime>
    </Language>
</Numbers>
