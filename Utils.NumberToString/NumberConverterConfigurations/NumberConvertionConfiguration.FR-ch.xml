<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language baseOn="FR">
        <Culture>FR-ch</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="et un" />
                <Digit digit="2" string="deux" />
                <Digit digit="3" string="trois" />
                <Digit digit="4" string="quatre" />
                <Digit digit="5" string="cinq" />
                <Digit digit="6" string="six" />
                <Digit digit="7" string="sept" />
                <Digit digit="8" string="huit" />
                <Digit digit="9" string="neuf" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="dix" buildString="dix *" />
                <Digit digit="2" string="vingt" buildString="vingt *" />
                <Digit digit="3" string="trente" buildString="trente *" />
                <Digit digit="4" string="quarante" buildString="quarante *" />
                <Digit digit="5" string="cinquante" buildString="cinquante *" />
                <Digit digit="6" string="soixante" buildString="soixante *" />
                <Digit digit="7" string="septante" buildString="septante *" />
                <Digit digit="8" string="huitante" buildString="huitante *" />
                <Digit digit="9" string="nonante" buildString="nonante *" />
            </Group>
            <!-- NTS-33: the Groups replace the inherited ones, so the ordinal bases of the hundreds are redeclared
                 (deux cents → deux centième); OrdinalScale is inherited from FR. -->
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="cent" buildString="cent *" />
                <Digit digit="2" string="deux cents" buildString="deux cent *" ordinalBaseString="deux cent" />
                <Digit digit="3" string="trois cents" buildString="trois cent *" ordinalBaseString="trois cent" />
                <Digit digit="4" string="quatre cents" buildString="quatre cent *" ordinalBaseString="quatre cent" />
                <Digit digit="5" string="cinq cents" buildString="cinq cent *" ordinalBaseString="cinq cent" />
                <Digit digit="6" string="six cents" buildString="six cent *" ordinalBaseString="six cent" />
                <Digit digit="7" string="sept cents" buildString="sept cent *" ordinalBaseString="sept cent" />
                <Digit digit="8" string="huit cents" buildString="huit cent *" ordinalBaseString="huit cent" />
                <Digit digit="9" string="neuf cents" buildString="neuf cent *" ordinalBaseString="neuf cent" />
            </Group>
        </Groups>
        <!-- NTS-48: the multiplier of mille. vingt and cent take an s when they are multiplied and end the number
             (quatre-vingts, deux cents) or precede the nouns million and milliard (deux cents millions), and stay
             invariable before another numeral, mille included (OQLF, "Pluriel de vingt, de cent et de mille": trois cent
             mille): this table renders the multiplier of scale 1 only. -->
        <Groups onScale="1">
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="et un" />
                <Digit digit="2" string="deux" />
                <Digit digit="3" string="trois" />
                <Digit digit="4" string="quatre" />
                <Digit digit="5" string="cinq" />
                <Digit digit="6" string="six" />
                <Digit digit="7" string="sept" />
                <Digit digit="8" string="huit" />
                <Digit digit="9" string="neuf" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="dix" buildString="dix *" />
                <Digit digit="2" string="vingt" buildString="vingt *" />
                <Digit digit="3" string="trente" buildString="trente *" />
                <Digit digit="4" string="quarante" buildString="quarante *" />
                <Digit digit="5" string="cinquante" buildString="cinquante *" />
                <Digit digit="6" string="soixante" buildString="soixante *" />
                <Digit digit="7" string="septante" buildString="septante *" />
                <Digit digit="8" string="huitante" buildString="huitante *" />
                <Digit digit="9" string="nonante" buildString="nonante *" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="cent" buildString="cent *" />
                <Digit digit="2" string="deux cent" buildString="deux cent *" />
                <Digit digit="3" string="trois cent" buildString="trois cent *" />
                <Digit digit="4" string="quatre cent" buildString="quatre cent *" />
                <Digit digit="5" string="cinq cent" buildString="cinq cent *" />
                <Digit digit="6" string="six cent" buildString="six cent *" />
                <Digit digit="7" string="sept cent" buildString="sept cent *" />
                <Digit digit="8" string="huit cent" buildString="huit cent *" />
                <Digit digit="9" string="neuf cent" buildString="neuf cent *" />
            </Group>
        </Groups>
        <Exceptions>
            <Number value="1" string="un" />
            <Number value="11" string="onze" />
            <Number value="12" string="douze" />
            <Number value="13" string="treize" />
            <Number value="14" string="quatorze" />
            <Number value="15" string="quinze" />
            <Number value="16" string="seize" />
        </Exceptions>
    </Language>
</Numbers>
