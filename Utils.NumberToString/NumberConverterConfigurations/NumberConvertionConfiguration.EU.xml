<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
        <Language
                groupSize="3"
                separator=" "
                groupSeparator=""
                zero="zero"
                minus="ken *"
                decimalSeparator="koma"
                fractionSeparator="zati"

                maxNumber="999999999999"
        >
                <Culture>EU</Culture>
                <Culture>eu-ES</Culture>
                <Groups>
                        <Group level="1">
                                <Digit digit="0" string="" />
                                <Digit digit="1" string="bat" />
                                <Digit digit="2" string="bi" />
                                <Digit digit="3" string="hiru" />
                                <Digit digit="4" string="lau" />
                                <Digit digit="5" string="bost" />
                                <Digit digit="6" string="sei" />
                                <Digit digit="7" string="zazpi" />
                                <Digit digit="8" string="zortzi" />
                                <Digit digit="9" string="bederatzi" />
                        </Group>
                        <Group level="2">
                                <Digit digit="0" string="" buildString="*" />
                                <Digit digit="1" string="hamar" buildString="hamar eta *" />
                                <Digit digit="2" string="hogei" buildString="hogei eta *" />
                                <Digit digit="3" string="hogeita hamar" buildString="hogeita hamar eta *" />
                                <Digit digit="4" string="berrogei" buildString="berrogeita *" />
                                <Digit digit="5" string="berrogeita hamar" buildString="berrogeita hamar eta *" />
                                <Digit digit="6" string="hirurogei" buildString="hirurogeita *" />
                                <Digit digit="7" string="hirurogeita hamar" buildString="hirurogeita hamar eta *" />
                                <Digit digit="8" string="laurogei" buildString="laurogeita *" />
                                <Digit digit="9" string="laurogeita hamar" buildString="laurogeita hamar eta *" />
                        </Group>
                        <Group level="3">
                                <Digit digit="0" string="" buildString="*" />
                                <Digit digit="1" string="ehun" buildString="ehun eta *" />
                                <Digit digit="2" string="berrehun" buildString="berrehun eta *" />
                                <Digit digit="3" string="hirurehun" buildString="hirurehun eta *" />
                                <Digit digit="4" string="laurehun" buildString="laurehun eta *" />
                                <Digit digit="5" string="bostehun" buildString="bostehun eta *" />
                                <Digit digit="6" string="seirehun" buildString="seirehun eta *" />
                                <Digit digit="7" string="zazpiehun" buildString="zazpiehun eta *" />
                                <Digit digit="8" string="zortziehun" buildString="zortziehun eta *" />
                                <Digit digit="9" string="bederatziehun" buildString="bederatziehun eta *" />
                        </Group>
                </Groups>
                <NumberScale firstLetterUpperCase="false">
                        <StaticNames>
                                <Scale value="0" string="" />
                                <Scale value="1" string="mila" />
                                <Scale value="2" string="milioi" />
                                <Scale value="3" string="mila milioi" />
                        </StaticNames>
                </NumberScale>
                <Replacements>
                        <Replacement oldValue="bat ehun" newValue="ehun" scope="Anywhere" />
                        <Replacement oldValue="bat mila" newValue="mila" onScale="1" onValue="1" />
                        <Replacement oldValue="hogei eta" newValue="hogeita" scope="Anywhere" />
                        <Replacement oldValue="berrogei eta" newValue="berrogeita" scope="Anywhere" />
                        <Replacement oldValue="hirurogei eta" newValue="hirurogeita" scope="Anywhere" />
                        <Replacement oldValue="laurogei eta" newValue="laurogeita" scope="Anywhere" />
                        <Replacement oldValue="hogeita hamar eta bat" newValue="hogeita hamaika" scope="Anywhere" />
                        <Replacement oldValue="hogeita hamar eta bi" newValue="hogeita hamabi" scope="Anywhere" />
                        <Replacement oldValue="hogeita hamar eta hiru" newValue="hogeita hamahiru" scope="Anywhere" />
                        <Replacement oldValue="hogeita hamar eta lau" newValue="hogeita hamalau" scope="Anywhere" />
                        <Replacement oldValue="hogeita hamar eta bost" newValue="hogeita hamabost" scope="Anywhere" />
                        <Replacement oldValue="hogeita hamar eta sei" newValue="hogeita hamasei" scope="Anywhere" />
                        <Replacement oldValue="hogeita hamar eta zazpi" newValue="hogeita hamazazpi" scope="Anywhere" />
                        <Replacement oldValue="hogeita hamar eta zortzi" newValue="hogeita hemezortzi" scope="Anywhere" />
                        <Replacement oldValue="hogeita hamar eta bederatzi" newValue="hogeita hemeretzi" scope="Anywhere" />
                        <Replacement oldValue="berrogeita hamar eta bat" newValue="berrogeita hamaika" scope="Anywhere" />
                        <Replacement oldValue="berrogeita hamar eta bi" newValue="berrogeita hamabi" scope="Anywhere" />
                        <Replacement oldValue="berrogeita hamar eta hiru" newValue="berrogeita hamahiru" scope="Anywhere" />
                        <Replacement oldValue="berrogeita hamar eta lau" newValue="berrogeita hamalau" scope="Anywhere" />
                        <Replacement oldValue="berrogeita hamar eta bost" newValue="berrogeita hamabost" scope="Anywhere" />
                        <Replacement oldValue="berrogeita hamar eta sei" newValue="berrogeita hamasei" scope="Anywhere" />
                        <Replacement oldValue="berrogeita hamar eta zazpi" newValue="berrogeita hamazazpi" scope="Anywhere" />
                        <Replacement oldValue="berrogeita hamar eta zortzi" newValue="berrogeita hemezortzi" scope="Anywhere" />
                        <Replacement oldValue="berrogeita hamar eta bederatzi" newValue="berrogeita hemeretzi" scope="Anywhere" />
                        <Replacement oldValue="hirurogeita hamar eta bat" newValue="hirurogeita hamaika" scope="Anywhere" />
                        <Replacement oldValue="hirurogeita hamar eta bi" newValue="hirurogeita hamabi" scope="Anywhere" />
                        <Replacement oldValue="hirurogeita hamar eta hiru" newValue="hirurogeita hamahiru" scope="Anywhere" />
                        <Replacement oldValue="hirurogeita hamar eta lau" newValue="hirurogeita hamalau" scope="Anywhere" />
                        <Replacement oldValue="hirurogeita hamar eta bost" newValue="hirurogeita hamabost" scope="Anywhere" />
                        <Replacement oldValue="hirurogeita hamar eta sei" newValue="hirurogeita hamasei" scope="Anywhere" />
                        <Replacement oldValue="hirurogeita hamar eta zazpi" newValue="hirurogeita hamazazpi" scope="Anywhere" />
                        <Replacement oldValue="hirurogeita hamar eta zortzi" newValue="hirurogeita hemezortzi" scope="Anywhere" />
                        <Replacement oldValue="hirurogeita hamar eta bederatzi" newValue="hirurogeita hemeretzi" scope="Anywhere" />
                        <Replacement oldValue="laurogeita hamar eta bat" newValue="laurogeita hamaika" scope="Anywhere" />
                        <Replacement oldValue="laurogeita hamar eta bi" newValue="laurogeita hamabi" scope="Anywhere" />
                        <Replacement oldValue="laurogeita hamar eta hiru" newValue="laurogeita hamahiru" scope="Anywhere" />
                        <Replacement oldValue="laurogeita hamar eta lau" newValue="laurogeita hamalau" scope="Anywhere" />
                        <Replacement oldValue="laurogeita hamar eta bost" newValue="laurogeita hamabost" scope="Anywhere" />
                        <Replacement oldValue="laurogeita hamar eta sei" newValue="laurogeita hamasei" scope="Anywhere" />
                        <Replacement oldValue="laurogeita hamar eta zazpi" newValue="laurogeita hamazazpi" scope="Anywhere" />
                        <Replacement oldValue="laurogeita hamar eta zortzi" newValue="laurogeita hemezortzi" scope="Anywhere" />
                        <Replacement oldValue="laurogeita hamar eta bederatzi" newValue="laurogeita hemeretzi" scope="Anywhere" />
                </Replacements>
                <Exceptions>
                        <Number value="11" string="hamaika" />
                        <Number value="12" string="hamabi" />
                        <Number value="13" string="hamahiru" />
                        <Number value="14" string="hamalau" />
                        <Number value="15" string="hamabost" />
                        <Number value="16" string="hamasei" />
                        <Number value="17" string="hamazazpi" />
                        <Number value="18" string="hemezortzi" />
                        <Number value="19" string="hemeretzi" />
                </Exceptions>
                <!--
                  Basque ordinals are formed by appending -garren to the cardinal.
                  The only irregular form is 1 → lehenengo (alternatively lehen).
                  All other forms follow the suffix rule: bi+garren=bigarren,
                  hiru+garren=hirugarren, hamar+garren=hamargarren, etc.
                  For compounds ("hogeita bat", "ehun eta bi") the last word
                  receives the suffix: "hogeita batgarren", "ehun eta bigarren".
                -->
                <!-- NTS-08: ordinal domain guard; values outside the validated domain fail closed (see BasqueOrdinalLanguageSpecifics). -->
                <LanguageSpecifics>BasqueOrdinalLanguageSpecifics</LanguageSpecifics>
                <Ordinals suffix="garren">
                        <OrdinalException value="1" string="lehenengo" />
                        <!-- NTS-08, Euskaltzaindia rule 18: bosgarren, hamabosgarren, hogeita bosgarren (not bostgarren). -->
                        <OrdinalStem from="bost" to="bos" />
                </Ordinals>
                <!-- Sareko Euskal Gramatika (EHU), "Orduak nola eman euskaraz": definite whole hours (ordu bata,
                     ordu biak, hirurak), bare numeral before "eta erdiak" (ordu bat eta erdiak), "eta laurden",
                     and "<next hour> laurden gutxi". "ordu" is used with one and two only. The clock-case forms
                     are literal per displayed hour, so the cardinals (bat, bi) are unchanged. Quarter-hour
                     12-hour clock without day-part wording. -->
                <ClockTime step="15" hourCycle="12">
                        <Rule range="0" displayHourRange="1" hourOffset="0" hourForm="cardinal" pattern="ordu bata" />
                        <Rule range="15" displayHourRange="1" hourOffset="0" hourForm="cardinal" pattern="ordu bata eta laurden" />
                        <Rule range="30" displayHourRange="1" hourOffset="0" hourForm="cardinal" pattern="ordu bat eta erdiak" />
                        <Rule range="45" displayHourRange="1" hourOffset="1" hourForm="cardinal" pattern="ordu bata laurden gutxi" />
                        <Rule range="0" displayHourRange="2" hourOffset="0" hourForm="cardinal" pattern="ordu biak" />
                        <Rule range="15" displayHourRange="2" hourOffset="0" hourForm="cardinal" pattern="ordu biak eta laurden" />
                        <Rule range="30" displayHourRange="2" hourOffset="0" hourForm="cardinal" pattern="ordu bi eta erdiak" />
                        <Rule range="45" displayHourRange="2" hourOffset="1" hourForm="cardinal" pattern="ordu biak laurden gutxi" />
                        <Rule range="0" displayHourRange="3" hourOffset="0" hourForm="cardinal" pattern="hirurak" />
                        <Rule range="15" displayHourRange="3" hourOffset="0" hourForm="cardinal" pattern="hirurak eta laurden" />
                        <Rule range="30" displayHourRange="3" hourOffset="0" hourForm="cardinal" pattern="hiru eta erdiak" />
                        <Rule range="45" displayHourRange="3" hourOffset="1" hourForm="cardinal" pattern="hirurak laurden gutxi" />
                        <Rule range="0" displayHourRange="4" hourOffset="0" hourForm="cardinal" pattern="laurak" />
                        <Rule range="15" displayHourRange="4" hourOffset="0" hourForm="cardinal" pattern="laurak eta laurden" />
                        <Rule range="30" displayHourRange="4" hourOffset="0" hourForm="cardinal" pattern="lau eta erdiak" />
                        <Rule range="45" displayHourRange="4" hourOffset="1" hourForm="cardinal" pattern="laurak laurden gutxi" />
                        <Rule range="0" displayHourRange="5" hourOffset="0" hourForm="cardinal" pattern="bostak" />
                        <Rule range="15" displayHourRange="5" hourOffset="0" hourForm="cardinal" pattern="bostak eta laurden" />
                        <Rule range="30" displayHourRange="5" hourOffset="0" hourForm="cardinal" pattern="bost eta erdiak" />
                        <Rule range="45" displayHourRange="5" hourOffset="1" hourForm="cardinal" pattern="bostak laurden gutxi" />
                        <Rule range="0" displayHourRange="6" hourOffset="0" hourForm="cardinal" pattern="seiak" />
                        <Rule range="15" displayHourRange="6" hourOffset="0" hourForm="cardinal" pattern="seiak eta laurden" />
                        <Rule range="30" displayHourRange="6" hourOffset="0" hourForm="cardinal" pattern="sei eta erdiak" />
                        <Rule range="45" displayHourRange="6" hourOffset="1" hourForm="cardinal" pattern="seiak laurden gutxi" />
                        <Rule range="0" displayHourRange="7" hourOffset="0" hourForm="cardinal" pattern="zazpiak" />
                        <Rule range="15" displayHourRange="7" hourOffset="0" hourForm="cardinal" pattern="zazpiak eta laurden" />
                        <Rule range="30" displayHourRange="7" hourOffset="0" hourForm="cardinal" pattern="zazpi eta erdiak" />
                        <Rule range="45" displayHourRange="7" hourOffset="1" hourForm="cardinal" pattern="zazpiak laurden gutxi" />
                        <Rule range="0" displayHourRange="8" hourOffset="0" hourForm="cardinal" pattern="zortziak" />
                        <Rule range="15" displayHourRange="8" hourOffset="0" hourForm="cardinal" pattern="zortziak eta laurden" />
                        <Rule range="30" displayHourRange="8" hourOffset="0" hourForm="cardinal" pattern="zortzi eta erdiak" />
                        <Rule range="45" displayHourRange="8" hourOffset="1" hourForm="cardinal" pattern="zortziak laurden gutxi" />
                        <Rule range="0" displayHourRange="9" hourOffset="0" hourForm="cardinal" pattern="bederatziak" />
                        <Rule range="15" displayHourRange="9" hourOffset="0" hourForm="cardinal" pattern="bederatziak eta laurden" />
                        <Rule range="30" displayHourRange="9" hourOffset="0" hourForm="cardinal" pattern="bederatzi eta erdiak" />
                        <Rule range="45" displayHourRange="9" hourOffset="1" hourForm="cardinal" pattern="bederatziak laurden gutxi" />
                        <Rule range="0" displayHourRange="10" hourOffset="0" hourForm="cardinal" pattern="hamarrak" />
                        <Rule range="15" displayHourRange="10" hourOffset="0" hourForm="cardinal" pattern="hamarrak eta laurden" />
                        <Rule range="30" displayHourRange="10" hourOffset="0" hourForm="cardinal" pattern="hamar eta erdiak" />
                        <Rule range="45" displayHourRange="10" hourOffset="1" hourForm="cardinal" pattern="hamarrak laurden gutxi" />
                        <Rule range="0" displayHourRange="11" hourOffset="0" hourForm="cardinal" pattern="hamaikak" />
                        <Rule range="15" displayHourRange="11" hourOffset="0" hourForm="cardinal" pattern="hamaikak eta laurden" />
                        <Rule range="30" displayHourRange="11" hourOffset="0" hourForm="cardinal" pattern="hamaika eta erdiak" />
                        <Rule range="45" displayHourRange="11" hourOffset="1" hourForm="cardinal" pattern="hamaikak laurden gutxi" />
                        <Rule range="0" displayHourRange="12" hourOffset="0" hourForm="cardinal" pattern="hamabiak" />
                        <Rule range="15" displayHourRange="12" hourOffset="0" hourForm="cardinal" pattern="hamabiak eta laurden" />
                        <Rule range="30" displayHourRange="12" hourOffset="0" hourForm="cardinal" pattern="hamabi eta erdiak" />
                        <Rule range="45" displayHourRange="12" hourOffset="1" hourForm="cardinal" pattern="hamabiak laurden gutxi" />
                </ClockTime>
        </Language>
</Numbers>
