<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="nolla"
        minus="miinus *"
        decimalSeparator="pilkku"
        fractionSeparator="yli"
        maxNumber="999999"
    >
        <Culture>FI</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="yksi" />
                <Digit digit="2" string="kaksi" />
                <Digit digit="3" string="kolme" />
                <Digit digit="4" string="neljä" />
                <Digit digit="5" string="viisi" />
                <Digit digit="6" string="kuusi" />
                <Digit digit="7" string="seitsemän" />
                <Digit digit="8" string="kahdeksan" />
                <Digit digit="9" string="yhdeksän" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="kymmenen" buildString="kymmenen*" />
                <Digit digit="2" string="kaksikymmentä" buildString="kaksikymmentä*" />
                <Digit digit="3" string="kolmekymmentä" buildString="kolmekymmentä*" />
                <Digit digit="4" string="neljäkymmentä" buildString="neljäkymmentä*" />
                <Digit digit="5" string="viisikymmentä" buildString="viisikymmentä*" />
                <Digit digit="6" string="kuusikymmentä" buildString="kuusikymmentä*" />
                <Digit digit="7" string="seitsemänkymmentä" buildString="seitsemänkymmentä*" />
                <Digit digit="8" string="kahdeksankymmentä" buildString="kahdeksankymmentä*" />
                <Digit digit="9" string="yhdeksänkymmentä" buildString="yhdeksänkymmentä*" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="sata" buildString="sata*" />
                <Digit digit="2" string="kaksisataa" buildString="kaksisataa*" />
                <Digit digit="3" string="kolmesataa" buildString="kolmesataa*" />
                <Digit digit="4" string="neljäsataa" buildString="neljäsataa*" />
                <Digit digit="5" string="viisisataa" buildString="viisisataa*" />
                <Digit digit="6" string="kuusisataa" buildString="kuusisataa*" />
                <Digit digit="7" string="seitsemänsataa" buildString="seitsemänsataa*" />
                <Digit digit="8" string="kahdeksansataa" buildString="kahdeksansataa*" />
                <Digit digit="9" string="yhdeksänsataa" buildString="yhdeksänsataa*" />
            </Group>
        </Groups>
        <!--
          NTS-30E, Kielitoimiston ohjepankki "Luvut ja numerot: numeroiden ryhmittely": a number written in words is
          split where its digits are grouped; the part below a thousand is one word, so is the part counting the
          thousands ("tuhat viisisataa", "neljätoistatuhatta kuusisataa", "viisimiljoonaa
          neljäsataakaksikymmentäkuusituhatta kuusisataaseitsemänkymmentäneljä"), while miljoona, miljardi … are
          usually written apart from their multiplier ("kolme miljoonaa", "neljäkymmentäyhdeksän miljoonaa").
          Three boundaries follow:
          - inside a group: the buildStrings carry no space (kaksikymmentäyksi, satakaksikymmentäyksi);
          - between groups: groupSeparator "" + separator " " (one space). The language separator stays " " because
            it also separates the words of decimals, fractions, currencies and digit-by-digit readings;
          - multiplier and scale noun: multiplierSeparator " " for every scale, "" for the thousands (kaksituhatta).
          The cardinal domain stays 0-999 999 (maxNumber): the miljoona suffix and its variant rules are dormant
          configuration kept for a future opening of the millions.
        -->
        <NumberScale firstLetterUpperCase="false" multiplierSeparator=" ">
            <StaticNames>
                <Scale value="0" string="" />
                <Scale value="1" string="tuhat" />
            </StaticNames>
            <Suffixes>
                <Suffix>miljoona</Suffix>
            </Suffixes>
            <!-- tuhat after the (elided) multiplier one, the partitive tuhatta after any other multiplier (viisituhatta,
                 neljätoistatuhatta, satatuhatta), written together with the multiplier. -->
            <ScaleForm scale="1" multiplierSeparator="">
                <Forms>
                    <Form key="singular" value="tuhat" />
                    <Form key="plural" value="tuhatta" />
                </Forms>
            </ScaleForm>
        </NumberScale>
        <Replacements>
            <!-- 1 000 is "tuhat", not "yksituhat": the multiplier 1 is elided before the thousands (same mechanism as
                 the Hungarian egyezer → ezer). The rule matches the whole thousands group only. -->
            <Replacement oldValue="yksituhat" newValue="tuhat" onScale="1" onValue="1" />
        </Replacements>
        <Exceptions>
            <Number value="11" string="yksitoista" />
            <Number value="12" string="kaksitoista" />
            <Number value="13" string="kolmetoista" />
            <Number value="14" string="neljätoista" />
            <Number value="15" string="viisitoista" />
            <Number value="16" string="kuusitoista" />
            <Number value="17" string="seitsemäntoista" />
            <Number value="18" string="kahdeksantoista" />
            <Number value="19" string="yhdeksäntoista" />
        </Exceptions>
        <Variants>
            <!--
              Finnish declines numbers across 15 cases (sijamuoto).
              Nominatiivi (default), partitiivi and genetiivi are implemented.

              NTS-30E, Kielitoimiston ohjepankki "Luvut ja numerot: peruslukujen taivuttaminen": every component of
              an inflected cardinal inflects and the compound stays one word (20:tä kahtakymmentä, 21:tä
              kahtakymmentäyhtä, 21:n kahdenkymmenenyhden, 115:tä sataaviittätoista, 125:n
              sadankahdenkymmenenviiden, 125:tä sataakahtakymmentäviittä, 523:a viittäsataakahtakymmentäkolmea,
              3 000:n kolmentuhannen, 3 000:ta kolmeatuhatta); -toista never inflects; seitsemän, kahdeksan and
              yhdeksän are identical in the nominative and the genitive.

              Every nominative component is therefore replaced wherever it occurs (scope Anywhere), the rules
              running once each in declaration order:
              - the components whose nominative already contains their bare form (sataa ⊃ sata, tuhatta ⊃ tuhat,
                miljoonaa ⊃ miljoona) are first brought back to that bare form, then the bare form is inflected, so
                that no form is inflected twice;
              - no unit word is a substring of another component (yksi, kaksi, kolme, neljä, viisi, kuusi,
                seitsemän, kahdeksan, yhdeksän, kymmen-, sata, tuhat, toista, miljoona), and no inflected form is
                matched by a later rule.
              The separators are untouched: a space between groups stays a space ("kahtakymmentäyhtätuhatta
              sataakahtakymmentäyhtä").
            -->
            <Dimension name="case" localName="sijamuoto" values="nominatiivi,partitiivi,genetiivi" />

            <!-- ── Partitiivi ─────────────────────────────────────────────── -->
            <Variant type="case" variant="partitiivi">
                <!-- Hundreds, thousands, millions: the multiplied form already is the partitive (kaksisataa); the
                     bare form gets it (sata → sataa, tuhat → tuhatta). -->
                <Replacement oldValue="sataa"     newValue="sata"      scope="Anywhere" />
                <Replacement oldValue="sata"      newValue="sataa"     scope="Anywhere" />
                <Replacement oldValue="tuhatta"   newValue="tuhat"     scope="Anywhere" />
                <Replacement oldValue="tuhat"     newValue="tuhatta"   scope="Anywhere" />
                <Replacement oldValue="miljoonaa" newValue="miljoona"  scope="Anywhere" />
                <Replacement oldValue="miljoona"  newValue="miljoonaa" scope="Anywhere" />
                <!-- Ten alone (kymmenen → kymmentä); the multiplied -kymmentä already is the partitive. -->
                <Replacement oldValue="kymmenen"  newValue="kymmentä"  scope="Anywhere" />
                <!-- Units, alone or as the first part of 11-19 (yhtätoista), of the tens (kahtakymmentä), of the
                     hundreds (kahtasataa) and of the thousands (kahtatuhatta). -->
                <Replacement oldValue="yksi"      newValue="yhtä"      scope="Anywhere" />
                <Replacement oldValue="kaksi"     newValue="kahta"     scope="Anywhere" />
                <Replacement oldValue="kolme"     newValue="kolmea"    scope="Anywhere" />
                <Replacement oldValue="neljä"     newValue="neljää"    scope="Anywhere" />
                <Replacement oldValue="viisi"     newValue="viittä"    scope="Anywhere" />
                <Replacement oldValue="kuusi"     newValue="kuutta"    scope="Anywhere" />
                <Replacement oldValue="seitsemän" newValue="seitsemää" scope="Anywhere" />
                <Replacement oldValue="kahdeksan" newValue="kahdeksaa" scope="Anywhere" />
                <Replacement oldValue="yhdeksän"  newValue="yhdeksää"  scope="Anywhere" />
            </Variant>

            <!-- ── Genetiivi ──────────────────────────────────────────────── -->
            <Variant type="case" variant="genetiivi">
                <Replacement oldValue="sataa"     newValue="sadan"     scope="Anywhere" />
                <Replacement oldValue="sata"      newValue="sadan"     scope="Anywhere" />
                <Replacement oldValue="tuhatta"   newValue="tuhannen"  scope="Anywhere" />
                <Replacement oldValue="tuhat"     newValue="tuhannen"  scope="Anywhere" />
                <Replacement oldValue="miljoonaa" newValue="miljoonan" scope="Anywhere" />
                <Replacement oldValue="miljoona"  newValue="miljoonan" scope="Anywhere" />
                <!-- The multiplied tens (kaksikymmentä → kahdenkymmenen); kymmenen alone is already the genitive. -->
                <Replacement oldValue="kymmentä"  newValue="kymmenen"  scope="Anywhere" />
                <!-- Units; seitsemän, kahdeksan and yhdeksän are invariable. -->
                <Replacement oldValue="yksi"      newValue="yhden"     scope="Anywhere" />
                <Replacement oldValue="kaksi"     newValue="kahden"    scope="Anywhere" />
                <Replacement oldValue="kolme"     newValue="kolmen"    scope="Anywhere" />
                <Replacement oldValue="neljä"     newValue="neljän"    scope="Anywhere" />
                <Replacement oldValue="viisi"     newValue="viiden"    scope="Anywhere" />
                <Replacement oldValue="kuusi"     newValue="kuuden"    scope="Anywhere" />
            </Variant>
        </Variants>
        <!-- NTS-08: ordinal domain guard; values outside the validated domain fail closed (see FinnishOrdinalLanguageSpecifics). -->
        <LanguageSpecifics>FinnishOrdinalLanguageSpecifics</LanguageSpecifics>
        <Ordinals>
            <!-- Zéro : "nollas" (Wiktionary citant le Kielitoimiston sanakirja ; kieli.net), NTS-12 -->
            <OrdinalException value="0" string="nollas" />
            <!-- Unités -->
            <OrdinalException value="1" string="ensimmäinen" />
            <OrdinalException value="2" string="toinen" />
            <Ordinal from="yksi"      to="ensimmäinen" />
            <Ordinal from="kaksi"     to="toinen" />
            <Ordinal from="kolme"     to="kolmas" />
            <Ordinal from="neljä"     to="neljäs" />
            <Ordinal from="viisi"     to="viides" />
            <Ordinal from="kuusi"     to="kuudes" />
            <Ordinal from="seitsemän" to="seitsemäs" />
            <Ordinal from="kahdeksan" to="kahdeksas" />
            <Ordinal from="yhdeksän"  to="yhdeksäs" />
            <!-- Dizaine de base -->
            <Ordinal from="kymmenen"  to="kymmenes" />
            <!-- Exceptions 11-19 -->
            <Ordinal from="yksitoista"      to="yhdestoista" />
            <Ordinal from="kaksitoista"     to="kahdestoista" />
            <Ordinal from="kolmetoista"     to="kolmastoista" />
            <Ordinal from="neljätoista"     to="neljästoista" />
            <Ordinal from="viisitoista"     to="viidestoista" />
            <Ordinal from="kuusitoista"     to="kuudestoista" />
            <Ordinal from="seitsemäntoista" to="seitsemästoista" />
            <Ordinal from="kahdeksantoista" to="kahdeksastoista" />
            <Ordinal from="yhdeksäntoista"  to="yhdeksästoista" />
            <!-- Dizaines 20-90 -->
            <Ordinal from="kaksikymmentä"     to="kahdeskymmenes" />
            <Ordinal from="kolmekymmentä"     to="kolmaskymmenes" />
            <Ordinal from="neljäkymmentä"     to="neljäskymmenes" />
            <Ordinal from="viisikymmentä"     to="viideskymmenes" />
            <Ordinal from="kuusikymmentä"     to="kuudeskymmenes" />
            <Ordinal from="seitsemänkymmentä" to="seitsemäskymmenes" />
            <Ordinal from="kahdeksankymmentä" to="kahdeksaskymmenes" />
            <Ordinal from="yhdeksänkymmentä"  to="yhdeksäskymmenes" />
            <!-- Centaines -->
            <Ordinal from="sata"           to="sadas" />
            <Ordinal from="kaksisataa"     to="kahdessadas" />
            <Ordinal from="kolmesataa"     to="kolmassadas" />
            <Ordinal from="neljäsataa"     to="neljässadas" />
            <Ordinal from="viisisataa"     to="viidessadas" />
            <Ordinal from="kuusisataa"     to="kuudessadas" />
            <Ordinal from="seitsemänsataa" to="seitsemässadas" />
            <Ordinal from="kahdeksansataa" to="kahdeksassadas" />
            <Ordinal from="yhdeksänsataa"  to="yhdeksässadas" />
            <!-- Millier -->
            <Ordinal from="tuhat" to="tuhannes" />
            <!-- NTS-28, Kielitoimiston ohjepankki "Luvut ja numerot: järjestysluvut": the ordinal marker recurs in
                 every part, written as one word (viideskymmenesviides, kahdeskymmenesensimmäinen,
                 kolmaskymmenestoinen); each part is built through the whole pipeline (11-19 keep the marker on the
                 first part only: sadasyhdestoista). Nominative only; from 2000 the guard fails closed: the cardinal is correct since NTS-30E (kaksituhatta), but
                 no consulted source gives the round-thousand ordinals. -->
            <OrdinalComposition for="21..99" divisor="10" separator="" />
            <OrdinalComposition for="101..999" divisor="100" separator="" />
            <OrdinalComposition for="1001..1999" divisor="1000" separator="" />
        </Ordinals>
        <!-- Kielitoimisto: "varttia yli yksi", "puoli kaksi" (the half refers to the following hour),
             "varttia vaille kaksi". Quarter-hour 12-hour clock without day-part wording. -->
        <ClockTime step="15" hourCycle="12">
            <Rule range="0" hourOffset="0" hourForm="cardinal" pattern="{hour}" />
            <Rule range="15" hourOffset="0" hourForm="cardinal" pattern="varttia yli {hour}" />
            <Rule range="30" hourOffset="1" hourForm="cardinal" pattern="puoli {hour}" />
            <Rule range="45" hourOffset="1" hourForm="cardinal" pattern="varttia vaille {hour}" />
        </ClockTime>
    </Language>
</Numbers>
