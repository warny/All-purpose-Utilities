<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="iqanda"
        minus="minus *"
        decimalSeparator="phuzu"
        fractionSeparator="ngaphezu"

                maxNumber="999999"
        >
        <Culture>ZU</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="kunye" />
                <Digit digit="2" string="kubili" />
                <Digit digit="3" string="kuthathu" />
                <Digit digit="4" string="kune" />
                <Digit digit="5" string="isihlanu" />
                <Digit digit="6" string="isithupha" />
                <Digit digit="7" string="isikhombisa" />
                <Digit digit="8" string="isishiyagalombili" />
                <Digit digit="9" string="isishiyagalolunye" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="ishumi" buildString="ishumi n*" />
                <Digit digit="2" string="amashumi amabili" buildString="amashumi amabili n*" />
                <Digit digit="3" string="amashumi amathathu" buildString="amashumi amathathu n*" />
                <Digit digit="4" string="amashumi amane" buildString="amashumi amane n*" />
                <Digit digit="5" string="amashumi amahlanu" buildString="amashumi amahlanu n*" />
                <Digit digit="6" string="amashumi ayisithupha" buildString="amashumi ayisithupha n*" />
                <Digit digit="7" string="amashumi ayisikhombisa" buildString="amashumi ayisikhombisa n*" />
                <Digit digit="8" string="amashumi ayisishiyagalombili" buildString="amashumi ayisishiyagalombili n*" />
                <Digit digit="9" string="amashumi ayisishiyagalolunye" buildString="amashumi ayisishiyagalolunye n*" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="ikhulu" buildString="ikhulu n*" />
                <Digit digit="2" string="amakhulu amabili" buildString="amakhulu amabili n*" />
                <Digit digit="3" string="amakhulu amathathu" buildString="amakhulu amathathu n*" />
                <Digit digit="4" string="amakhulu amane" buildString="amakhulu amane n*" />
                <Digit digit="5" string="amakhulu amahlanu" buildString="amakhulu amahlanu n*" />
                <Digit digit="6" string="amakhulu ayisithupha" buildString="amakhulu ayisithupha n*" />
                <Digit digit="7" string="amakhulu ayisikhombisa" buildString="amakhulu ayisikhombisa n*" />
                <Digit digit="8" string="amakhulu ayisishiyagalombili" buildString="amakhulu ayisishiyagalombili n*" />
                <Digit digit="9" string="amakhulu ayisishiyagalolunye" buildString="amakhulu ayisishiyagalolunye n*" />
            </Group>
        </Groups>
        <NumberScale firstLetterUpperCase="false">
            <StaticNames>
                <Scale value="0" string="" />
                <Scale value="1" string="inkulungwane" />
            </StaticNames>
            <Suffixes>
                <Suffix>isigidi</Suffix>
            </Suffixes>
        </NumberScale>
        <Exceptions>
            <Number value="11" string="ishumi nanye" />
            <Number value="12" string="ishumi nambili" />
            <Number value="13" string="ishumi nantathu" />
            <Number value="14" string="ishumi nane" />
            <Number value="15" string="ishumi nesihlanu" />
            <Number value="16" string="ishumi nesithupha" />
            <Number value="17" string="ishumi nesikhombisa" />
            <Number value="18" string="ishumi nesishiyagalombili" />
            <Number value="19" string="ishumi nesishiyagalolunye" />
        </Exceptions>
        <!-- Unisa "Learn online Zulu", Theme 4: "Yihora lesihlanu", "Imizuzu eyishumi lishayile
             elesihlanu", "Ligamenxe elesihlanu", "... ngaphambi kwelesihlanu". The hour is a class-5
             ordinal agreeing with "ihora" (ihora lesibili; relative elesibili when the noun is elided;
             kwelesibili after "ngaphambi kwa-"). These forms are literal clock-only patterns per
             displayed hour: they do not enable general ordinal conversion, which needs a noun-class
             policy. Quarter-hour 12-hour clock without day-part wording. -->
        <ClockTime step="15" hourCycle="12">
            <Rule range="0" displayHourRange="1" hourOffset="0" hourForm="cardinal" pattern="ihora lokuqala" />
            <Rule range="15" displayHourRange="1" hourOffset="0" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu lishayile elokuqala" />
            <Rule range="30" displayHourRange="1" hourOffset="0" hourForm="cardinal" pattern="ligamenxe elokuqala" />
            <Rule range="45" displayHourRange="1" hourOffset="1" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu ngaphambi kwelokuqala" />
            <Rule range="0" displayHourRange="2" hourOffset="0" hourForm="cardinal" pattern="ihora lesibili" />
            <Rule range="15" displayHourRange="2" hourOffset="0" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu lishayile elesibili" />
            <Rule range="30" displayHourRange="2" hourOffset="0" hourForm="cardinal" pattern="ligamenxe elesibili" />
            <Rule range="45" displayHourRange="2" hourOffset="1" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu ngaphambi kwelesibili" />
            <Rule range="0" displayHourRange="3" hourOffset="0" hourForm="cardinal" pattern="ihora lesithathu" />
            <Rule range="15" displayHourRange="3" hourOffset="0" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu lishayile elesithathu" />
            <Rule range="30" displayHourRange="3" hourOffset="0" hourForm="cardinal" pattern="ligamenxe elesithathu" />
            <Rule range="45" displayHourRange="3" hourOffset="1" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu ngaphambi kwelesithathu" />
            <Rule range="0" displayHourRange="4" hourOffset="0" hourForm="cardinal" pattern="ihora lesine" />
            <Rule range="15" displayHourRange="4" hourOffset="0" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu lishayile elesine" />
            <Rule range="30" displayHourRange="4" hourOffset="0" hourForm="cardinal" pattern="ligamenxe elesine" />
            <Rule range="45" displayHourRange="4" hourOffset="1" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu ngaphambi kwelesine" />
            <Rule range="0" displayHourRange="5" hourOffset="0" hourForm="cardinal" pattern="ihora lesihlanu" />
            <Rule range="15" displayHourRange="5" hourOffset="0" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu lishayile elesihlanu" />
            <Rule range="30" displayHourRange="5" hourOffset="0" hourForm="cardinal" pattern="ligamenxe elesihlanu" />
            <Rule range="45" displayHourRange="5" hourOffset="1" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu ngaphambi kwelesihlanu" />
            <Rule range="0" displayHourRange="6" hourOffset="0" hourForm="cardinal" pattern="ihora lesithupha" />
            <Rule range="15" displayHourRange="6" hourOffset="0" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu lishayile elesithupha" />
            <Rule range="30" displayHourRange="6" hourOffset="0" hourForm="cardinal" pattern="ligamenxe elesithupha" />
            <Rule range="45" displayHourRange="6" hourOffset="1" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu ngaphambi kwelesithupha" />
            <Rule range="0" displayHourRange="7" hourOffset="0" hourForm="cardinal" pattern="ihora lesikhombisa" />
            <Rule range="15" displayHourRange="7" hourOffset="0" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu lishayile elesikhombisa" />
            <Rule range="30" displayHourRange="7" hourOffset="0" hourForm="cardinal" pattern="ligamenxe elesikhombisa" />
            <Rule range="45" displayHourRange="7" hourOffset="1" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu ngaphambi kwelesikhombisa" />
            <Rule range="0" displayHourRange="8" hourOffset="0" hourForm="cardinal" pattern="ihora lesishiyagalombili" />
            <Rule range="15" displayHourRange="8" hourOffset="0" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu lishayile elesishiyagalombili" />
            <Rule range="30" displayHourRange="8" hourOffset="0" hourForm="cardinal" pattern="ligamenxe elesishiyagalombili" />
            <Rule range="45" displayHourRange="8" hourOffset="1" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu ngaphambi kwelesishiyagalombili" />
            <Rule range="0" displayHourRange="9" hourOffset="0" hourForm="cardinal" pattern="ihora lesishiyagalolunye" />
            <Rule range="15" displayHourRange="9" hourOffset="0" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu lishayile elesishiyagalolunye" />
            <Rule range="30" displayHourRange="9" hourOffset="0" hourForm="cardinal" pattern="ligamenxe elesishiyagalolunye" />
            <Rule range="45" displayHourRange="9" hourOffset="1" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu ngaphambi kwelesishiyagalolunye" />
            <Rule range="0" displayHourRange="10" hourOffset="0" hourForm="cardinal" pattern="ihora leshumi" />
            <Rule range="15" displayHourRange="10" hourOffset="0" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu lishayile eleshumi" />
            <Rule range="30" displayHourRange="10" hourOffset="0" hourForm="cardinal" pattern="ligamenxe eleshumi" />
            <Rule range="45" displayHourRange="10" hourOffset="1" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu ngaphambi kweleshumi" />
            <Rule range="0" displayHourRange="11" hourOffset="0" hourForm="cardinal" pattern="ihora leshumi nanye" />
            <Rule range="15" displayHourRange="11" hourOffset="0" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu lishayile eleshumi nanye" />
            <Rule range="30" displayHourRange="11" hourOffset="0" hourForm="cardinal" pattern="ligamenxe eleshumi nanye" />
            <Rule range="45" displayHourRange="11" hourOffset="1" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu ngaphambi kweleshumi nanye" />
            <Rule range="0" displayHourRange="12" hourOffset="0" hourForm="cardinal" pattern="ihora leshumi nambili" />
            <Rule range="15" displayHourRange="12" hourOffset="0" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu lishayile eleshumi nambili" />
            <Rule range="30" displayHourRange="12" hourOffset="0" hourForm="cardinal" pattern="ligamenxe eleshumi nambili" />
            <Rule range="45" displayHourRange="12" hourOffset="1" hourForm="cardinal" pattern="imizuzu eyishumi nanhlanu ngaphambi kweleshumi nambili" />
        </ClockTime>
    </Language>
</Numbers>
