<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <!--
      Romanian (RO) cardinals.

      Gender: "unu/una" (1m/f) and "doi/două" (2m/f) are tracked via the gender variant.
      The default gender (no variant) is masculine; "neutru" counts a neuter plural noun (unu, două).
      The multiplier of mii is forced feminine, that of milioane/miliarde neuter (NTS-54, ScaleForm below).

      scaleConnector="de" inserts "de" between the multiplier and the scale name when the
      multiplier is ≥ 20 (douăzeci de mii, o sută de milioane, etc.), except after a multiplier
      whose last two digits are 1-19 (NTS-53, the ScaleConnector element below).
    -->
    <Language
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="zero"
        minus="minus *"
        decimalSeparator="virgulă"
        decimalDigitByDigitMaxDigits="0"
        fractionSeparator="peste"
        scaleConnector="de"
        scaleConnectorThreshold="20"

                maxNumber="999999999999"
        >
        <!-- NTS-34: no automatic decimal reading (C: textbooks: opt întregi și douăzeci și șapte miimi, or opt virgulă zero douăzeci și șapte (a number); docs/NTS-34-decimal-reading-audit.md). LanguageDefault throws NotSupportedException for a decimal part; DecimalReadingMode.DigitByDigit, requested by the caller, is unchanged. -->
        <Culture>RO</Culture>
        <Culture>RO-RO</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="unu" />
                <Digit digit="2" string="doi" />
                <Digit digit="3" string="trei" />
                <Digit digit="4" string="patru" />
                <Digit digit="5" string="cinci" />
                <Digit digit="6" string="șase" />
                <Digit digit="7" string="șapte" />
                <Digit digit="8" string="opt" />
                <Digit digit="9" string="nouă" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="zece" buildString="zece *" />
                <Digit digit="2" string="douăzeci" buildString="douăzeci și *" />
                <Digit digit="3" string="treizeci" buildString="treizeci și *" />
                <Digit digit="4" string="patruzeci" buildString="patruzeci și *" />
                <Digit digit="5" string="cincizeci" buildString="cincizeci și *" />
                <Digit digit="6" string="șaizeci" buildString="șaizeci și *" />
                <Digit digit="7" string="șaptezeci" buildString="șaptezeci și *" />
                <Digit digit="8" string="optzeci" buildString="optzeci și *" />
                <Digit digit="9" string="nouăzeci" buildString="nouăzeci și *" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <Digit digit="1" string="o sută" buildString="o sută *" />
                <Digit digit="2" string="două sute" buildString="două sute *" />
                <Digit digit="3" string="trei sute" buildString="trei sute *" />
                <Digit digit="4" string="patru sute" buildString="patru sute *" />
                <Digit digit="5" string="cinci sute" buildString="cinci sute *" />
                <Digit digit="6" string="șase sute" buildString="șase sute *" />
                <Digit digit="7" string="șapte sute" buildString="șapte sute *" />
                <Digit digit="8" string="opt sute" buildString="opt sute *" />
                <Digit digit="9" string="nouă sute" buildString="nouă sute *" />
            </Group>
        </Groups>
        <NumberScale firstLetterUpperCase="false">
            <StaticNames>
                <Scale value="0" string="" />
                <!--
                  Scale names use the plural form; singular replacements are handled via onScale+onValue.
                  "o mie"=1 000, "două mii"=2 000 → Replacements below.
                  "un milion"=1M, "un miliard"=1B → Replacements below.
                -->
                <Scale value="1" string="mii" />
                <Scale value="2" string="milioane" />
                <Scale value="3" string="miliarde" />
            </StaticNames>
            <!-- NTS-54: the multiplier agrees with its scale noun like any numeral with its noun, on the last
                 constituent of the whole multiplier, whatever the caller's gender (the forced group is shielded from
                 the caller's passes, the lower groups keep agreeing with the counted noun).
                 mie / mii is feminine (DEX '09 "mie": num. card., s. f.): două mii (DOOM 3, Studiu introductiv §4.1.5),
                 douăsprezece mii de lei (DOOM 2, Normele §6.4), douăzeci și două de mii (DOOM 3 "douăzeci și doi":
                 num. m., f. douăzeci și două), douăzeci și una de mii (no normative statement; majority spelling of a
                 ro.wikisource / ro.wikipedia sample, 11 against 2, and the form RomanianOrdinalLanguageSpecifics
                 already writes; user decision).
                 milion / miliard are neuter (DOOM 3 "milion": s. n., pl. milioane): the neuter plural counts with the
                 feminine două (DOOM 3 "două puncte": num. + s. n. pl.; GALR 2005: două milioane trei sute opt lei) and
                 keeps unu (douăzeci și unu de milioane), the gen=neutru variant below.
                 The NTS-53 connector is decided on the number and is untouched. -->
            <ScaleForm scale="1">
                <Forms>
                    <Form key="singular" value="mie" forceVariants="gen=feminin" />
                    <Form key="plural" value="mii" forceVariants="gen=feminin" />
                </Forms>
            </ScaleForm>
            <ScaleForm scale="2">
                <Forms>
                    <Form key="singular" value="milion" forceVariants="gen=neutru" />
                    <Form key="plural" value="milioane" forceVariants="gen=neutru" />
                </Forms>
            </ScaleForm>
            <ScaleForm scale="3">
                <Forms>
                    <Form key="singular" value="miliard" forceVariants="gen=neutru" />
                    <Form key="plural" value="miliarde" forceVariants="gen=neutru" />
                </Forms>
            </ScaleForm>
        </NumberScale>
        <Replacements>
            <!-- One alone before a scale noun is the attributive o / un (DOOM 3 §4.1.5: o mie, un milion); the forced
                 gender has already turned the multiplier into una (feminine) or kept unu (neuter). -->
            <Replacement oldValue="una mie"     newValue="o mie"      onScale="1" onValue="1" />
            <Replacement oldValue="unu milion"  newValue="un milion"  onScale="2" onValue="1" />
            <Replacement oldValue="unu miliard" newValue="un miliard" onScale="3" onValue="1" />
        </Replacements>
        <Exceptions>
            <Number value="1"  string="unu" />
            <Number value="11" string="unsprezece" />
            <Number value="12" string="doisprezece" />
            <Number value="13" string="treisprezece" />
            <Number value="14" string="paisprezece" />
            <Number value="15" string="cincisprezece" />
            <Number value="16" string="șaisprezece" />
            <Number value="17" string="șaptesprezece" />
            <Number value="18" string="optsprezece" />
            <Number value="19" string="nouăsprezece" />
        </Exceptions>
        <Variants>
            <Dimension name="gen" values="masculin,feminin,neutru" />
            <Variant type="gen" variant="feminin">
                <!-- 1f: una; 2f: două -->
                <Replacement oldValue="unu" newValue="una"  scope="LastWord" />
                <Replacement oldValue="doi" newValue="două" scope="LastWord" />
                <!-- 12f: douăsprezece ("ora douăsprezece", "a douăsprezecea") -->
                <Replacement oldValue="doisprezece" newValue="douăsprezece" scope="LastWord" />
            </Variant>
            <!-- NTS-54: the neuter counts a plural noun with the feminine two and the masculine one (DOOM 3 "două
                 puncte": num. + s. n. pl.; douăzeci și unu de milioane): două scaune, douăzeci și unu de scaune. Forced
                 on the multiplier of milioane / miliarde; available to the caller for a neuter counted noun. -->
            <Variant type="gen" variant="neutru">
                <Replacement oldValue="doi" newValue="două" scope="LastWord" />
                <Replacement oldValue="doisprezece" newValue="douăsprezece" scope="LastWord" />
            </Variant>
        </Variants>
        <!-- NTS-53: the multiplier governs its scale noun like any noun (GALR 2005, vol. I, pp. 296-297, quoted at the
             NTS-52 Currency element below): no "de" after one to nineteen "and the compounds with these numerals in
             last position", "de" from twenty otherwise. The scaleConnector shorthand ("de" from 20) is kept, so the
             public ScaleConnector/ScaleConnectorThreshold keep their values; this substitution refines it and, being
             declared, takes precedence over it: o sută nouăsprezece mii, două sute trei milioane, but o sută douăzeci
             de mii, o sută treizeci și trei de milioane. Decided on the whole multiplier, never on the text. -->
        <ScaleConnector default="">
            <Substitution numberRange="1..19" numberModulo="100" value="" />
        </ScaleConnector>
        <!-- DOOM ordinals (al doilea, al douăzeci și unulea, al o sutălea / a doua, a o suta):
             see RomanianOrdinalLanguageSpecifics. -->
        <LanguageSpecifics>RomanianOrdinalLanguageSpecifics</LanguageSpecifics>
        <!-- NTS-52: the numeral governing the currency noun. Academia Română, Gramatica limbii române (GALR, 2005),
             vol. I, pp. 296-297: "a. Structura [numeral cardinal + substantiv] este proprie numeralelor cuprinse între
             unu şi nouăsprezece şi compuselor cu aceste numerale situate pe ultimul loc (cinci eleve, o sută treisprezece
             cărţi, două milioane trei sute opt lei). b. Structura [numeral cardinal + prepoziţia de + substantiv] se
             utilizează când determinantul este un numeral compus de la douăzeci în sus, cu excepţia celor de la punctul
             a: douăzeci de cărţi, o sută treizeci şi doi de copii, cinci mii două sute de lei". So "de" from 20, except
             when the last two digits are 1-19 (the compound ends on one to nineteen): douăzeci de euro, o sută de euro,
             un milion de euro, but o sută unu euro, o sută nouăsprezece euro, două milioane trei sute opt lei. The
             exception is declared first: both rules have one constraint, and the first declared wins. This connector
             is distinct from scaleConnector, which acts inside the numeral (douăzeci de mii). -->
        <!-- NTS-53: a currency amount of one is the numeral accompanying its noun, which takes the attributive form
             un (masculine, neuter) / o (feminine): DEX '09, "unu": "Când precedă un substantiv are forma un, o" ("Are
             un an"). The standalone cardinal keeps unu/una (DOOM 3, Studiu introductiv §4.1.5: "douăzeci și unu",
             "o sută unu", "o mie unu", against "un milion", "o mie"), so the rule is local to the currency numeral and
             Standalone: the gender variant has already given unu or una (a feminine CurrencyDefinition or the
             caller's gen=feminin), and a compound (douăzeci și unu de euro, o sută unu euro) is never touched. -->
        <Currency>
            <NounConnector default="">
                <Substitution numberRange="1..19" numberModulo="100" value="" />
                <Substitution numberRange="20.." value="de" />
            </NounConnector>
            <Replacement oldValue="unu" newValue="un" scope="Standalone" />
            <Replacement oldValue="una" newValue="o" scope="Standalone" />
        </Currency>
        <!-- Quarter-hour 12-hour clock without day-part wording: "ora două", "unu și un sfert",
             "unu și jumătate", "două fără un sfert". The hour takes the feminine numeral (două,
             douăsprezece) except one, which keeps "unu" ("ora unu"). -->
        <ClockTime step="15" hourCycle="12">
            <Rule range="0" displayHourRange="1" hourOffset="0" hourForm="cardinal" pattern="ora {hour}" />
            <Rule range="0" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" hourForceVariants="gen=feminin" pattern="ora {hour}" />
            <Rule range="15" displayHourRange="1" hourOffset="0" hourForm="cardinal" pattern="{hour} și un sfert" />
            <Rule range="15" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" hourForceVariants="gen=feminin" pattern="{hour} și un sfert" />
            <Rule range="30" displayHourRange="1" hourOffset="0" hourForm="cardinal" pattern="{hour} și jumătate" />
            <Rule range="30" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" hourForceVariants="gen=feminin" pattern="{hour} și jumătate" />
            <Rule range="45" displayHourRange="1" hourOffset="1" hourForm="cardinal" pattern="{hour} fără un sfert" />
            <Rule range="45" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gen=feminin" pattern="{hour} fără un sfert" />
        </ClockTime>
    </Language>
</Numbers>
