<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
    <Language
        baseOn="SCALE-SHORT-CYRILLIC"
        groupSize="3"
        separator=" "
        groupSeparator=""
        zero="нула"
        minus="минус *"
        decimalSeparator="цяло"
        finalComponentConnector="и"
    >
        <!-- NTS-30D: и before the last component of every numeral phrase (Речник на българския език, ИБЕ-БАН, "и",
             sense 3: "В съставни числителни имена ... свързва последното числително с предходното"): inside a group
             before its last non-zero position (двадесет и едно, сто и петнадесет, сто двадесет и едно), and between
             groups before a last group that is a single component (хиляда и сто, един милион и едно). A multiplier is
             a phrase of its own (двадесет и една хиляди; ФСлФ СУ: един милиард двеста милиона шейсет и пет хиляди
             седемстотин осемдесет и пет). The ordinals keep their plugin, which already wrote и. -->
        <Culture>BG</Culture>
        <Culture>BG-BG</Culture>
        <Groups>
            <Group level="1">
                <Digit digit="0" string="" />
                <Digit digit="1" string="едно" />
                <Digit digit="2" string="две" />
                <Digit digit="3" string="три" />
                <Digit digit="4" string="четири" />
                <Digit digit="5" string="пет" />
                <Digit digit="6" string="шест" />
                <Digit digit="7" string="седем" />
                <Digit digit="8" string="осем" />
                <Digit digit="9" string="девет" />
            </Group>
            <Group level="2">
                <Digit digit="0" string="" buildString="*" />
                <!-- 11–19 are handled as Exceptions -->
                <Digit digit="1" string="десет" buildString="десет *" />
                <Digit digit="2" string="двадесет" buildString="двадесет *" />
                <Digit digit="3" string="тридесет" buildString="тридесет *" />
                <Digit digit="4" string="четиридесет" buildString="четиридесет *" />
                <Digit digit="5" string="петдесет" buildString="петдесет *" />
                <Digit digit="6" string="шестдесет" buildString="шестдесет *" />
                <Digit digit="7" string="седемдесет" buildString="седемдесет *" />
                <Digit digit="8" string="осемдесет" buildString="осемдесет *" />
                <Digit digit="9" string="деветдесет" buildString="деветдесет *" />
            </Group>
            <Group level="3">
                <Digit digit="0" string="" buildString="*" />
                <!-- Bulgarian hundreds: сто, двеста, триста, четиристотин … деветстотин -->
                <Digit digit="1" string="сто" buildString="сто *" />
                <Digit digit="2" string="двеста" buildString="двеста *" />
                <Digit digit="3" string="триста" buildString="триста *" />
                <Digit digit="4" string="четиристотин" buildString="четиристотин *" />
                <Digit digit="5" string="петстотин" buildString="петстотин *" />
                <Digit digit="6" string="шестстотин" buildString="шестстотин *" />
                <Digit digit="7" string="седемстотин" buildString="седемстотин *" />
                <Digit digit="8" string="осемстотин" buildString="осемстотин *" />
                <Digit digit="9" string="деветстотин" buildString="деветстотин *" />
            </Group>
        </Groups>
        <!-- Short scale with милиард (NTS-25): милион 10^6 and милиард 10^9 are static, then
             SCALE-SHORT-CYRILLIC generates три+ли+он = трилион (10^12), квадрилион (10^15)…
             startIndex=2 maps scale 4 (10^12) to Conway index 3. The junction "ли" keeps the
             -i- between Conway groups: ми+ли+ни+ли+он = милинилион (n = 1000).
             Bulgarian simplifies the geminate of the Russian кваттуор (кватуордецилион), so
             only UnitsPrefixes is overridden.
             NTS-30B: хиляда, милион and милиард agree with their multiplier (ScaleForm below); NTS-30C:
             the generated names from трилион up agree too, through GeneratedScaleForm (два трилиона). -->
        <NumberScale firstLetterUpperCase="false" groupSeparator="ли" startIndex="2">
            <StaticNames>
                <Scale value="0" string="" />
                <!-- Bulgarian: "хиляда" alone for 1000; "едно хиляда" → "хиляда" via Replacement -->
                <Scale value="1" string="хиляда" />
                <Scale value="2" string="милион" />
                <Scale value="3" string="милиард" />
            </StaticNames>
            <Suffixes>
                <Suffix>он</Suffix>
            </Suffixes>
            <UnitsPrefixes>
                <Digit digit="0" string="" />
                <Digit digit="1" string="ун" />
                <Digit digit="2" string="дуо" />
                <Digit digit="3" string="тре(с)" />
                <Digit digit="4" string="кватуор" />
                <Digit digit="5" string="квинква" />
                <Digit digit="6" string="се(кс,с)" />
                <Digit digit="7" string="септе(мн)" />
                <Digit digit="8" string="окто" />
                <Digit digit="9" string="нове(мн)" />
            </UnitsPrefixes>
            <!-- NTS-30B: the singular after exactly one, otherwise the plural of хиляда (feminine) and the
                 count form (бройна форма) of the masculine non-person nouns милион and милиард, also after a
                 compound ending in one (Официален правописен речник, ИБЕ-БАН 2012, pp. 26-27: десет хиляди
                 километра, три милиона долара, пет милиарда лева, хиляда и една нощи; ИБЕ-БАН "Езикови
                 справки": двайсетте и един апарата). DefaultLexicalFormSelector returns singular/plural. -->
            <ScaleForm scale="1">
                <Forms>
                    <Form key="singular" value="хиляда" />
                    <Form key="plural" value="хиляди" />
                </Forms>
            </ScaleForm>
            <ScaleForm scale="2">
                <Forms>
                    <Form key="singular" value="милион" />
                    <Form key="plural" value="милиона" />
                </Forms>
            </ScaleForm>
            <ScaleForm scale="3">
                <Forms>
                    <Form key="singular" value="милиард" />
                    <Form key="plural" value="милиарда" />
                </Forms>
            </ScaleForm>
            <!-- NTS-30C: every generated scale (трилион, квадрилион, …) is a masculine non-person noun like
                 милион: the singular after exactly one, otherwise its count form (бройна форма) трилиона
                 (Речник на българския език, rechnik.chitanka.info "трилион": м.р., бройна форма трилиона;
                 Официален правописен речник, ИБЕ-БАН 2012, pp. 26-27). The multiplier is masculine (един,
                 два), compounds included, with its own и (NTS-30D: двадесет и два трилиона). -->
            <GeneratedScaleForm suffix="0">
                <Forms>
                    <Form key="singular" value="он" forceVariants="gender=masculine" />
                    <Form key="plural" value="она" forceVariants="gender=masculine" />
                </Forms>
            </GeneratedScaleForm>
        </NumberScale>
        <Replacements>
            <!-- Drop "едно" before "хиляда": 1000 = "хиляда" not "едно хиляда" -->
            <Replacement oldValue="едно хиляда" newValue="хиляда" onScale="1" onValue="1" />
            <!-- NTS-30B: the default digits are the counting forms (едно, две). хиляда is feminine, so a
                 compound multiplier ends in една (две is already feminine: две хиляди); милион and милиард are
                 masculine, so their multiplier ends in един / два (един милион, два милиона). -->
            <Replacement oldValue="едно хиляди" newValue="една хиляди" scope="EndsWith" onScale="1" />
            <Replacement oldValue="едно милион" newValue="един милион" scope="EndsWith" onScale="2" />
            <Replacement oldValue="едно милиона" newValue="един милиона" scope="EndsWith" onScale="2" />
            <Replacement oldValue="две милиона" newValue="два милиона" scope="EndsWith" onScale="2" />
            <Replacement oldValue="едно милиард" newValue="един милиард" scope="EndsWith" onScale="3" />
            <Replacement oldValue="едно милиарда" newValue="един милиарда" scope="EndsWith" onScale="3" />
            <Replacement oldValue="две милиарда" newValue="два милиарда" scope="EndsWith" onScale="3" />
        </Replacements>
        <Exceptions>
            <Number value="11" string="единадесет" />
            <Number value="12" string="дванадесет" />
            <Number value="13" string="тринадесет" />
            <Number value="14" string="четиринадесет" />
            <Number value="15" string="петнадесет" />
            <Number value="16" string="шестнадесет" />
            <Number value="17" string="седемнадесет" />
            <Number value="18" string="осемнадесет" />
            <Number value="19" string="деветнадесет" />
        </Exceptions>
        <!-- Gender of един/една/едно and два/две. The default "standalone" value keeps the counting
             forms (едно, две); explicit genders select the agreeing forms. Ordinals are produced by
             BulgarianOrdinalLanguageSpecifics, whose "standalone" form is the masculine citation
             form (първи). -->
        <Variants>
            <Dimension name="gender" localName="род" values="standalone,masculine,feminine,neuter" />
            <Variant type="gender" variant="masculine">
                <Replacement oldValue="едно" newValue="един" scope="LastWord" />
                <Replacement oldValue="две" newValue="два" scope="LastWord" />
            </Variant>
            <Variant type="gender" variant="feminine">
                <Replacement oldValue="едно" newValue="една" scope="LastWord" />
            </Variant>
        </Variants>
        <!-- NTS-30H: fractions are read by the language specifics (IFractionLanguageSpecifics), as the Institute for Bulgarian
             Language writes them: една втора, две трети, една четвърт, седем осми (feminine numerator, ordinal denominator
             in the feminine singular after one, in the plural otherwise, NTS-39: сто и една хилядни). The former connector reading "едно на хиляда" is
             gone; values outside the sourced domain fail closed. -->
        <LanguageSpecifics>BulgarianOrdinalLanguageSpecifics</LanguageSpecifics>
        <!-- "Часът е един": "час" is masculine, so {hour} is forced to the masculine numeral.
             Quarter-hour 12-hour clock without day-part wording; "петнайсет" is the colloquial
             variant of "петнадесет" listed by the orthographic dictionary. -->
        <ClockTime step="15" hourCycle="12">
            <Rule range="0" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=masculine" pattern="{hour}" />
            <Rule range="15" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=masculine" pattern="{hour} и петнайсет" />
            <Rule range="30" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=masculine" pattern="{hour} и половина" />
            <Rule range="45" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=masculine" pattern="{hour} без петнайсет" />
        </ClockTime>
    </Language>
</Numbers>
