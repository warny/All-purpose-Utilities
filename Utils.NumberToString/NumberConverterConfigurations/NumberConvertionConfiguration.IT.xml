<?xml version="1.0" encoding="utf-8" ?>
<Numbers xmlns="Utils/NumberConvertionConfiguration.xsd">
        <Language
                baseOn="SCALE-LONG"
                groupSize="3"
                separator=" "
                groupSeparator=""
                zero="zero"
                minus="meno *"
                decimalSeparator="virgola"
                fractionSeparator="su"
        >
		<Culture>IT</Culture>
		<Groups>
			<Group level="1">
				<Digit digit="0" string="" />
				<Digit digit="1" string="uno" />
				<Digit digit="2" string="due" />
				<Digit digit="3" string="tre" />
				<Digit digit="4" string="quattro" />
				<Digit digit="5" string="cinque" />
				<Digit digit="6" string="sei" />
				<Digit digit="7" string="sette" />
				<Digit digit="8" string="otto" />
				<Digit digit="9" string="nove" />
			</Group>
			<!--
			  Treccani, Enciclopedia dell'Italiano, "numerali": compounds are written as one word;
			  the final vowel of the tens is elided before uno and otto ("ventuno [e non *ventiuno]",
			  "ventotto"); compounds of tre are accented ("ventitré") although tre alone is not.
			  The buildStrings solder the constituents; the <Fusion> rules implement the junction
			  changes (elision, accented tre) at the tens/units and hundreds/rest boundaries.
			-->
			<Group level="2">
				<Digit digit="0" string="" buildString="*" />
				<Digit digit="1" string="dieci" buildString="dici*" />
				<Digit digit="2" string="venti" buildString="venti*">
					<Fusion for="1,8" removeLeft="i" />
					<Fusion for="3" right="tré" />
				</Digit>
				<Digit digit="3" string="trenta" buildString="trenta*">
					<Fusion for="1,8" removeLeft="a" />
					<Fusion for="3" right="tré" />
				</Digit>
				<Digit digit="4" string="quaranta" buildString="quaranta*">
					<Fusion for="1,8" removeLeft="a" />
					<Fusion for="3" right="tré" />
				</Digit>
				<Digit digit="5" string="cinquanta" buildString="cinquanta*">
					<Fusion for="1,8" removeLeft="a" />
					<Fusion for="3" right="tré" />
				</Digit>
				<Digit digit="6" string="sessanta" buildString="sessanta*">
					<Fusion for="1,8" removeLeft="a" />
					<Fusion for="3" right="tré" />
				</Digit>
				<Digit digit="7" string="settanta" buildString="settanta*">
					<Fusion for="1,8" removeLeft="a" />
					<Fusion for="3" right="tré" />
				</Digit>
				<Digit digit="8" string="ottanta" buildString="ottanta*">
					<Fusion for="1,8" removeLeft="a" />
					<Fusion for="3" right="tré" />
				</Digit>
				<Digit digit="9" string="novanta" buildString="novanta*">
					<Fusion for="1,8" removeLeft="a" />
					<Fusion for="3" right="tré" />
				</Digit>
			</Group>
			<!--
			  Treccani: with cento followed by a ten or a unit the elision is uncommon before uno,
			  otto and undici (centouno, centootto, centoundici: plain buildString), but the hundreds
			  elide before ottanta (centottanta). A final tre keeps its accent (centotré).
			-->
			<Group level="3">
				<Digit digit="0" string="" buildString="*" />
				<Digit digit="1" string="cento" buildString="cento*">
					<Fusion for="3" right="tré" />
					<Fusion for="80..89" removeLeft="o" />
				</Digit>
				<Digit digit="2" string="duecento" buildString="duecento*">
					<Fusion for="3" right="tré" />
					<Fusion for="80..89" removeLeft="o" />
				</Digit>
				<Digit digit="3" string="trecento" buildString="trecento*">
					<Fusion for="3" right="tré" />
					<Fusion for="80..89" removeLeft="o" />
				</Digit>
				<Digit digit="4" string="quattrocento" buildString="quattrocento*">
					<Fusion for="3" right="tré" />
					<Fusion for="80..89" removeLeft="o" />
				</Digit>
				<Digit digit="5" string="cinquecento" buildString="cinquecento*">
					<Fusion for="3" right="tré" />
					<Fusion for="80..89" removeLeft="o" />
				</Digit>
				<Digit digit="6" string="seicento" buildString="seicento*">
					<Fusion for="3" right="tré" />
					<Fusion for="80..89" removeLeft="o" />
				</Digit>
				<Digit digit="7" string="settecento" buildString="settecento*">
					<Fusion for="3" right="tré" />
					<Fusion for="80..89" removeLeft="o" />
				</Digit>
				<Digit digit="8" string="ottocento" buildString="ottocento*">
					<Fusion for="3" right="tré" />
					<Fusion for="80..89" removeLeft="o" />
				</Digit>
				<Digit digit="9" string="novecento" buildString="novecento*">
					<Fusion for="3" right="tré" />
					<Fusion for="80..89" removeLeft="o" />
				</Digit>
			</Group>
		</Groups>
		<NumberScale firstLetterUpperCase="true">
			<StaticNames>
				<Scale value="0" string="" />
				<Scale value="1" string="mi(lle|la)" />
			</StaticNames>
			<Suffixes>
				<Suffix>on(e|i)</Suffix>
				<Suffix>ard(o|i)</Suffix>
			</Suffixes>
		</NumberScale>
		<!--
		  Thousands (Treccani: mille becomes -mila and joins the multiplier, "duemila"; with mille
		  the elision is avoided, "milleuno"). Below a million the whole number is one word, and a
		  final tre keeps its accent ("milletré", "duemilatré") while an inner tre loses it
		  ("ventitremila"). These junctions involve a scale name, so they are Replacements (onScale
		  for the thousands group, then the final assembled-string pass), not <Fusion>.
		  Millions and above (separate words) are not handled here.
		-->
		<Replacements>
			<Replacement oldValue="uno mille" newValue="mille" onScale="1" onValue="1" />
			<Replacement oldValue="tré mila" newValue="tremila" scope="Anywhere" onScale="1" />
			<Replacement oldValue=" mila" newValue="mila" scope="Anywhere" onScale="1" />
			<Replacement oldValue="mila " newValue="mila" scope="Anywhere" />
			<Replacement oldValue="mille " newValue="mille" scope="Anywhere" />
			<Replacement oldValue="milatre" newValue="milatré" scope="EndsWith" />
			<Replacement oldValue="milletre" newValue="milletré" scope="EndsWith" />
		</Replacements>
		<Exceptions>
			<Number value="11" string="undici" />
			<Number value="12" string="dodici" />
			<Number value="13" string="tredici" />
			<Number value="14" string="quattordici" />
			<Number value="15" string="quindici" />
			<Number value="16" string="sedici" />
			<Number value="17" string="diciassette" />
			<Number value="18" string="diciotto" />
			<Number value="19" string="diciannove" />
		</Exceptions>
		<Variants>
			<!--
			  En italien, seul "uno" (1) varie en genre ; les centaines (duecento,
			  trecento…) sont invariables. Les composés soudés (ventuno, trentuno…)
			  restent en -uno devant un nom féminin pluriel (Treccani, vocabolario
			  "ventuno" : "ventuno ballerine" ; "ventun(o) ballerina sarebbe raro") :
			  LastWord ne transforme volontairement que le mot isolé "uno".
			-->
			<Dimension name="gender" localName="genere" values="maschile,femminile" />

			<Variant type="gender" variant="femminile">
				<Replacement oldValue="uno" newValue="una" scope="LastWord" />
			</Variant>
		</Variants>
		<!--
		  Italian ordinals (NTS-13). 1-10 are irregular (primo … decimo). From 11 on the ordinal is
		  the cardinal without its final vowel + -esimo (Treccani, La grammatica italiana, "Aggettivi
		  numerali ordinali": "ventiquattro ▶ ventiquattresimo"), expressed by the OrdinalStem rules on
		  the final vowel. Compounds of tre keep the vowel and lose the accent ("ventitré ▶
		  ventitreesimo"), compounds of sei keep the -i ("ventisei ▶ ventiseiesimo", the form actually
		  used per the Enciclopedia dell'Italiano prontuario). Treccani gives "centunesimo" (more
		  common than "centesimo primo") although the cardinal is "centouno"; the -mila of the round
		  thousands becomes mill- ("duemillesimo", "diecimillesimo", "centomillesimo"). The longest
		  matching ending wins, so declaration order is irrelevant. The feminine variant only changes
		  the suffix: the stem rules are shared.
		  ItalianOrdinalLanguageSpecifics keeps zero, non-round thousands above 1999 (NTS-15) and
		  millions (NTS-14) fail-closed.
		-->
		<LanguageSpecifics>ItalianOrdinalLanguageSpecifics</LanguageSpecifics>
		<Ordinals suffix="esimo">
			<OrdinalStem from="centouno" to="centun" />
			<OrdinalStem from="mila" to="mill" />
			<OrdinalStem from="tré" to="tre" />
			<OrdinalStem from="sei" to="sei" />
			<OrdinalStem from="a" to="" />
			<OrdinalStem from="e" to="" />
			<OrdinalStem from="i" to="" />
			<OrdinalStem from="o" to="" />
			<!-- Irregular 1-10 (maschile) -->
			<OrdinalException value="1"  string="primo" />
			<OrdinalException value="2"  string="secondo" />
			<OrdinalException value="3"  string="terzo" />
			<OrdinalException value="4"  string="quarto" />
			<OrdinalException value="5"  string="quinto" />
			<OrdinalException value="6"  string="sesto" />
			<OrdinalException value="7"  string="settimo" />
			<OrdinalException value="8"  string="ottavo" />
			<OrdinalException value="9"  string="nono" />
			<OrdinalException value="10" string="decimo" />

			<!-- Femminile variant: same stems, suffix -esima -->
			<OrdinalVariants>
				<Variant type="gender" variant="femminile" suffix="esima">
					<OrdinalException value="1"  string="prima" />
					<OrdinalException value="2"  string="seconda" />
					<OrdinalException value="3"  string="terza" />
					<OrdinalException value="4"  string="quarta" />
					<OrdinalException value="5"  string="quinta" />
					<OrdinalException value="6"  string="sesta" />
					<OrdinalException value="7"  string="settima" />
					<OrdinalException value="8"  string="ottava" />
					<OrdinalException value="9"  string="nona" />
					<OrdinalException value="10" string="decima" />
				</Variant>
			</OrdinalVariants>
		</Ordinals>
		<!-- Accademia della Crusca: "l'una e mezzo" (also "e mezza"), "le due meno un quarto", and
			 "le otto meno venti" / "meno dieci" before the hour. Neutral 12-hour clock without
			 day-part wording (no mezzogiorno/mezzanotte: the Italian configuration has no TimeUnits
			 section). The article is elided for one (l'una) and plural otherwise (le due); {hour} is
			 forced to the feminine numeral. Five-minute step since the compound cardinals are
			 orthographic (NTS-10): "e {amount}" after the hour, "meno {amount}" before the next. -->
		<ClockTime step="5" hourCycle="12">
			<Rule range="0" displayHourRange="1" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femminile" pattern="l'{hour}" />
			<Rule range="0" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femminile" pattern="le {hour}" />
			<Rule range="5,10,20,25" displayHourRange="1" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femminile" amountReference="0" amountDirection="after" pattern="l'{hour} e {amount}" />
			<Rule range="5,10,20,25" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femminile" amountReference="0" amountDirection="after" pattern="le {hour} e {amount}" />
			<Rule range="35,40,50,55" displayHourRange="1" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femminile" amountReference="60" amountDirection="before" pattern="l'{hour} meno {amount}" />
			<Rule range="35,40,50,55" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femminile" amountReference="60" amountDirection="before" pattern="le {hour} meno {amount}" />
			<Rule range="15" displayHourRange="1" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femminile" pattern="l'{hour} e un quarto" />
			<Rule range="15" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femminile" pattern="le {hour} e un quarto" />
			<Rule range="30" displayHourRange="1" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femminile" pattern="l'{hour} e mezzo" />
			<Rule range="30" displayHourRange="2-12" hourOffset="0" hourForm="cardinal" hourForceVariants="gender=femminile" pattern="le {hour} e mezzo" />
			<Rule range="45" displayHourRange="1" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femminile" pattern="l'{hour} meno un quarto" />
			<Rule range="45" displayHourRange="2-12" hourOffset="1" hourForm="cardinal" hourForceVariants="gender=femminile" pattern="le {hour} meno un quarto" />
		</ClockTime>
	</Language>
</Numbers>